---
// Besley: a one-armed bandit. Three reels of words; pull the lever.
export interface Props { n: string }
const { n } = Astro.props;
const REEL = ['GOLD', 'BEANS', 'BOOTS', 'SPURS', '7', 'MULE', 'WHISKEY', 'GOLD', 'CACTUS', '7', 'SHERIFF', 'BEANS'];
---
<section class="ed-sec" data-bzs>
  <div class="ed-kicker"><span>{n}</span> Feeling lucky</div>
  <h2 class="ed-h2">Pull the lever.<br /><em>Three of a kind</em> pays out.</h2>
  <div class="ed-body bzs">
    <div class="bzs__cab">
      <p class="bzs__top">Dry Creek Mercantile · One Bit a Pull</p>
      <div class="bzs__win" data-bzs-win>
        {[0, 1, 2].map((r) => (
          <div class="bzs__reel" data-bzs-reel={r}><div class="bzs__strip" data-bzs-strip>{[...REEL, ...REEL, ...REEL].map((w) => <span class={w === '7' ? 'is-seven' : ''}>{w}</span>)}</div></div>
        ))}
        <span class="bzs__line" aria-hidden="true"></span>
      </div>
      <p class="bzs__msg" data-bzs-msg aria-live="polite">Pull to play</p>
      <div class="bzs__foot"><span>Winnings <b data-bzs-pot>0</b> bits</span><span>Pulls <b data-bzs-n>0</b></span></div>
    </div>
    <button type="button" class="bzs__lever" data-bzs-lever aria-label="Pull the lever"><i></i><b></b></button>
  </div>
  <script type="application/json" data-bzs-data set:html={JSON.stringify(REEL)} />
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-bzs]').forEach((root) => {
    const REEL: string[] = JSON.parse(root.querySelector('[data-bzs-data]')!.textContent!);
    const strips = Array.from(root.querySelectorAll<HTMLElement>('[data-bzs-strip]'));
    const lever = root.querySelector<HTMLButtonElement>('[data-bzs-lever]')!, msg = root.querySelector<HTMLElement>('[data-bzs-msg]')!, win = root.querySelector<HTMLElement>('[data-bzs-win]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let busy = false, pot = 0, pulls = 0;
    const cellH = () => (strips[0].firstElementChild as HTMLElement).offsetHeight;
    const pos = [2, 5, 8];
    const place = (i: number, idx: number, dur: number) => {
      const s = strips[i], h = cellH();
      s.style.transition = dur ? `transform ${dur}ms cubic-bezier(0.15, 0.9, 0.25, 1.06)` : 'none';
      // centre row index = REEL.length + idx (middle copy) + offset so the chosen word sits on the pay line
      s.style.transform = `translateY(${-(REEL.length + idx - 1) * h}px)`;
    };
    pos.forEach((p, i) => place(i, p, 0));
    window.addEventListener('resize', () => pos.forEach((p, i) => place(i, p, 0)));
    const pull = () => {
      if (busy) return; busy = true; pulls++; root.querySelector('[data-bzs-n]')!.textContent = String(pulls);
      lever.classList.remove('is-pull'); void lever.offsetWidth; lever.classList.add('is-pull');
      win.classList.remove('is-jack', 'is-pair'); msg.textContent = 'Spinning…';
      // weighted luck: a pair is common, a jackpot happens about one pull in six
      const r = Math.random();
      const a = Math.floor(Math.random() * REEL.length);
      const pick = r < 0.17 ? [a, a, a] : r < 0.55 ? [a, a, Math.floor(Math.random() * REEL.length)] : [0, 1, 2].map(() => Math.floor(Math.random() * REEL.length));
      // jump the strips back one full loop first so they always spin downward a long way
      strips.forEach((s, i) => { const h = cellH(); s.style.transition = 'none'; s.style.transform = `translateY(${-(pos[i] - 1) * h}px)`; });
      void strips[0].offsetWidth;
      pick.forEach((idx, i) => { pos[i] = idx; setTimeout(() => { place(i, idx, reduce ? 0 : 900 + i * 450); }, 30); });
      setTimeout(() => {
        const words = pick.map((i) => REEL[i]);
        const jack = words[0] === words[1] && words[1] === words[2];
        const pair = !jack && (words[0] === words[1] || words[1] === words[2] || words[0] === words[2]);
        const pay = jack ? (words[0] === '7' ? 77 : 25) : pair ? 2 : 0;
        pot += pay; root.querySelector('[data-bzs-pot]')!.textContent = String(pot);
        msg.textContent = jack ? (words[0] === '7' ? 'JACKPOT! Seventy-seven bits!' : `Three ${words[0].toLowerCase()} — pays 25`) : pair ? 'A pair. Two bits.' : ['Nothing. The house thanks you.', 'Dust. Pull again?', 'Not today, partner.'][pulls % 3];
        win.classList.toggle('is-jack', jack); win.classList.toggle('is-pair', pair);
        busy = false;
      }, reduce ? 50 : 900 + 2 * 450 + 120);
    };
    lever.addEventListener('click', pull);
    root.querySelector('.bzs__cab')!.addEventListener('click', pull);
  });
</script>

<style is:global>
  .bzs { display: flex; justify-content: center; align-items: center; gap: 0; }
  .bzs__cab { container-type: inline-size; width: min(100%, 44rem); padding: 3cqi 4cqi 3.4cqi; border-radius: 24px 24px 10px 10px; background: linear-gradient(180deg, #8a3a1a, #5c2410); border: 6px solid #2a1a0d; box-shadow: inset 0 0 0 3px #e7b866, 0 40px 60px -30px #000c; color: #f3dfb4; text-align: center; cursor: pointer; user-select: none; }
  .bzs__top { font-family: 'Besley Variable', serif; font-style: italic; font-variation-settings: 'wght' 700; font-size: 4.4cqi; color: #e7b866; padding-bottom: 2.4cqi; }
  .bzs__win { --row: 15cqi; position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6cqi; padding: 1.6cqi; background: #2a1a0d; border-radius: 8px; transition: box-shadow 0.3s; }
  .bzs__reel { height: calc(var(--row) * 3); overflow: hidden; border-radius: 4px; background: linear-gradient(180deg, #8f8169, #f6ecd4 30%, #fffaf0 50%, #f6ecd4 70%, #8f8169); }
  .bzs__strip { will-change: transform; }
  .bzs__strip span { display: grid; place-items: center; height: var(--row); font-family: 'Besley Variable', serif; font-variation-settings: 'wght' 900; font-size: 4.4cqi; letter-spacing: -0.02em; color: #2a1a0d; }
  .bzs__strip span.is-seven { font-size: 11cqi; color: #b0301c; font-style: italic; }
  .bzs__line { position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: #b0301c99; pointer-events: none; }
  .bzs__win.is-jack { animation: bzs-jack 0.4s steps(2, jump-none) 6; box-shadow: 0 0 0 4px #ffd27a, 0 0 50px #ffb43a; }
  .bzs__win.is-pair { box-shadow: 0 0 0 3px #e7b866; }
  @keyframes bzs-jack { to { box-shadow: 0 0 0 4px #b0301c, 0 0 20px #b0301c; } }
  .bzs__msg { margin-top: 2.6cqi; min-height: 1.3em; font-family: 'Besley Variable', serif; font-variation-settings: 'wght' 800; font-size: 5cqi; text-transform: uppercase; letter-spacing: 0.03em; }
  .bzs__foot { display: flex; justify-content: space-between; margin-top: 1.6cqi; padding-top: 1.6cqi; border-top: 1px solid #e7b86655; font: 400 2.6cqi/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: #e7b866; }
  .bzs__foot b { font-family: 'Besley Variable', serif; font-weight: 400; font-variation-settings: 'wght' 900; font-size: 1.8em; color: #fff4dc; }
  .bzs__lever { position: relative; align-self: center; width: clamp(2.6rem, 5vw, 3.6rem); height: clamp(12rem, 26vw, 18rem); margin-left: -6px; cursor: pointer; }
  .bzs__lever i { position: absolute; left: 0; bottom: 20%; width: 60%; height: 18%; background: linear-gradient(90deg, #4a453d, #8d8577); border-radius: 0 6px 6px 0; }
  .bzs__lever b { position: absolute; left: 48%; bottom: 30%; width: 10px; height: 64%; margin-left: -5px; background: linear-gradient(90deg, #8d8577, #e7e2d8, #6f6a62); border-radius: 5px; transform-origin: 50% 100%; transition: transform 0.2s; }
  .bzs__lever b::after { content: ''; position: absolute; left: 50%; top: -1.4rem; width: 2.4rem; height: 2.4rem; margin-left: -1.2rem; border-radius: 50%; background: radial-gradient(circle at 35% 30%, #ff8a6a, #b0301c 60%, #6e1a10); box-shadow: 0 4px 8px #0008; }
  .bzs__lever:hover b { transform: rotate(4deg); }
  .bzs__lever.is-pull b { animation: bzs-pull 0.7s cubic-bezier(0.3, 0.6, 0.3, 1); }
  @keyframes bzs-pull { 35% { transform: scaleY(-0.4); } 100% { transform: none; } }
  @media (max-width: 600px) { .bzs__lever { display: none; } }
</style>
