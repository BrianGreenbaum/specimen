---
// Instrument Serif posters: a condensed headline, a gallery opening, an italic manifesto.
---
<figure class="pw-p" id="instrument-serif-exhibition" data-name="Exhibition">
  <div class="pw-art is-a">
    <p class="is-a__k">Gallery 3 · 14 March — 2 June</p>
    <p class="is-a__h">Objects<br /><em>of quiet</em><br />attention</p>
    <span class="is-a__o" aria-hidden="true"></span>
    <p class="is-a__f">Opening night, Thursday 7pm. All welcome.</p>
  </div>
</figure>
<figure class="pw-p" id="instrument-serif-condensed" data-name="Condensed">
  <div class="pw-art is-b">
    <p class="is-b__h">Elegance<br />is refusal.</p>
    <p class="is-b__f">— Coco Chanel</p>
  </div>
</figure>
<figure class="pw-p" id="instrument-serif-italics" data-name="Italics">
  <div class="pw-art is-c">
    <p class="is-c__h"><em>slowly,</em><br /><em>then</em><br /><em>all at</em><br /><em>once.</em></p>
  </div>
</figure>
<style>
  .is-a { background: #ece9e1; color: #161512; font-family: 'Instrument Serif', serif; padding: 8cqi; display: flex; flex-direction: column; }
  .is-a__k { font-family: var(--font-mono, monospace); font-size: 2.6cqi; letter-spacing: 0.1em; text-transform: uppercase; }
  .is-a__h { position: relative; z-index: 1; margin-top: auto; font-size: 22cqi; line-height: 0.88; letter-spacing: -0.02em; }
  .is-a__h em { font-style: italic; color: #4a5bd4; }
  .is-a__o { position: absolute; right: 8cqi; top: 14cqi; width: 40cqi; height: 40cqi; border-radius: 50%; background: #c9c3b4; }
  .is-a__f { margin-top: 5cqi; font-size: 4.4cqi; }
  .is-b { background: #161512; color: #ece9e1; font-family: 'Instrument Serif', serif; padding: 8cqi; display: flex; flex-direction: column; justify-content: center; }
  .is-b__h { font-size: 23cqi; line-height: 0.9; letter-spacing: -0.03em; }
  .is-b__f { margin-top: 6cqi; font-size: 6cqi; font-style: italic; color: #a8b0ff; }
  .is-c { background: #4a5bd4; color: #f4f1ea; font-family: 'Instrument Serif', serif; display: grid; place-content: center; text-align: center; }
  .is-c__h { font-size: 27cqi; line-height: 0.86; letter-spacing: -0.03em; }
</style>
