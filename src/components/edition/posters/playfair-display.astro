---
// Playfair Display posters: an opera bill, a fashion headline, the italic ampersand.
---
<figure class="pw-p" id="playfair-display-opera" data-name="Opera">
  <div class="pw-art pf-a">
    <p class="pf-a__k">The Royal Opera presents</p>
    <p class="pf-a__h">La<br /><em>Traviata</em></p>
    <p class="pf-a__s">Giuseppe Verdi</p>
    <p class="pf-a__f">Three acts · Sung in Italian · Opening 12 October</p>
  </div>
</figure>
<figure class="pw-p" id="playfair-display-black" data-name="Black">
  <div class="pw-art pf-b">
    <p class="pf-b__h">Black<em>is the new</em>Black</p>
  </div>
</figure>
<figure class="pw-p" id="playfair-display-ampersand" data-name="Ampersand">
  <div class="pw-art pf-c">
    <p class="pf-c__a">&amp;</p>
    <p class="pf-c__f">Playfair Display Italic · Claus Eggers Sørensen</p>
  </div>
</figure>
<style>
  .pf-a { background: #4a0d18; color: #f6ead2; font-family: 'Playfair Display Variable', serif; text-align: center; padding: 9cqi 7cqi; display: flex; flex-direction: column; align-items: center; box-shadow: inset 0 0 0 3cqi #4a0d18, inset 0 0 0 3.3cqi #d6a84a; }
  .pf-a__k { font-size: 3.4cqi; letter-spacing: 0.3em; text-transform: uppercase; color: #d6a84a; font-variation-settings: 'wght' 600; }
  .pf-a__h { margin: auto 0 0; font-size: 26cqi; line-height: 0.85; font-variation-settings: 'wght' 900; }
  .pf-a__h em { font-style: italic; font-variation-settings: 'wght' 400; }
  .pf-a__s { margin: 4cqi 0 auto; font-size: 6cqi; font-style: italic; color: #d6a84a; }
  .pf-a__f { font-size: 3cqi; letter-spacing: 0.12em; text-transform: uppercase; }
  .pf-b { background: #f6f0e6; color: #0c0c0c; font-family: 'Playfair Display Variable', serif; display: grid; align-content: center; padding: 0 8cqi; }
  .pf-b__h { position: relative; }
  .pf-b__h { font-size: 30cqi; line-height: 0.82; letter-spacing: -0.03em; font-variation-settings: 'wght' 900; }
  .pf-b__h em { display: block; font-size: 0.4em; line-height: 1; font-style: italic; font-variation-settings: 'wght' 400; color: #b0162a; padding: 2cqi 0 4cqi 30cqi; letter-spacing: 0; }
  .pf-c { background: #b0162a; color: #f6ead2; font-family: 'Playfair Display Variable', serif; }
  .pf-c__a { position: absolute; left: 50%; top: 42%; translate: -50% -50%; font-size: 96cqi; line-height: 1; font-style: italic; font-variation-settings: 'wght' 400; }
  .pf-c__f { position: absolute; left: 0; right: 0; bottom: 7cqi; text-align: center; font-size: 2.8cqi; letter-spacing: 0.12em; text-transform: uppercase; }
</style>
