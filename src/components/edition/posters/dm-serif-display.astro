---
// DM Serif Display posters: a jazz bill, a perfume ad, the italic g.
---
<figure class="pw-p" id="dm-serif-display-jazz" data-name="Jazz">
  <div class="pw-art dd-a">
    <p class="dd-a__k">Friday · Late set</p>
    <p class="dd-a__h"><em>Blue</em><br />Velvet<br /><em>Quartet</em></p>
    <p class="dd-a__f">Doors at eleven · The Gilded Room · No cover before midnight</p>
  </div>
</figure>
<figure class="pw-p" id="dm-serif-display-noir" data-name="Noir">
  <div class="pw-art dd-b">
    <p class="dd-b__h">Noir</p>
    <p class="dd-b__s"><em>for the hours after midnight</em></p>
    <span class="dd-b__drop" aria-hidden="true"></span>
  </div>
</figure>
<figure class="pw-p" id="dm-serif-display-g" data-name="The g">
  <div class="pw-art dd-c">
    <p class="dd-c__g">g</p>
    <p class="dd-c__f">DM Serif Display Italic · Colophon · 2019</p>
  </div>
</figure>
<style>
  .dd-a { background: #13294b; color: #f3ede1; font-family: 'DM Serif Display', serif; padding: 9cqi; display: flex; flex-direction: column; }
  .dd-a__k { font-size: 3.4cqi; letter-spacing: 0.3em; text-transform: uppercase; color: #d7a23f; }
  .dd-a__h { margin: auto 0; font-size: 21cqi; line-height: 0.88; letter-spacing: -0.02em; }
  .dd-a__h em { font-style: italic; color: #d7a23f; }
  .dd-a__f { font-size: 3.4cqi; line-height: 1.4; border-top: 0.3cqi solid #d7a23f; padding-top: 3cqi; }
  .dd-b { background: #100f0d; color: #f3ede1; font-family: 'DM Serif Display', serif; display: grid; place-content: center; text-align: center; }
  .dd-b__h { font-size: 40cqi; line-height: 0.9; letter-spacing: -0.03em; }
  .dd-b__s { font-size: 6cqi; color: #d7a23f; }
  .dd-b__drop { position: absolute; left: 50%; bottom: 10cqi; width: 4cqi; height: 6cqi; translate: -50% 0; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; background: #d7a23f; }
  .dd-c { background: #d7a23f; color: #100f0d; font-family: 'DM Serif Display', serif; }
  .dd-c__g { position: absolute; left: 50%; top: 37%; translate: -50% -50%; font-size: 112cqi; line-height: 1; font-style: italic; }
  .dd-c__f { position: absolute; left: 0; right: 0; bottom: 6cqi; text-align: center; font-size: 3.2cqi; letter-spacing: 0.14em; text-transform: uppercase; }
</style>
