---
// Cinzel posters: SPQR in gold, an epic film bill, the capital alphabet.
---
<figure class="pw-p" id="cinzel-spqr" data-name="SPQR">
  <div class="pw-art ci-a">
    <p class="ci-a__s">Senatus</p><p class="ci-a__p">Populusque</p><p class="ci-a__r">Romanus</p>
    <span class="ci-a__rule" aria-hidden="true"></span>
    <p class="ci-a__f">The Senate and People of Rome</p>
  </div>
</figure>
<figure class="pw-p" id="cinzel-epic" data-name="Epic">
  <div class="pw-art ci-b">
    <p class="ci-b__k">This winter</p>
    <p class="ci-b__h">The Last<br /><span>Legion</span></p>
    <p class="ci-b__tag">Ten thousand miles from home. One road back.</p>
    <p class="ci-b__credits">A film in five acts · Music by the Orchestra of the Seven Hills · Shot on location · Running time 2 hours 41 minutes</p>
  </div>
</figure>
<figure class="pw-p" id="cinzel-capitals" data-name="Capitals">
  <div class="pw-art ci-c">
    <div class="ci-c__g">{[...'ABCDEFGHIJKLMNOPQRSTVXYZ'].map((c, i) => <span style={`font-variation-settings:'wght' ${400 + (i % 6) * 100}`}>{c}</span>)}</div>
    <p class="ci-c__f">Cinzel · capitals only, after first-century Roman inscriptions</p>
  </div>
</figure>
<style>
  .ci-a { background: #3b1336; color: #e8c46e; font-family: 'Cinzel Variable', serif; display: grid; align-content: center; text-align: center; text-transform: uppercase; padding: 0 5cqi; }
  .ci-a__s { font-size: 17.5cqi; line-height: 1; font-variation-settings: 'wght' 900; }
  .ci-a__p { font-size: 11.8cqi; line-height: 1.1; font-variation-settings: 'wght' 400; letter-spacing: 0.02em; }
  .ci-a__r { font-size: 15.4cqi; line-height: 1; font-variation-settings: 'wght' 700; }
  .ci-a__rule { justify-self: center; width: 30cqi; height: 0.4cqi; margin: 7cqi 0 4cqi; background: #e8c46e; }
  .ci-a__f { font-size: 3cqi; letter-spacing: 0.3em; color: #e8c46eaa; }
  .ci-b { background: radial-gradient(90% 60% at 50% 30%, #c45a2a, #3a1608 70%); color: #f6e7c8; font-family: 'Cinzel Variable', serif; text-align: center; text-transform: uppercase; padding: 9cqi 7cqi; display: flex; flex-direction: column; align-items: center; }
  .ci-b__k { font-size: 3.4cqi; letter-spacing: 0.4em; font-variation-settings: 'wght' 700; }
  .ci-b__h { margin-top: auto; font-size: 11cqi; line-height: 0.95; letter-spacing: 0.06em; font-variation-settings: 'wght' 500; }
  .ci-b__h span { display: block; font-size: 21cqi; letter-spacing: 0; font-variation-settings: 'wght' 900; text-shadow: 0 1cqi 3cqi #0008; }
  .ci-b__tag { margin: 5cqi 0 auto; font-size: 3.6cqi; letter-spacing: 0.08em; text-transform: none; font-variation-settings: 'wght' 400; }
  .ci-b__credits { font-size: 2.6cqi; line-height: 1.4; letter-spacing: 0.06em; font-variation-settings: 'wght' 500; opacity: 0.75; padding-top: 3cqi; border-top: 0.3cqi solid #f6e7c844; }
  .ci-c { background: #0e0d0c; color: #e8c46e; font-family: 'Cinzel Variable', serif; padding: 9cqi 7cqi; display: flex; flex-direction: column; }
  .ci-c__g { display: grid; grid-template-columns: repeat(4, 1fr); row-gap: 1cqi; text-align: center; font-size: 14.5cqi; line-height: 1.08; }
  .ci-c__g span:nth-child(5n+2) { color: #f6e7c8; }
  .ci-c__f { margin-top: auto; text-align: center; font-size: 2.8cqi; letter-spacing: 0.12em; color: #e8c46e99; text-transform: uppercase; }
</style>
