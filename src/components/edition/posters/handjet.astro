---
// Handjet posters: a stadium scoreboard message, a pixel heart, element shapes.
---
<figure class="pw-p" id="handjet-scoreboard" data-name="Scoreboard">
  <div class="pw-art hj-pa">
    <p class="hj-pa__l">GAME</p><p class="hj-pa__l">OVER</p>
    <p class="hj-pa__s">INSERT COIN TO CONTINUE</p>
    <p class="hj-pa__hi">HI-SCORE 999 990</p>
  </div>
</figure>
<figure class="pw-p" id="handjet-elements" data-name="Elements">
  <div class="pw-art hj-pb">
    {[[2, 1], [3, 1], [6, 1], [9, 2], [12, 2], [16, 2]].map(([sh, gr], i) => <p style={`font-variation-settings:'wght' ${300 + i * 100}, 'ELSH' ${sh}, 'ELGR' ${gr}`}>Pixel<span>ELSH {sh} · ELGR {gr}</span></p>)}
  </div>
</figure>
<figure class="pw-p" id="handjet-love" data-name="Love">
  <div class="pw-art hj-pc">
    <p class="hj-pc__w">love</p>
    <p class="hj-pc__s">in every element</p>
  </div>
</figure>
<style>
  .hj-pa { background: #0a0a0a; color: #ffb000; font-family: 'Handjet Variable', monospace; text-align: center; display: grid; align-content: center; text-shadow: 0 0 3cqi #ffb00088; background-image: radial-gradient(#ffffff0a 0.5cqi, transparent 0.6cqi); background-size: 2cqi 2cqi; }
  .hj-pa__l { font-size: 40cqi; line-height: 0.82; font-variation-settings: 'wght' 900, 'ELSH' 2, 'ELGR' 1; }
  .hj-pa__s { margin-top: 8cqi; font-size: 6cqi; color: #ff4a3c; font-variation-settings: 'wght' 600, 'ELSH' 2, 'ELGR' 1; text-shadow: 0 0 3cqi #ff4a3c88; }
  .hj-pa__hi { position: absolute; left: 0; right: 0; top: 6cqi; font-size: 5cqi; color: #3cff8a; font-variation-settings: 'wght' 500, 'ELSH' 2, 'ELGR' 1; text-shadow: 0 0 3cqi #3cff8a88; }
  .hj-pb { background: #f1ede4; color: #1b1b1b; font-family: 'Handjet Variable', monospace; display: grid; align-content: center; padding: 0 7cqi; }
  .hj-pb p { position: relative; font-size: 17cqi; line-height: 1; }
  .hj-pb p:nth-child(even) { color: #e6402a; }
  .hj-pb span { position: absolute; right: 0; top: 3cqi; font: 400 2.2cqi/1 var(--font-mono, monospace); color: #1b1b1b88; }
  .hj-pc { background: #e6402a; color: #fff; font-family: 'Handjet Variable', monospace; display: grid; place-content: center; text-align: center; }
  .hj-pc__w { font-size: 44cqi; line-height: 0.85; font-variation-settings: 'wght' 900, 'ELSH' 7, 'ELGR' 2; }
  .hj-pc__s { font-size: 7cqi; font-variation-settings: 'wght' 400, 'ELSH' 2, 'ELGR' 1; letter-spacing: 0.1em; }
</style>
