---
// Roboto Slab posters: a hardware store sign, a field guide, the weight stack.
---
<figure class="pw-p" id="roboto-slab-hardware" data-name="Hardware">
  <div class="pw-art rs-a">
    <p class="rs-a__k">Since 1962</p>
    <p class="rs-a__h">NUTS<br /><em>&amp;</em><br />BOLTS</p>
    <p class="rs-a__s">Hardware · Paint · Keys cut while you wait</p>
  </div>
</figure>
<figure class="pw-p" id="roboto-slab-field-guide" data-name="Field guide">
  <div class="pw-art rs-b">
    <p class="rs-b__n">No. 14</p>
    <p class="rs-b__h">Rocks<br />&amp; Minerals</p>
    <div class="rs-b__g">{['Quartz', 'Mica', 'Basalt', 'Granite', 'Obsidian', 'Pyrite'].map((r, i) => <p><span style={`--c:${['#e8e2d6', '#8a7a5a', '#3a3a3a', '#b8a08a', '#121212', '#c9a43a'][i]}`}></span>{r}</p>)}</div>
    <p class="rs-b__f">A pocket guide for the curious</p>
  </div>
</figure>
<figure class="pw-p" id="roboto-slab-stack" data-name="Stack">
  <div class="pw-art rs-c">
    {[100, 200, 300, 400, 500, 600, 700, 800, 900].map((w) => <p style={`font-variation-settings:'wght' ${w}`}>Slab {w}</p>)}
  </div>
</figure>
<style>
  .rs-a { background: #2a5a8a; color: #fff; font-family: 'Roboto Slab Variable', serif; text-align: center; display: flex; flex-direction: column; align-items: center; padding: 9cqi 6cqi; }
  .rs-a__k { font-size: 3.6cqi; letter-spacing: 0.3em; text-transform: uppercase; font-variation-settings: 'wght' 500; color: #ffd84a; }
  .rs-a__h { margin: auto 0; font-size: 27cqi; line-height: 0.88; font-variation-settings: 'wght' 900; }
  .rs-a__h em { font-style: normal; font-size: 0.6em; color: #ffd84a; font-variation-settings: 'wght' 300; }
  .rs-a__s { font-size: 3.8cqi; font-variation-settings: 'wght' 400; }
  .rs-b { background: #e9e4d6; color: #1f2a1e; font-family: 'Roboto Slab Variable', serif; padding: 8cqi; display: flex; flex-direction: column; }
  .rs-b__n { font-size: 3.6cqi; font-variation-settings: 'wght' 700; color: #b0451e; }
  .rs-b__h { font-size: 15cqi; line-height: 0.92; font-variation-settings: 'wght' 800; margin-top: 2cqi; }
  .rs-b__g { margin-top: 6cqi; display: grid; grid-template-columns: repeat(3, 1fr); gap: 3cqi 5cqi; }
  .rs-b__g p { display: grid; gap: 1.6cqi; font-size: 4cqi; font-variation-settings: 'wght' 500; }
  .rs-b__g span { aspect-ratio: 1; background: var(--c); box-shadow: inset 0 0 0 0.5cqi #1f2a1e22; scale: 0.8; clip-path: polygon(20% 0, 80% 10%, 100% 50%, 75% 100%, 15% 90%, 0 40%); }
  .rs-b__f { margin-top: auto; font-size: 3.6cqi; font-style: italic; font-variation-settings: 'wght' 300; }
  .rs-c { background: #ffd84a; color: #1f2a1e; font-family: 'Roboto Slab Variable', serif; display: grid; align-content: center; padding: 0 8cqi; }
  .rs-c p { font-size: 11.4cqi; line-height: 1.02; }
</style>
