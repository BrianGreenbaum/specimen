---
// Marcellus posters: a museum banner, a temple dedication, an olive-oil label.
---
<figure class="pw-p" id="marcellus-museum" data-name="Museum">
  <div class="pw-art mcp-a">
    <p class="mcp-a__k">Now showing</p>
    <p class="mcp-a__h">Pompeii</p>
    <p class="mcp-a__s">Life before the ash</p>
    <span class="mcp-a__col" aria-hidden="true"></span>
    <p class="mcp-a__f">Room VII · Until September</p>
  </div>
</figure>
<figure class="pw-p" id="marcellus-dedication" data-name="Dedication">
  <div class="pw-art mcp-b">
    <p>DIS · MANIBVS</p><p class="mcp-b__big">AVRELIA</p><p>VIXIT · ANNOS · LXX</p><p>FILIA · MATRI · OPTIMAE</p><p>FECIT</p>
  </div>
</figure>
<figure class="pw-p" id="marcellus-olive" data-name="Olive oil">
  <div class="pw-art mcp-c">
    <div class="mcp-c__l">
      <span class="mcp-c__leaf" aria-hidden="true"></span>
      <p class="mcp-c__k">Extra virgin</p>
      <p class="mcp-c__h">Olea</p>
      <p class="mcp-c__s">Cold pressed in Crete<br />from Koroneiki olives</p>
      <p class="mcp-c__f">500 ml · Harvest MMXXVI</p>
    </div>
  </div>
</figure>
<style>
  .mcp-a { background: #8f2d22; color: #f1ece1; font-family: 'Marcellus', serif; text-align: center; padding: 9cqi 6cqi; display: flex; flex-direction: column; align-items: center; }
  .mcp-a__k { font-size: 3.6cqi; letter-spacing: 0.4em; text-transform: uppercase; }
  .mcp-a__h { margin-top: 5cqi; font-size: 21cqi; line-height: 1; letter-spacing: 0.04em; text-transform: uppercase; }
  .mcp-a__s { font-size: 6cqi; color: #e8c890; }
  .mcp-a__col { margin-top: auto; width: 26cqi; height: 46cqi; background: repeating-linear-gradient(90deg, #f1ece1 0 2.4cqi, #d9cdb6 2.4cqi 3.4cqi); box-shadow: 0 -4cqi 0 -1cqi #f1ece1, 0 4cqi 0 -1cqi #f1ece1; }
  .mcp-a__f { margin-top: 6cqi; font-size: 3.4cqi; letter-spacing: 0.24em; text-transform: uppercase; }
  .mcp-b { background: repeating-linear-gradient(93deg, #0000 0 5px, #20180f08 5px 6px), linear-gradient(#e6dfcf, #cfc4ad); color: #8a7d64; font-family: 'Marcellus', serif; display: grid; align-content: center; text-align: center; gap: 2cqi; box-shadow: inset 0 0 0 5cqi #e0d8c6, inset 0 0 0 5.6cqi #a59880; }
  .mcp-b p { font-size: 6.4cqi; letter-spacing: 0.08em; text-shadow: 0.3cqi 0.3cqi 0 #fffaf0, -0.2cqi -0.2cqi 0.2cqi #20180f99; }
  .mcp-b__big { font-size: 15cqi !important; color: #8f2d22; }
  .mcp-c { background: #1f2a1a; font-family: 'Marcellus', serif; display: grid; place-items: center; }
  .mcp-c__l { position: relative; width: 70cqi; padding: 12cqi 6cqi 8cqi; background: #efe6cc; color: #2a3a1e; text-align: center; display: grid; gap: 2cqi; box-shadow: inset 0 0 0 2cqi #efe6cc, inset 0 0 0 2.4cqi #6a7a3a; }
  .mcp-c__leaf { position: absolute; left: 50%; top: 3cqi; width: 18cqi; height: 7cqi; translate: -50% 0; background: radial-gradient(ellipse at 30% 50%, #6a7a3a 40%, transparent 42%), radial-gradient(ellipse at 70% 50%, #6a7a3a 40%, transparent 42%); }
  .mcp-c__k { font-size: 3.4cqi; letter-spacing: 0.3em; text-transform: uppercase; color: #8a6a1a; }
  .mcp-c__h { font-size: 21cqi; line-height: 1; letter-spacing: 0.04em; }
  .mcp-c__s { font-size: 4.2cqi; line-height: 1.4; }
  .mcp-c__f { margin-top: 3cqi; font-size: 2.8cqi; letter-spacing: 0.2em; text-transform: uppercase; }
</style>
