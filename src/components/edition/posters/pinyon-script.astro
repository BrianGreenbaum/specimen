---
// Pinyon Script posters: a love letter, a monogram, a place card.
---
<figure class="pw-p" id="pinyon-script-letter" data-name="Love letter">
  <div class="pw-art py-a">
    <p class="py-a__d">Paris, the fourteenth of February</p>
    <p class="py-a__h">My dearest,</p>
    <p class="py-a__b">I have written this letter eleven times and torn up ten. This one I shall send before I lose my nerve. Come home soon; the house is far too quiet without you.</p>
    <p class="py-a__s">Ever yours,<br /><span>Juliette</span></p>
  </div>
</figure>
<figure class="pw-p" id="pinyon-script-monogram" data-name="Monogram">
  <div class="pw-art py-b">
    <span class="py-b__ring" aria-hidden="true"></span>
    <p class="py-b__m">E<span>&amp;</span>T</p>
    <p class="py-b__d">XII · VI · MMXXVI</p>
  </div>
</figure>
<figure class="pw-p" id="pinyon-script-thank-you" data-name="Thank you">
  <div class="pw-art py-c">
    <p class="py-c__h">Thank<br />you</p>
    <p class="py-c__s">for being here</p>
  </div>
</figure>
<style>
  .py-a { background: #f7f0e4; color: #2a1e3a; font-family: 'Pinyon Script', cursive; padding: 9cqi; display: flex; flex-direction: column; gap: 4cqi; background-image: repeating-linear-gradient(#0000 0 8.6cqi, #2a1e3a12 8.6cqi calc(8.6cqi + 1px)); }
  .py-a__d { font-size: 5cqi; text-align: right; }
  .py-a__h { font-size: 13cqi; line-height: 1.1; color: #8a2a4a; }
  .py-a__b { font-size: 6.4cqi; line-height: 1.35; }
  .py-a__s { margin-top: auto; text-align: right; font-size: 6cqi; line-height: 1.2; }
  .py-a__s span { font-size: 2em; color: #8a2a4a; }
  .py-b { background: #2a1e3a; color: #e8d0a0; font-family: 'Pinyon Script', cursive; display: grid; place-content: center; text-align: center; }
  .py-b__ring { position: absolute; left: 50%; top: 46%; width: 76cqi; height: 76cqi; translate: -50% -50%; border-radius: 50%; border: 0.4cqi solid #e8d0a0; box-shadow: inset 0 0 0 2cqi #2a1e3a, inset 0 0 0 2.3cqi #e8d0a066; }
  .py-b__m { position: relative; font-size: 36cqi; line-height: 1; }
  .py-b__m span { font-size: 0.5em; color: #c48aa0; margin: 0 -1cqi; }
  .py-b__d { position: absolute; left: 0; right: 0; bottom: 8cqi; font-family: 'Cormorant Garamond', serif; font-size: 3.6cqi; letter-spacing: 0.4em; }
  .py-c { background: #c48aa0; color: #fff; font-family: 'Pinyon Script', cursive; display: grid; place-content: center; text-align: center; }
  .py-c__h { font-size: 36cqi; line-height: 0.85; }
  .py-c__s { margin-top: 6cqi; font-size: 8cqi; color: #2a1e3a; }
</style>
