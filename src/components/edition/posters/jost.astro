---
// Jost posters: a Bauhaus composition, Futura-like geometry, a travel poster.
---
<figure class="pw-p" id="jost-bauhaus" data-name="Bauhaus">
  <div class="pw-art jo-a">
    <span class="jo-a__c" aria-hidden="true"></span><span class="jo-a__t" aria-hidden="true"></span><span class="jo-a__s" aria-hidden="true"></span>
    <p class="jo-a__h">form<br />colour<br />space</p>
    <p class="jo-a__f">Ausstellung · Weimar · 1923</p>
  </div>
</figure>
<figure class="pw-p" id="jost-geometry" data-name="Geometry">
  <div class="pw-art jo-b">
    <p class="jo-b__o">o</p>
    <p class="jo-b__t">A circle,<br />a line,<br /><em>a letter.</em></p>
  </div>
</figure>
<figure class="pw-p" id="jost-riviera" data-name="Riviera">
  <div class="pw-art jo-c">
    <span class="jo-c__sun" aria-hidden="true"></span>
    <span class="jo-c__sea" aria-hidden="true"></span>
    <p class="jo-c__h">RIVIERA</p>
    <p class="jo-c__s">by the night train · from Paris</p>
  </div>
</figure>
<style>
  .jo-a { background: #efe7d6; color: #111; font-family: 'Jost Variable', sans-serif; }
  .jo-a__c { position: absolute; left: 50cqi; top: 8cqi; width: 42cqi; height: 42cqi; border-radius: 50%; background: #d8352a; }
  .jo-a__t { position: absolute; left: 8cqi; top: 28cqi; width: 40cqi; height: 36cqi; background: #2a54a8; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .jo-a__s { position: absolute; left: 40cqi; top: 50cqi; width: 26cqi; height: 26cqi; background: #f2c230; }
  .jo-a__h { position: absolute; left: 8cqi; bottom: 12cqi; font-size: 14cqi; line-height: 0.92; font-variation-settings: 'wght' 700; mix-blend-mode: multiply; }
  .jo-a__f { position: absolute; left: 8cqi; bottom: 6cqi; font-size: 3cqi; letter-spacing: 0.2em; text-transform: uppercase; font-variation-settings: 'wght' 500; }
  .jo-b { background: #111; color: #efe7d6; font-family: 'Jost Variable', sans-serif; }
  .jo-b__o { position: absolute; left: 50%; top: -18cqi; translate: -50% 0; font-size: 120cqi; line-height: 1; font-variation-settings: 'wght' 100; color: #f2c230; }
  .jo-b__t { position: absolute; left: 8cqi; bottom: 8cqi; font-size: 10cqi; line-height: 1; font-variation-settings: 'wght' 400; }
  .jo-b__t em { font-style: italic; font-variation-settings: 'wght' 800; color: #f2c230; }
  .jo-c { background: linear-gradient(#f6c97a, #ef8a5a 55%); color: #fff; font-family: 'Jost Variable', sans-serif; text-align: center; }
  .jo-c__sun { position: absolute; left: 50%; top: 22cqi; width: 46cqi; height: 46cqi; translate: -50% 0; border-radius: 50%; background: #fff3d0; }
  .jo-c__sea { position: absolute; left: 0; right: 0; bottom: 0; height: 52%; background: repeating-linear-gradient(#1f5c8a 0 3cqi, #2a72a8 3cqi 5cqi); }
  .jo-c__h { position: absolute; left: 0; right: 0; top: 66cqi; font-size: 16cqi; line-height: 1; letter-spacing: 0.04em; font-variation-settings: 'wght' 900; }
  .jo-c__s { position: absolute; left: 0; right: 0; bottom: 9cqi; font-size: 3.6cqi; letter-spacing: 0.2em; text-transform: uppercase; font-variation-settings: 'wght' 400; }
</style>
