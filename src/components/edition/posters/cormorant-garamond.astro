---
// Cormorant Garamond posters: a wedding invitation, a quiet Q, a wine label.
---
<figure class="pw-p" id="cormorant-garamond-invitation" data-name="Invitation">
  <div class="pw-art co-a">
    <p class="co-a__k">Together with their families</p>
    <p class="co-a__n">Eleanor</p>
    <p class="co-a__amp">&amp;</p>
    <p class="co-a__n">Thomas</p>
    <p class="co-a__d">request the pleasure of your company<br />on the twelfth of June<br /><em>at four o’clock in the afternoon</em></p>
    <p class="co-a__f">The Orangery · Kew</p>
  </div>
</figure>
<figure class="pw-p" id="cormorant-garamond-quietly" data-name="Quietly">
  <div class="pw-art co-b">
    <p class="co-b__q">Q</p>
    <p class="co-b__t"><em>uietly,</em> beautifully.</p>
    <p class="co-b__f">Cormorant Garamond · Christian Thalmann · 2015</p>
  </div>
</figure>
<figure class="pw-p" id="cormorant-garamond-wine" data-name="Wine label">
  <div class="pw-art co-c">
    <div class="co-c__label">
      <p class="co-c__k">Grand vin</p>
      <p class="co-c__h">Château<br /><em>Cormorant</em></p>
      <span class="co-c__rule" aria-hidden="true"></span>
      <p class="co-c__v">Millésime</p>
      <p class="co-c__y">2015</p>
      <p class="co-c__f">Mis en bouteille au château</p>
    </div>
  </div>
</figure>
<style>
  .co-a { background: #f7f2ea; color: #3a2f28; font-family: 'Cormorant Garamond', serif; text-align: center; padding: 10cqi 8cqi; display: flex; flex-direction: column; align-items: center; box-shadow: inset 0 0 0 4cqi #f7f2ea, inset 0 0 0 4.3cqi #b89a6a; }
  .co-a__k { font-size: 3.4cqi; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 500; color: #8a6a3a; }
  .co-a__n { font-size: 17cqi; line-height: 0.95; font-weight: 300; margin-top: 3cqi; }
  .co-a__amp { font-size: 14cqi; line-height: 0.8; font-style: italic; font-weight: 400; color: #b89a6a; margin-top: 2cqi; }
  .co-a__d { margin-top: auto; font-size: 4.6cqi; line-height: 1.45; font-weight: 400; }
  .co-a__d em { font-style: italic; }
  .co-a__f { margin-top: 4cqi; font-size: 3.4cqi; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600; }
  .co-b { background: #1d1a24; color: #efe7d8; font-family: 'Cormorant Garamond', serif; }
  .co-b__q { position: absolute; left: -2cqi; top: -26cqi; font-size: 112cqi; line-height: 1; font-weight: 300; color: #c9a86a; }
  .co-b__t { position: absolute; left: 9cqi; bottom: 21cqi; font-size: 10cqi; line-height: 1; font-weight: 300; }
  .co-b__t em { font-style: italic; font-weight: 400; color: #c9a86a; }
  .co-b__f { position: absolute; left: 9cqi; bottom: 8cqi; font-size: 3cqi; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 500; opacity: 0.7; }
  .co-c { background: radial-gradient(70% 50% at 50% 40%, #5a1322, #210710); font-family: 'Cormorant Garamond', serif; display: grid; place-items: center; }
  .co-c__label { width: 78cqi; padding: 10cqi 6cqi; background: #f3ead6; color: #2a1a12; text-align: center; display: grid; justify-items: center; gap: 1.6cqi; box-shadow: inset 0 0 0 1.6cqi #f3ead6, inset 0 0 0 1.9cqi #9a7a3a, 0 3cqi 8cqi #0008; }
  .co-c__k { font-size: 3cqi; letter-spacing: 0.4em; text-transform: uppercase; font-weight: 600; color: #9a7a3a; }
  .co-c__h { font-size: 13cqi; line-height: 0.95; font-weight: 600; }
  .co-c__h em { font-style: italic; font-weight: 400; }
  .co-c__rule { width: 12cqi; height: 0.3cqi; background: #9a7a3a; margin: 1.6cqi 0; }
  .co-c__v { font-size: 3.4cqi; font-style: italic; }
  .co-c__y { font-size: 12cqi; line-height: 1; font-weight: 300; letter-spacing: 0.1em; }
  .co-c__f { font-size: 2.4cqi; letter-spacing: 0.2em; text-transform: uppercase; margin-top: 2cqi; }
</style>
