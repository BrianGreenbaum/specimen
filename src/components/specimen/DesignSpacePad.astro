---
// The design space. A 2D pad for any face with two or more axes: drag the
// puck and a giant glyph morphs live through the intersection you choose.
// The first axis runs horizontally, the second vertically; remaining axes
// keep their defaults (or get small dedicated sliders). Named instances from
// the weights list are pinned as dots on the pad so the classic cuts are
// always one click away.
import type { CollectionEntry } from 'astro:content';
export interface Props {
  font: CollectionEntry<'fonts'>['data'];
}
const { font } = Astro.props;
// Horizontal = weight when present (the most expressive run), else first axis.
const sorted = [...font.axes].sort((a, b) => {
  const rank = (t: string) => (t === 'wght' ? -2 : t === 'opsz' ? -1 : 0);
  return rank(a.tag) - rank(b.tag);
});
const [x, y] = sorted;
const extra = sorted.slice(2);
// Pinned instance dots along the weight axis (computed here so the template
// stays free of comparison operators the Astro compiler misreads as JSX).
const pins =
  x.tag === 'wght' ? font.weights.filter((w) => w.weight >= x.min && w.weight <= x.max) : [];
---
<div
  class="dsp"
  data-dsp
  style={`--fam:${font.fontFamily}`}
  data-axes={JSON.stringify(font.axes)}
>
  <div class="dsp__stagebox">
    <div class="dsp__glyph" data-dsp-glyph aria-hidden="true" style={`font-variation-settings:'${x.tag}' ${x.default}, '${y.tag}' ${y.default}${extra.map((a) => `, '${a.tag}' ${a.default}`).join('')}`}>R</div>
    <p class="dsp__readout label" data-dsp-readout></p>
  </div>

  <div class="dsp__controls">
    <div
      class="dsp__pad"
      data-dsp-pad
      role="application"
      tabindex="0"
      aria-label={`Design space: ${x.name} horizontal, ${y.name} vertical`}
      aria-description="Drag or use arrow keys to steer the glyph through the design space."
    >
      <span class="dsp__pad-x label" aria-hidden="true">{x.tag} {x.min} → {x.max}</span>
      <span class="dsp__pad-y label" aria-hidden="true">{y.tag} {y.min} → {y.max}</span>

      {/* pinned instances along the weight axis */}
      {pins.map((w) => (
        <button
          type="button"
          class="dsp__pin"
          data-dsp-pin
          style={`left:${((w.weight - x.min) / (x.max - x.min)) * 100}%; top:${((y.default - y.min) / (y.max - y.min)) * 100}%`}
          title={`${w.name} · default ${y.name.toLowerCase()}`}
          aria-label={`${w.name}, ${w.weight}`}
        ></button>
      ))}

      <span class="dsp__puck" data-dsp-puck></span>
    </div>

    {extra.length > 0 && (
      <div class="dsp__extras">
        {extra.map((a) => (
          <label class="dsp__extra">
            <span class="label">{a.tag} <output data-dsp-extra-out={a.tag}>{a.default}</output></span>
            <input type="range" data-dsp-extra={a.tag} min={a.min} max={a.max} step={a.step} value={a.default} />
          </label>
        ))}
      </div>
    )}

    <div class="dsp__letters" role="group" aria-label="Choose a letter">
      {['R', 'g', 'a', 'e', '&', 'Q'].map((l, i) => (
        <button type="button" class:list={['dsp__letter', { 'is-on': i === 0 }]} data-dsp-letter={l}>{l}</button>
      ))}
      <button type="button" class="dsp__letter dsp__letter--reset" data-dsp-reset title="Reset to defaults">↺</button>
    </div>
  </div>
</div>

<script>
  import { ensureFont } from '../../lib/metrics';

  document.querySelectorAll<HTMLElement>('[data-dsp]').forEach(async (root) => {
    const axes = JSON.parse(root.dataset.axes || '[]');
    const byTag = new Map(axes.map((a: any) => [a.tag, a]));
    const glyphEl = root.querySelector<HTMLElement>('[data-dsp-glyph]')!;
    const readout = root.querySelector<HTMLElement>('[data-dsp-readout]')!;
    const pad = root.querySelector<HTMLElement>('[data-dsp-pad]')!;
    const puck = root.querySelector<HTMLElement>('[data-dsp-puck]')!;

    const cur = new Map<string, number>(axes.map((a: any) => [a.tag, a.default]));
    let letter = 'R';

    await ensureFont(root.style.getPropertyValue('--fam').replace(/['"]/g, ''), 400);

    const apply = () => {
      const v = axes.map((a: any) => `'${a.tag}' ${cur.get(a.tag)}`).join(', ');
      glyphEl.style.fontVariationSettings = v;
      glyphEl.textContent = letter;
      readout.textContent = axes.map((a: any) => `${a.tag} ${cur.get(a.tag)}`).join('   ·   ');
      const xa = byTag.get(axes[0].tag), ya = byTag.get(axes[1].tag);
      const px = ((cur.get(xa.tag)! - xa.min) / (xa.max - xa.min)) * 100;
      const py = ((cur.get(ya.tag)! - ya.min) / (ya.max - ya.min)) * 100;
      puck.style.left = px + '%';
      puck.style.top = py + '%';
    };

    // pointer steering
    let dragging = false;
    const setFromEvent = (e: PointerEvent) => {
      const r = pad.getBoundingClientRect();
      const nx = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      const ny = Math.min(1, Math.max(0, (1 - (e.clientY - r.top) / r.height)));
      const xa: any = axes[0], ya: any = axes[1];
      cur.set(xa.tag, Math.round(xa.min + nx * (xa.max - xa.min)));
      cur.set(ya.tag, Math.round(ya.min + ny * (ya.max - ya.min)));
      apply();
    };
    pad.addEventListener('pointerdown', (e) => {
      dragging = true;
      pad.setPointerCapture(e.pointerId);
      setFromEvent(e as PointerEvent);
    });
    pad.addEventListener('pointermove', (e) => dragging && setFromEvent(e as PointerEvent));
    pad.addEventListener('pointerup', () => (dragging = false));

    // keyboard steering
    pad.addEventListener('keydown', (e) => {
      const k = e.key;
      if (!['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown'].includes(k)) return;
      e.preventDefault();
      const xa: any = axes[0], ya: any = axes[1];
      const stepX = (xa.max - xa.min) / 40;
      const stepY = (ya.max - ya.min) / 20;
      if (k === 'ArrowLeft') cur.set(xa.tag, Math.max(xa.min, cur.get(xa.tag)! - stepX));
      if (k === 'ArrowRight') cur.set(xa.tag, Math.min(xa.max, cur.get(xa.tag)! + stepX));
      if (k === 'ArrowUp') cur.set(ya.tag, Math.min(ya.max, cur.get(ya.tag)! + stepY));
      if (k === 'ArrowDown') cur.set(ya.tag, Math.max(ya.min, cur.get(ya.tag)! - stepY));
      apply();
    });

    // pinned instance dots
    root.querySelectorAll<HTMLButtonElement>('[data-dsp-pin]').forEach((pin) =>
      pin.addEventListener('click', () => {
        const xa: any = axes[0];
        const pct = parseFloat(pin.style.left) / 100;
        cur.set(xa.tag, Math.round(xa.min + pct * (xa.max - xa.min)));
        apply();
      })
    );

    // extra-axis sliders
    root.querySelectorAll<HTMLInputElement>('[data-dsp-extra]').forEach((inp) =>
      inp.addEventListener('input', () => {
        cur.set(inp.dataset.dspExtra!, +inp.value);
        const out = root.querySelector<HTMLElement>(`[data-dsp-extra-out="${inp.dataset.dspExtra}"]`);
        if (out) out.textContent = inp.value;
        apply();
      })
    );

    // letters + reset
    root.querySelectorAll<HTMLButtonElement>('[data-dsp-letter]').forEach((b) =>
      b.addEventListener('click', () => {
        letter = b.dataset.dspLetter!;
        root.querySelectorAll('[data-dsp-letter]').forEach((x) => x.classList.remove('is-on'));
        b.classList.add('is-on');
        apply();
      })
    );
    root.querySelector('[data-dsp-reset]')?.addEventListener('click', () => {
      axes.forEach((a: any) => cur.set(a.tag, a.default));
      root.querySelectorAll<HTMLInputElement>('[data-dsp-extra]').forEach((inp) => {
        const a = byTag.get(inp.dataset.dspExtra!);
        if (a) { inp.value = String(a.default); }
        const out = root.querySelector<HTMLElement>(`[data-dsp-extra-out="${inp.dataset.dspExtra}"]`);
        if (out && a) out.textContent = String(a.default);
      });
      apply();
    });

    apply();
  });
</script>

<style>
  .dsp {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(18rem, 30vw, 26rem);
    gap: var(--sp-5);
    align-items: stretch;
  }

  .dsp__stagebox {
    border: 1px solid var(--fg);
    background: var(--bg);
    display: flex; flex-direction: column;
    min-height: clamp(320px, 48vw, 520px);
  }
  .dsp__glyph {
    flex: 1;
    display: grid; place-items: center;
    font-size: clamp(14rem, 32vw, 28rem);
    line-height: 0.9;
    color: var(--fg);
    transition: font-variation-settings 0.08s linear;
    user-select: none;
  }
  .dsp__readout {
    border-top: 1px solid var(--line);
    padding: var(--sp-2) var(--sp-4);
    color: var(--fg-2);
    font-feature-settings: 'tnum';
  }

  .dsp__controls { display: flex; flex-direction: column; gap: var(--sp-4); }

  .dsp__pad {
    position: relative;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--fg);
    background:
      linear-gradient(to right, transparent calc(50% - 0.5px), var(--line) calc(50% - 0.5px), var(--line) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
      linear-gradient(to bottom, transparent calc(50% - 0.5px), var(--line) calc(50% - 0.5px), var(--line) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--accent) 6%, transparent), transparent 70%),
      var(--bg-2);
    cursor: crosshair;
    touch-action: none;
    outline-offset: 4px;
  }
  .dsp__pad:focus-visible { outline: 2px solid var(--accent); }

  .dsp__pad-x {
    position: absolute; right: var(--sp-2); bottom: var(--sp-1);
    font-size: 0.65rem; pointer-events: none;
  }
  .dsp__pad-y {
    position: absolute; left: var(--sp-2); top: var(--sp-1);
    writing-mode: vertical-rl; transform: rotate(180deg);
    font-size: 0.65rem; pointer-events: none;
  }

  .dsp__pin {
    position: absolute; transform: translate(-50%, -50%);
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--bg); border: 1.5px solid var(--fg-3);
    transition: all 0.2s var(--ease);
    z-index: 2;
  }
  .dsp__pin:hover { border-color: var(--accent); transform: translate(-50%, -50%) scale(1.4); }

  .dsp__puck {
    position: absolute; transform: translate(-50%, -50%);
    width: 22px; height: 22px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px var(--accent);
    pointer-events: none;
    z-index: 3;
    transition: left 0.06s linear, top 0.06s linear;
  }

  .dsp__extras { display: flex; flex-direction: column; gap: var(--sp-3); }
  .dsp__extra { display: flex; flex-direction: column; gap: 0.35rem; }
  .dsp__extra output { color: var(--accent); }
  .dsp__extra input[type='range'] {
    -webkit-appearance: none; appearance: none;
    width: 100%; height: 2px; background: var(--fg-3); cursor: pointer;
  }
  .dsp__extra input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--accent);
  }
  .dsp__extra input[type='range']::-moz-range-thumb {
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--accent);
  }

  .dsp__letters { display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center; }
  .dsp__letter {
    min-width: 2.4rem; padding: 0.45rem 0.55rem;
    font-family: var(--fam); font-size: 1.15rem; line-height: 1;
    border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--fg-2);
    transition: all 0.2s var(--ease);
  }
  .dsp__letter:hover { border-color: var(--fg); color: var(--fg); }
  .dsp__letter.is-on { background: var(--accent); border-color: var(--accent); color: var(--accent-contrast); }
  .dsp__letter--reset { font-family: var(--font-mono); margin-left: auto; }

  @media (max-width: 900px) {
    .dsp { grid-template-columns: 1fr; }
    .dsp__stagebox { order: 2; min-height: 260px; }
    .dsp__controls { order: 1; }
    .dsp__glyph { font-size: clamp(9rem, 38vw, 16rem); }
  }
</style>
