---
// The OpenType playground. One live paragraph carries every enabled feature
// at once — chips toggle tags on the shared stage so effects visibly stack
// (old-style figures + fractions + discretionary ligatures, together).
// Each chip also holds a small dedicated proof so a single feature can be
// judged on its own terms.
import type { CollectionEntry } from 'astro:content';
export interface Props {
  font: CollectionEntry<'fonts'>['data'];
}
const { font } = Astro.props;
const initialTags = font.openType.filter((f) => f.on).map((f) => f.tag);
---
<div class="otf" data-otf style={`--fam:${font.fontFamily}`} data-tags={JSON.stringify(initialTags)}>
  <div class="otf__stagebox">
    <div class="otf__stagehead">
      <span class="label">Live proof</span>
      <span class="label otf__count"><output data-otf-count>{initialTags.length}</output> of {font.openType.length} on</span>
      <button class="otf__reset" type="button" data-otf-reset>↺ Reset</button>
    </div>
    <div
      class="otf__stage"
      data-otf-stage
      contenteditable="true"
      spellcheck="false"
      role="textbox"
      aria-label="Editable OpenType proof"
      style={initialTags.length ? `font-feature-settings:${initialTags.map((t) => `'${t}' 1`).join(', ')}` : ''}
    >{font.sampleText}</div>
  </div>

  <ul class="otf__chips">
    {font.openType.map((f) => (
      <li class="otf__chip" data-reveal>
        <button
          type="button"
          class:list={['otf__switch', { 'is-on': f.on }]}
          data-otf-tag={f.tag}
          aria-pressed={f.on ? 'true' : 'false'}
        >
          <span class="otf__tag">{f.tag}</span>
          <span class="otf__name">{f.label}</span>
          <span class="otf__state" aria-hidden="true"></span>
        </button>
        <p class="otf__sample" style={`font-feature-settings:'${f.tag}' ${f.on ? 1 : 0}`} data-otf-sample={f.tag}>{f.sample}</p>
      </li>
    ))}
  </ul>

  <p class="otf__note">Toggle a tag and watch it land on the proof above — features combine, exactly as they do in real setting.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-otf]').forEach((root) => {
    const stage = root.querySelector<HTMLElement>('[data-otf-stage]')!;
    const countEl = root.querySelector<HTMLElement>('[data-otf-count]')!;
    const total = root.querySelectorAll('[data-otf-tag]').length;

    const switches = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-otf-tag]'));
    const enabled = new Set<string>(JSON.parse(root.dataset.tags || '[]'));

    const apply = () => {
      const css = Array.from(enabled).map((t) => `'${t}' 1`).join(', ');
      stage.style.fontFeatureSettings = css || 'normal';
      countEl.textContent = String(enabled.size);
      switches.forEach((sw) => {
        const tag = sw.getAttribute('data-otf-tag')!;
        const on = enabled.has(tag);
        sw.classList.toggle('is-on', on);
        sw.setAttribute('aria-pressed', String(on));
        const sample = root.querySelector<HTMLElement>(`[data-otf-sample="${tag}"]`);
        if (sample) sample.style.fontFeatureSettings = `'${tag}' ${on ? 1 : 0}`;
      });
    };

    switches.forEach((sw) =>
      sw.addEventListener('click', () => {
        const t = sw.getAttribute('data-otf-tag')!;
        enabled.has(t) ? enabled.delete(t) : enabled.add(t);
        apply();
      })
    );

    root.querySelector('[data-otf-reset]')?.addEventListener('click', () => {
      enabled.clear();
      apply();
    });

    apply();
  });
</script>

<style>
  .otf { display: flex; flex-direction: column; gap: var(--sp-4); }

  .otf__stagebox { border: 1px solid var(--fg); background: var(--bg); }
  .otf__stagehead {
    display: flex; align-items: baseline; gap: var(--sp-4);
    padding: var(--sp-2) var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .otf__count { margin-left: auto; }
  .otf__count output { color: var(--accent); font-weight: 600; }
  .otf__reset {
    font-family: var(--font-mono); font-size: var(--step--1);
    letter-spacing: 0.04em; color: var(--fg-2);
    padding: 0.2rem 0.5rem; border: 1px solid var(--line); border-radius: var(--radius);
    transition: all 0.2s var(--ease);
  }
  .otf__reset:hover { border-color: var(--fg); color: var(--fg); }

  .otf__stage {
    font-family: var(--fam);
    font-size: clamp(1.6rem, 4vw, 3rem);
    line-height: 1.25;
    padding: clamp(1.2rem, 4vw, 2.5rem);
    outline: none;
    min-height: 6rem;
    word-break: break-word;
  }
  .otf__stage:focus { caret-color: var(--accent); }

  .otf__chips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: var(--sp-3);
  }
  .otf__chip {
    display: flex; flex-direction: column;
    border: 1px solid var(--line);
    transition: border-color 0.25s var(--ease);
  }
  .otf__chip:hover { border-color: var(--fg-3); }
  .otf__chip:has(.is-on) { border-color: var(--accent); }

  .otf__switch {
    display: flex; align-items: center; gap: 0.7rem;
    padding: var(--sp-2) var(--sp-3);
    text-align: left;
  }
  .otf__tag {
    font-family: var(--font-mono); font-size: 0.7rem;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--fg-3); border: 1px solid var(--line);
    padding: 0.2em 0.5em; border-radius: 2px;
    transition: all 0.2s var(--ease);
  }
  .is-on .otf__tag {
    color: var(--accent-contrast); background: var(--accent);
    border-color: var(--accent);
  }
  .otf__name { flex: 1; font-size: var(--step-0); font-weight: 500; }

  /* the switch itself */
  .otf__state {
    position: relative; width: 30px; height: 16px; flex: none;
    border: 1px solid var(--fg-3); border-radius: 100px;
    transition: all 0.2s var(--ease);
  }
  .otf__state::after {
    content: ''; position: absolute; top: 2px; left: 2px;
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--fg-3);
    transition: transform 0.25s var(--ease), background 0.2s var(--ease);
  }
  .is-on .otf__state { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .is-on .otf__state::after { transform: translateX(14px); background: var(--accent); }

  .otf__sample {
    font-family: var(--fam);
    font-size: clamp(1.15rem, 2.4vw, 1.55rem);
    line-height: 1.2;
    padding: 0 var(--sp-3) var(--sp-3);
    color: var(--fg-2);
    border-top: 1px dashed var(--line);
    padding-top: var(--sp-2);
    margin: 0 var(--sp-3);
    padding-left: 0; padding-right: 0;
  }

  .otf__note { color: var(--fg-3); font-style: italic; font-size: var(--step--1); }
</style>
