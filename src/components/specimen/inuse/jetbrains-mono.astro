---
import type { CollectionEntry } from 'astro:content';
export interface Props { font: CollectionEntry<'fonts'>['data']; }
const { font } = Astro.props;
const fam = font.fontFamily;

// ── The sequence ─────────────────────────────────────────────────────────────
// JETBRAINS MONO IS THE IDE-NATIVE MONOSPACE — taller, clearer, engineered
// for eight-hour sessions. Five acts live where it lives: the terminal that
// builds this very site (01, interactive) → the diff view where its
// disambiguation earns its keep (02) → the conference badge wall (03,
// branding) → the log stream (04, real px, pausable) → the weight-axis
// theme editor (05 — how IDE themes actually use the variable axis).
//
// Honesty ledger (verified via fontTools against wght binaries):
// · VARIABLE: wght 100–800; true italic same range. No opsz.
// · GSUB in the open release: calt ccmp frac locl. NO => / !== ligature
//   substitutions ship here (those live in JetBrains' own builds) — never
//   shown fusing. calt braces/digit shaping is real and shown.

const buildLines = [
  { t: '$ npm run build', c: 'cmd' },
  { t: 'astro v5 · output: "static"', c: 'dim' },
  { t: '✓ Completed in 812ms', c: 'ok' },
  { t: '22:41:27 ▶ generating static routes', c: 'dim' },
  { t: '✓ 51 page(s) built in 217s', c: 'ok' },
  { t: '$ echo $?', c: 'cmd' },
];
const diffRows = [
  { n: 'const maxRetries = 1;', k: 'del', note: 'l vs 1 — which one shipped?' },
  { n: 'const maxRetries = l;', k: 'add', note: '' },
  { n: 'if (attempt === I) return;', k: 'ctx', note: 'I vs l vs 1: all distinct' },
  { n: 'if (attempt === ll0) return;', k: 'ctx', note: 'zero dotted, always' },
];
---
<div class="iu jb" style={`--fam:${fam}`}>

  <!-- ════════ 01 · WEB UI — the terminal ════════ -->
  <figure class="iu__item iu__item--bleed">
    <figcaption class="iu__cap"><span class="index-num">01</span><span class="label">Web UI — the build terminal, type your own</span></figcaption>
    <div class="iu__scene tm">
      <div class="tm__win">
        <div class="tm__chrome"><i></i><i></i><i></i><span class="tm__title">specimen — zsh</span></div>
        <div class="tm__body" data-jb-log>
          {buildLines.map((l) => (
            <p class:list={['tm__line', `is-${l.c}`]}>{l.t}</p>
          ))}
          <form class="tm__prompt" data-jb-form>
            <span aria-hidden="true">$</span>
            <input data-jb-input type="text" spellcheck="false" autocomplete="off" aria-label="Terminal input" placeholder="try: help" />
          </form>
        </div>
      </div>
    </div>
    <p class="iu__hint label">A working prompt: <em>help</em>, <em>build</em>, <em>clear</em> — or anything else, honestly answered.</p>
  </figure>

  <!-- ════════ 02 · EDITORIAL — the code review ════════ -->
  <figure class="iu__item">
    <figcaption class="iu__cap"><span class="index-num">02</span><span class="label">Editorial — a review of one dangerous line</span></figcaption>
    <div class="iu__scene df">
      <div class="df__pane">
        <header class="df__head"><span>retry.ts</span><span class="df__rev">review requested</span></header>
        {diffRows.map((r) => (
          <div class:list={['df__row', `is-${r.k}`]}>
            <code>{r.n}</code>
            {'note' in r && r.note ? <span class="df__note">{r.note}</span> : null}
          </div>
        ))}
        <footer class="df__foot">Every glyph in the cell keeps its identity — the whole point of a monospace done well.</footer>
      </div>
    </div>
  </figure>

  <!-- ════════ 03 · BRANDING — the conference badges ════════ -->
  <figure class="iu__item">
    <figcaption class="iu__cap"><span class="index-num">03</span><span class="label">Branding — dev-conference badges</span></figcaption>
    <div class="iu__scene bd">
      <div class="bd__wall">
        {[
          { name: 'ada_q', tag: 'SPEAKER', w: 700 },
          { name: 'nullbyte', tag: 'STAFF', w: 500 },
          { name: 'kern panic', tag: 'ATTENDEE', w: 400 },
        ].map((b) => (
          <div class="bd__badge" style={`font-variation-settings:'wght' ${b.w}`}>
            <span class="bd__conf">{b.tag}</span>
            <span class="bd__handle">{b.name}</span>
            <span class="bd__foot">#devtype26 · hall B</span>
          </div>
        ))}
      </div>
    </div>
  </figure>

  <!-- ════════ 04 · DATA — the log stream, real px ════════ -->
  <figure class="iu__item">
    <figcaption class="iu__cap"><span class="index-num">04</span><span class="label">Data — production log stream, pause &amp; resume</span></figcaption>
    <div class="iu__scene lg">
      <div class="lg__app">
        <header class="lg__bar">
          <span class="lg__svc">edge-router · eu-west</span>
          <button class="lg__btn" type="button" data-jb-pause aria-pressed="false">Pause</button>
        </header>
        <div class="lg__stream" data-jb-stream aria-live="off"></div>
      </div>
    </div>
  </figure>

  <!-- ════════ 05 · INTERACTIVE — the theme bench ════════ -->
  <figure class="iu__item">
    <figcaption class="iu__cap"><span class="index-num">05</span><span class="label">Interactive — the theme editor’s weight dial</span></figcaption>
    <div class="iu__scene th">
      <label class="th__ctl" for="jb-w">theme base weight <output data-jb-out>400</output></label>
      <input id="jb-w" class="th__range" type="range" min="100" max="800" step="1" value="400" data-jb-range />
      <pre class="th__code" data-jb-code style="font-variation-settings:'wght' 400">{`function retry(fn, times = 3) {
  for (let i = 0; i < times; i++) {
    try { return fn(); }
    catch { sleep(2 ** i * 100); }
  }
  throw new Error("exhausted");
}`}</pre>
      <p class="th__hint label">IDE themes set comments lighter and keywords heavier from one variable file — drag to retune them all.</p>
    </div>
  </figure>

</div>

<script>
  // 01 — tiny honest terminal
  document.querySelectorAll<HTMLElement>('.jb .tm').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-jb-form]');
    const input = root.querySelector<HTMLInputElement>('[data-jb-input]');
    const log = root.querySelector<HTMLElement>('[data-jb-log]');
    form?.addEventListener('submit', (e) => e.preventDefault());
    input?.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      const cmd = input.value.trim();
      if (!cmd) return;
      const line = document.createElement('p');
      line.className = 'tm__line is-cmd';
      line.textContent = `$ ${cmd}`;
      log!.insertBefore(line, form);
      const reply = document.createElement('p');
      reply.className = 'tm__line is-dim';
      if (cmd === 'clear') {
        log!.querySelectorAll('.tm__line').forEach((n) => n.remove());
      } else if (cmd === 'help') {
        reply.textContent = 'commands: build · clear · whoami';
      } else if (cmd === 'build') {
        reply.textContent = '✓ 51 pages built (pretending)';
        reply.className = 'tm__line is-ok';
      } else if (cmd === 'whoami') {
        reply.textContent = 'a reader, presumably';
      } else {
        reply.textContent = `command not found: ${cmd}`;
      }
      if (reply.textContent) log!.insertBefore(reply, form);
      input.value = '';
      log!.parentElement!.scrollTop = log!.parentElement!.scrollHeight;
    });
  });

  // 04 — pausable synthetic log stream (reduced-motion safe)
  document.querySelectorAll<HTMLElement>('.jb .lg').forEach((root) => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stream = root.querySelector<HTMLElement>('[data-jb-stream]');
    const btn = root.querySelector<HTMLButtonElement>('[data-jb-pause]');
    if (!stream || !btn) return;
    const msgs = [
      ['INFO ', 'GET /health 200 2ms'],
      ['INFO ', 'GET /v2/route 200 11ms cache=hit'],
      ['WARN ', 'slow upstream: maps 412ms'],
      ['INFO ', 'POST /session 201 9ms'],
      ['ERROR', 'upstream timeout: locks 1500ms'],
      ['INFO ', 'GET /static/wght.css 200 1ms cache=hit'],
    ];
    let i = 0; let timer: number | undefined; let paused = false;
    const push = () => {
      const [lvl, msg] = msgs[i++ % msgs.length]!;
      const row = document.createElement('p');
      row.className = 'lg__row';
      const stamp = new Date().toISOString().slice(11, 23);
      const lvlEl = document.createElement('i');
      lvlEl.className = `lg__lvl is-${lvl.trim().toLowerCase()}`;
      lvlEl.textContent = lvl;
      row.appendChild(lvlEl);
      row.appendChild(document.createTextNode(`${stamp}  ${msg}`));
      stream.appendChild(row);
      while (stream.childElementCount > 14) stream.firstElementChild!.remove();
      stream.scrollTop = stream.scrollHeight;
    };
    const start = () => { if (timer) return; timer = window.setInterval(push, 900); };
    const stop = () => { window.clearInterval(timer); timer = undefined; };
    for (let s = 0; s < 6; s++) push();
    if (!reduce) start();
    btn.addEventListener('click', () => {
      paused = !paused;
      btn.setAttribute('aria-pressed', String(paused));
      btn.textContent = paused ? 'Resume' : 'Pause';
      paused ? stop() : start();
    });
  });

  // 05 — weight dial
  document.querySelectorAll<HTMLElement>('.jb .th').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('[data-jb-range]');
    const out = root.querySelector<HTMLElement>('[data-jb-out]');
    const code = root.querySelector<HTMLElement>('[data-jb-code]');
    range?.addEventListener('input', () => {
      if (out) out.textContent = range.value;
      code?.style.setProperty('font-variation-settings', `'wght' ${range.value}`);
    });
  });
</script>

<style>
  .jb .iu__scene * { font-family: var(--fam); }

  /* ── 01 terminal ── */
  .tm { background: #0c0e13; padding: clamp(2rem, 8cqi, 6rem); display: grid; place-items: center; }
  .tm__win { width: min(100%, 40rem); background: #12141a; border: 1px solid #dfe4ee17; border-radius: 10px; overflow: hidden; box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.85); }
  .tm__chrome { display: flex; align-items: center; gap: 7px; padding: 10px 13px; background: #191d26; }
  .tm__chrome i { width: 11px; height: 11px; border-radius: 50%; background: #2c3240; }
  .tm__chrome i:nth-child(1) { background: #ff5f57; } .tm__chrome i:nth-child(2) { background: #febc2e; } .tm__chrome i:nth-child(3) { background: #28c840; }
  .tm__title { margin-inline: auto; font-size: 12px; color: #6f7789; transform: translateX(-18px); }
  .tm__body { padding: 14px 16px 16px; min-height: 220px; display: flex; flex-direction: column; gap: 3px; }
  .tm__line { font-size: 13px; line-height: 1.55; white-space: pre-wrap; word-break: break-word; }
  .is-cmd, .is-ok { color: #5ecfb1; }
  .is-dim { color: #6f7789; }
  .tm__prompt { display: flex; gap: 8px; align-items: baseline; margin-top: 6px; }
  .tm__prompt span { color: #5ecfb1; font-size: 13px; }
  .tm__prompt input { flex: 1; background: transparent; border: 0; outline: none; color: #dfe4ee; font-size: 13px; caret-color: #5ecfb1; }

  /* ── 02 diff ── */
  .df { background: var(--bg); padding: clamp(1.5rem, 5cqi, 3.5rem); }
  .df__pane { width: min(100%, 36rem); margin-inline: auto; border: 1px solid var(--line); background: var(--bg-2); }
  .df__head { display: flex; justify-content: space-between; align-items: baseline; padding: 10px 14px; border-bottom: 1px solid var(--line); font-size: 12px; }
  .df__rev { font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: #5ecfb1; }
  .df__row { padding: 10px 14px; border-bottom: 1px dashed var(--line); display: flex; flex-direction: column; gap: 3px; }
  .df__row code { font-size: 13.5px; line-height: 1.5; }
  .is-del { background: color-mix(in srgb, #e5534b 10%, transparent); }
  .is-del code { text-decoration: line-through; text-decoration-color: color-mix(in srgb, #e5534b 60%, transparent); }
  .is-add { background: color-mix(in srgb, #5ecfb1 10%, transparent); }
  .df__note { font-size: 11px; color: var(--fg-3); font-style: italic; }
  .df__foot { padding: 11px 14px; font-size: 12px; color: var(--fg-3); }

  /* ── 03 badges ── */
  .bd { background: #1a1d24; padding: clamp(2rem, 8cqi, 5rem); }
  .bd__wall { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr)); gap: 1.2rem; max-width: 46rem; margin-inline: auto; }
  .bd__badge { background: #12141a; border: 1px solid #dfe4ee1c; padding: 1.4rem 1.2rem 1rem; display: flex; flex-direction: column; gap: 0.5rem; clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 16px, 100% 100%, 0 100%); }
  .bd__conf { font-size: 0.62rem; letter-spacing: 0.16em; color: #5ecfb1; }
  .bd__handle { font-size: clamp(1.25rem, 3.6cqi, 1.7rem); color: #dfe4ee; word-break: break-all; }
  .bd__foot { font-size: 0.68rem; color: #6f7789; border-top: 1px dashed #dfe4ee1c; padding-top: 0.6rem; margin-top: 0.4rem; }

  /* ── 04 logs (real px) ── */
  .lg { display: grid; place-items: start center; background: var(--bg); }
  .lg__app { width: min(100%, 34rem); border: 1px solid var(--line); background: var(--bg); color: var(--fg); }
  .lg__bar { display: flex; justify-content: space-between; align-items: center; padding: 9px 13px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--fg) 4%, var(--bg)); }
  .lg__svc { font-size: 12px; color: var(--fg-2); }
  .lg__btn { font-family: var(--font-ui); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; border: 1px solid var(--line); border-radius: 3px; padding: 4px 9px; color: var(--fg-2); }
  .lg__btn[aria-pressed='true'] { background: #5ecfb1; border-color: #5ecfb1; color: #10131a; }
  .lg__stream { height: 240px; overflow-y: auto; padding: 10px 13px; display: flex; flex-direction: column; gap: 2px; }
  .lg__row { font-size: 12px; line-height: 1.6; color: var(--fg-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lg__lvl { font-style: normal; margin-right: 8px; }
  .is-info { color: #5ecfb1; } .is-warn { color: #febc2e; } .is-error { color: #e5534b; }

  /* ── 05 theme bench ── */
  .th { background: #0c0e13; color: #dfe4ee; padding: clamp(2rem, 7cqi, 5rem); display: flex; flex-direction: column; gap: 1rem; max-width: 100%; }
  .th__ctl { display: flex; justify-content: space-between; font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.12em; color: #5ecfb1; max-width: 40rem; width: 100%; margin-inline: auto; }
  .th__range { width: min(40rem, 100%); accent-color: #5ecfb1; cursor: ew-resize; margin-inline: auto; display: block; }
  .th__code {
    width: min(40rem, 100%); margin-inline: auto;
    background: #12141a; border: 1px solid #dfe4ee17;
    padding: 1.2rem 1.4rem; font-size: clamp(0.82rem, 2.4cqi, 0.98rem);
    line-height: 1.65; overflow-x: auto;
    transition: font-variation-settings 0.1s linear;
    white-space: pre;
  }
  .th__hint { max-width: 40rem; width: 100%; margin-inline: auto; color: #6f7789; }
</style>
