---
import type { CollectionEntry } from 'astro:content';
export interface Props { font: CollectionEntry<'fonts'>['data']; }
const { font } = Astro.props;
const fam = font.fontFamily;

// 02 — trailhead board: weight = proximity (the nearest trail reads heaviest)
const trails = [
  { name: 'Cascade Overlook', frac: '1/2', dec: 0.5, mi: 'MI.', wght: 900 },
  { name: 'Granite Fork Falls', frac: '1 3/4', dec: 1.75, mi: 'MI.', wght: 700 },
  { name: 'Hermit Lake', frac: '4 1/2', dec: 4.5, mi: 'MI.', wght: 500 },
  { name: 'Pacific Crest Jct.', frac: '11 1/4', dec: 11.25, mi: 'MI.', wght: 300 },
];

// 03 — sidebar: sleeper routes relaid (CSS bars, lining figures — the font's default)
const routes = [
  { route: 'Vienna — Paris', km: '1,034', pct: 100 },
  { route: 'Berlin — Stockholm', km: '918', pct: 89 },
  { route: 'Brussels — Prague', km: '882', pct: 85 },
  { route: 'Zürich — Rome', km: '694', pct: 67 },
];
---
<div class="iu" style={`--fam:${fam}`}>

  <!-- ============ 01 — ILLUSTRATION & COMMERCIAL ============ -->
  <figure class="iu__item iu__item--bleed">
    <figcaption class="iu__cap">
      <span class="index-num">01</span>
      <span class="label">Illustration &amp; commercial — a Victorian fight-night playbill, after Vincent Figgins’s two-line Antique (1817) and the every-line-a-different-face playbill convention</span>
    </figcaption>
    <div class="iu__scene">
      <div class="pb">
        <div class="pb__sheet">
          <p class="pb__venue">Royal Albion Rooms · Lambeth</p>
          <p class="pb__patron">Under the immediate patronage of the Fancy</p>
          <div class="pb__rule pb__rule--double" aria-hidden="true"></div>
          <p class="pb__when">On <b>Monday</b> Evening, <b>June the 17th</b>, 1861,</p>
          <p class="pb__big pb__big--1" data-press>GRAND</p>
          <p class="pb__big pb__big--2" data-press>PUGILISTIC</p>
          <p class="pb__big pb__big--3" data-press>TOURNAMENT!</p>
          <div class="pb__rule" aria-hidden="true"></div>
          <p class="pb__bill">
            <span class="pb__man">M<sup>R.</sup> JEM MACE</span>
            <span class="pb__of">of Norwich, Champion of England,</span>
            <span class="pb__vs">will spar</span>
            <span class="pb__man">M<sup>R.</sup> SAM HURST</span>
            <span class="pb__of">“The Stalybridge Infant,” of Lancashire,</span>
          </p>
          <p class="pb__rounds">TWELVE ROUNDS — NEW RULES OF THE RING</p>
          <div class="pb__rule" aria-hidden="true"></div>
          <p class="pb__prices">Boxes 2<i>s.</i> &nbsp;—&nbsp; Pit 1<i>s.</i> &nbsp;—&nbsp; Gallery 6<i>d.</i> &nbsp;·&nbsp; Doors open at Seven o’Clock</p>
          <p class="pb__imprint">Printed by W. S. Johnson, “Nassau Steam Press,” 60, St. Martin’s Lane, Charing Cross, London.</p>
        </div>
      </div>
    </div>
    <p class="iu__hint label">One family does the whole bill: the display stack climbs the weight axis 700 → 800 → 900 over a 300-weight venue line, sizes following word length like a case of wood type. Press a big line — the letterpress bites deeper.</p>
  </figure>

  <!-- ============ 02 — BRANDING & IDENTITY ============ -->
  <figure class="iu__item iu__item--bleed" data-shoot-click=".np__row[data-w='300']">
    <figcaption class="iu__cap">
      <span class="index-num">02</span>
      <span class="label">Branding &amp; identity — a trailhead sign system, after the routed Clarendon boards of the U.S. National Park Service</span>
    </figcaption>
    <div class="iu__scene">
      <div class="np">
        <div class="np__id">
          <span class="np__roundel" aria-hidden="true">
            <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M20 68 38 40l9 13 11-19 22 34Z" fill="currentColor"/><circle cx="68" cy="30" r="5.5" fill="currentColor"/></svg>
          </span>
          <h3 class="np__park">Granite<br/>Fork</h3>
          <p class="np__sub">National Park · Est. 1923</p>
          <div class="np__sys">
            <p class="np__sys-k">Sign standard <b>GF-4</b></p>
            <p class="np__sys-line">Letters routed <span class="np__frac">3/8</span> in. deep in fir, painted board <span class="np__frac">1 1/2</span> in. stock.</p>
            <p class="np__sys-line np__sys-line--rule">Distance is set in weight — <b>the nearest trail reads heaviest.</b></p>
          </div>
        </div>
        <div class="np__board" role="list" aria-label="Trailhead distances">
          <p class="np__board-k">← Trailhead · North Rim</p>
          {trails.map((t) => (
            <p class="np__row" role="listitem" tabindex="0" data-trail data-w={t.wght} data-mi={t.dec} style={`--w:${t.wght}`}>
              <span class="np__dest">{t.name}</span>
              <span class="np__dots" aria-hidden="true"></span>
              <span class="np__mi"><span class="np__frac" data-mi-frac>{t.frac}</span> <span class="np__mi-live" data-mi-live hidden></span> {t.mi}</span>
            </p>
          ))}
          <p class="np__board-f">Pets on leash · Pack out what you pack in</p>
        </div>
        <div class="np__apps" aria-label="The mark at three more scales">
          <p class="np__apps-k">One mark, every fixture — standard GF-4</p>
          <span class="np__badge">
            <span class="np__badge-r" aria-hidden="true">
              <svg viewBox="0 0 100 100"><circle cx="50" cy="50" r="47" fill="none" stroke="currentColor" stroke-width="3"/><path d="M20 68 38 40l9 13 11-19 22 34Z" fill="currentColor"/><circle cx="68" cy="30" r="5.5" fill="currentColor"/></svg>
            </span>
            <span class="np__badge-t">Granite Fork<br/><i>Ranger · District 4</i></span>
          </span>
          <span class="np__map">
            <span class="np__map-k">GF-4 · North Rim Quad</span>
            <span class="np__map-w">Granite Fork</span>
            <span class="np__map-s">Scale 1:24,000 · Contour <span class="np__frac">1/2</span> mi.</span>
          </span>
          <span class="np__way">
            <span class="np__way-k">Junction post · GF-4.2</span>
            <span class="np__way-w">Cascade Overlook <i class="np__way-a" aria-hidden="true">→</i></span>
            <span class="np__way-s"><span class="np__frac">1/2</span> mi. · Steep grade ahead</span>
          </span>
        </div>
      </div>
    </div>
    <p class="iu__hint label">True fractions (<code>frac</code>) cut the mileages. Hover or tap a trail to walk it — the miles count down to zero as the row gains weight toward 900: distance set in weight, performed.</p>
  </figure>

  <!-- ============ 03 — EDITORIAL ============ -->
  <figure class="iu__item">
    <figcaption class="iu__cap">
      <span class="index-num">03</span>
      <span class="label">Editorial — a feature page, after Mark Porter’s 2005 Berliner <em>Guardian</em> and Guardian Egyptian’s hairline-to-black register</span>
    </figcaption>
    <div class="iu__scene">
      <div class="nw">
        <header class="nw__mast">
          <span class="nw__paper">The Ledger</span>
          <span class="nw__sec">Industry</span>
          <span class="nw__date">Saturday 13 June 2026</span>
        </header>
        <div class="nw__lede">
          <p class="nw__kick">The Rail Files</p>
          <h3 class="nw__head" data-head>The night train comes&nbsp;back</h3>
          <p class="nw__deck">Twenty years after the sleepers were scrapped, Europe is relaying its overnight network — and freight is quietly paying for the renaissance.</p>
          <p class="nw__by">Margit Keller <span>in Vienna</span></p>
        </div>
        <div class="nw__body">
          <div class="nw__cols">
            <p><b class="nw__drop">T</b>he 23:18 to Paris leaves from a platform that did not exist in January. Carriage by carriage, the operators that spent the 2000s tearing up their overnight timetables are rebuilding them — and discovering that the hardest part is not the track but the rolling stock, most of which was sold for scrap at the bottom of the market.</p>
            <p>The economics only close because of what runs behind the sleepers. Every relaid night path is shared with freight, and the freight pays: a single intermodal service covers the access charges of three passenger departures. The night network, in other words, is being rebuilt the way it was built the first time — on cargo.</p>
            <p>In the yards outside Vienna the refurbishers work in two shifts. A carriage comes in as a shell and leaves, eleven weeks later, with couchettes, a steel corridor floor, and a number plate from a class withdrawn in 2003. “Nobody believed the demand,” says the yard’s director, “until the demand sold out every berth to March.”</p>
          </div>
          <blockquote class="nw__pull">
            <p><span class="nw__pull-q">“</span>We sold the rolling stock for scrap. Now we are buying the night back, carriage by carriage.”</p>
            <footer>— Ute Brandstätter, ÖBB night-network director</footer>
          </blockquote>
          <aside class="nw__side">
            <p class="nw__side-k">Sleepers, relaid</p>
            <p class="nw__side-sub">Overnight routes reopened since 2021, by length</p>
            {routes.map((r) => (
              <p class="nw__route" tabindex="0">
                <span class="nw__route-t"><span class="nw__route-n">{r.route}</span><span class="nw__km">{r.km} km</span></span>
                <span class="nw__bar" aria-hidden="true"><i style={`--p:${r.pct}%`}></i></span>
              </p>
            ))}
            <p class="nw__side-src">Source: ERA network statements, 2026</p>
          </aside>
        </div>
        <footer class="nw__folio"><span>The Ledger</span><span>Industry · Page 23</span><span>ledger.eu/rail-files</span></footer>
      </div>
    </div>
    <p class="iu__hint label">One slab, every register: as the page enters, the headline eases from 300 down to a true hairline 100 — the Guardian Egyptian move — against a 900 pull quote and 400 text. Select the text; even the highlight is house style.</p>
  </figure>

  <!-- ============ 04 — WEB & APP UI ============ -->
  <figure class="iu__item" data-shoot-click="[data-wt-preset='600']">
    <figcaption class="iu__cap">
      <span class="index-num">04</span>
      <span class="label">Web &amp; app UI — a reading app at real device scale, after Google Play Books’ Material 3 “Display options” sheet (interactive)</span>
    </figcaption>
    <div class="iu__scene iu__scene--rd" style="--rw:400">
      <div class="rd-room">
      <div class="rd-rail" aria-hidden="true">
        <span class="rd-rail__k rd-rail__k--l">wght 100 · Thin</span>
        <span class="rd-rail__k rd-rail__k--r">wght 900 · Black</span>
        <span class="rd-rail__marker">wght <b data-rail-val>400</b></span>
      </div>
      <p class="rd-pole rd-pole--l" aria-hidden="true">It was a town of red brick, or of brick that would have been red if the smoke and ashes had allowed it.</p>
      <p class="rd-pole rd-pole--r" aria-hidden="true">It was a town of red brick, or of brick that would have been red if the smoke and ashes had allowed it.</p>
      <div class="rd" data-rd data-mode="paper" data-flowmode="flowing">
        <div class="rd__top">
          <span class="rd__back" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14.5 5 8 12l6.5 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <span class="rd__book">Hard Times <i>· Dickens</i></span>
          <span class="rd__dots" aria-hidden="true">⋮</span>
        </div>
        <div class="rd__page" data-page>
          <p class="rd__ch"><span>Book the First — Chapter V</span><span class="rd__ch-w">wght <b data-wt-echo>400</b></span></p>
          <h4 class="rd__ch-t">The Key-note</h4>
          <p>It was a town of red brick, or of brick that would have been red if the smoke and ashes had allowed it; but as matters stood, it was a town of unnatural red and black like the painted face of a savage.</p>
          <p>It was a town of machinery and tall chimneys, out of which interminable serpents of smoke trailed themselves for ever and ever, and never got uncoiled. It had a black canal in it, and a river that ran purple with ill-smelling dye, and vast piles of building full of windows where there was a rattling and a trembling all day long, and where the piston of the steam-engine worked monotonously up and down, like the head of an elephant in a state of melancholy madness.</p>
        </div>
        <div class="rd__prog" aria-hidden="true"><i></i></div>
        <div class="rd__foot"><span>page 89 of 412</span><span>22 min left in chapter</span></div>
        <div class="rd__ctrl">
          <div class="rd__flow" role="group" aria-label="Display mode">
            <button class="rd__flow-b is-on" data-flow="flowing" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12.5 10 18 19.5 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Flowing text</button>
            <button class="rd__flow-b" data-flow="original" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 12.5 10 18 19.5 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Original pages</button>
          </div>
          <div class="rd__themes" role="group" aria-label="Reading theme">
            <button class="rd__theme is-on" data-theme="paper" aria-pressed="true">Paper</button>
            <button class="rd__theme" data-theme="sepia" aria-pressed="false">Sepia</button>
            <button class="rd__theme" data-theme="night" aria-pressed="false">Night</button>
          </div>
          <div class="rd__textset" data-textset>
            <div class="rd__size" role="group" aria-label="Text size">
              <button class="rd__sz" data-sz="-1" aria-label="Smaller text">A<sup>−</sup></button>
              <span class="rd__sz-val" data-sz-val>16</span>
              <button class="rd__sz rd__sz--big" data-sz="1" aria-label="Larger text">A<sup>+</sup></button>
            </div>
            <label class="rd__wt">
              <span>Text weight</span>
              <span class="rd__wt-track">
                <i class="rd__wt-bubble" aria-hidden="true"><b data-wt-bub>400</b></i>
                <input type="range" min="300" max="600" step="10" value="400" data-wt aria-label="Text weight" />
              </span>
            </label>
            <div class="rd__presets" role="group" aria-label="Weight presets">
              {[300, 400, 500, 600].map((w) => (
                <button class={`rd__preset${w === 400 ? ' is-on' : ''}`} data-wt-preset={w} style={`font-weight:${w}`}>{w}</button>
              ))}
            </div>
          </div>
          <p class="rd__locknote" data-locknote hidden>Text settings apply to flowing text only</p>
        </div>
      </div>
      </div>
    </div>
    <p class="iu__hint label">The room is the instrument: the same Coketown sentence stands live at <code>wght</code> 100 and 900, joined by a graduated rail whose vermilion marker tracks the M3 weight slider. Switch to Original pages and the text settings lock, Play Books-style; choose Night and the whole room dims with the reader.</p>
  </figure>

  <!-- ============ 05 — INTERACTIVE & EXPERIMENTAL ============ -->
  <figure class="iu__item iu__item--bleed" data-shoot-click="[data-max]">
    <figcaption class="iu__cap">
      <span class="index-num">05</span>
      <span class="label">Interactive &amp; experimental — <em>Tonnage</em>, a goods-yard weighbridge for letters, after the railway weighbridges of Henry Pooley &amp; Son, Albion Foundry, Liverpool</span>
    </figcaption>
    <div class="iu__scene">
      <div class="tn" data-tn style="--w:100; --load:0">
        <div class="tn__head">
          <span class="tn__plate">Weighbridge N<sup>o</sup> 14 · Granite Fork Goods Yard</span>
          <span class="tn__cert">Board of Trade certified · <span class="tn__frac">1/10</span> t</span>
        </div>
        <div class="tn__stage">
          <div class="tn__wordbox" aria-hidden="true">
            <p class="tn__word" data-word>TONNAGE</p>
            <p class="tn__word tn__word--feet">TONNAGE</p>
          </div>
          <div class="tn__platform" data-platform aria-hidden="true"></div>
          <div class="tn__pit" aria-hidden="true"></div>
          <p class="tn__cal" aria-hidden="true">Calibration · 2 t per 100 units of wght · range 2 t — 18 t</p>
          <p class="tn__note"><i aria-hidden="true"></i>The slabs are the feet — the load bears on the serifs, flat to the deck</p>
        </div>
        <div class="tn__deck">
          <div class="tn__read">
            <span class="tn__read-k">Gross load</span>
            <span class="tn__read-v"><b data-tons>2.0</b> t</span>
            <span class="tn__read-w">wght <b data-wval>100</b></span>
          </div>
          <label class="tn__lever">
            <span class="label">Load</span>
            <input type="range" min="100" max="900" step="1" value="100" data-lever aria-label="Load — drives the weight axis" />
            <span class="tn__ends" aria-hidden="true"><i>100 · tare</i><i>900 · max</i></span>
          </label>
          <div class="tn__btns">
            <button class="tn__btn" data-tare>Tare</button>
            <button class="tn__btn tn__btn--max" data-max>Max load</button>
          </div>
        </div>
        <div class="tn__foot">
          <span class="tn__maker">Henry Pooley &amp; Son · Albion Foundry, Liverpool · Makers to the Railways · N<sup>o</sup> 2214</span>
          <span class="tn__tariff">Yard tariff per t: coal 1<span class="tn__frac">1/2</span> d. · timber 2<span class="tn__frac">1/4</span> d. · pig iron 3<span class="tn__frac">3/4</span> d.</span>
        </div>
      </div>
    </div>
    <p class="iu__hint label">The bridge opens at tare. Haul the lever and the word takes on real mass — wght 100 → 900, two tonnes per hundred units, as engraved on the deck — while the platform sinks and the slab’s serif feet glow vermilion at the contact line: the load is carried on the slabs.</p>
  </figure>

</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- 01: letterpress press — pressing a display line deepens the impression ----
  document.querySelectorAll<HTMLElement>('[data-press]').forEach((line) => {
    const down = () => line.classList.add('is-press');
    const up = () => line.classList.remove('is-press');
    line.addEventListener('pointerdown', down);
    line.addEventListener('pointerup', up);
    line.addEventListener('pointerleave', up);
  });

  // ---- 02: trailhead — hover/tap a trail to walk it: miles count to 0, weight climbs to 900 ----
  document.querySelectorAll<HTMLElement>('[data-trail]').forEach((row) => {
    const base = Number(row.dataset.w);
    const miles = Number(row.dataset.mi);
    const frac = row.querySelector<HTMLElement>('[data-mi-frac]')!;
    const live = row.querySelector<HTMLElement>('[data-mi-live]')!;
    let raf = 0;
    let sticky = false;
    let hold = 0; // a completed walk holds its 0.00 MI landing for a beat before resetting
    const render = (p: number) => {
      row.style.fontWeight = String(Math.round(base + (900 - base) * p));
      live.textContent = (miles * (1 - p)).toFixed(2);
    };
    const walk = (on: boolean) => {
      cancelAnimationFrame(raf);
      clearTimeout(hold);
      if (!on) {
        row.classList.remove('is-walk');
        row.style.fontWeight = '';
        frac.hidden = false;
        live.hidden = true;
        return;
      }
      row.classList.add('is-walk');
      frac.hidden = true;
      live.hidden = false;
      if (reduce) { render(1); return; }
      const t0 = performance.now();
      const dur = 600;
      const step = (t: number) => {
        const p = Math.min(1, (t - t0) / dur);
        render(1 - Math.pow(1 - p, 3));
        if (p < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };
    const leave = () => {
      if (sticky) return;
      clearTimeout(hold);
      hold = window.setTimeout(() => walk(false), 850);
    };
    row.addEventListener('pointerenter', () => { if (!sticky) walk(true); });
    row.addEventListener('pointerleave', leave);
    row.addEventListener('focus', () => walk(true));
    row.addEventListener('blur', leave);
    row.addEventListener('click', () => { sticky = !sticky; walk(sticky); });
  });

  // ---- 03: the headline eases 300 → 100 as the page scrolls into view ----
  const head = document.querySelector<HTMLElement>('[data-head]');
  if (head) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { head.classList.add('is-in'); io.disconnect(); } });
    }, { threshold: 0.5 });
    io.observe(head);
  }

  // ---- 04: reader — display mode, themes (Night takes the room), size, live weight axis ----
  document.querySelectorAll<HTMLElement>('[data-rd]').forEach((rd) => {
    const scene = rd.closest<HTMLElement>('.iu__scene') || rd;
    const page = rd.querySelector<HTMLElement>('[data-page]')!;
    const themes = Array.from(rd.querySelectorAll<HTMLButtonElement>('[data-theme]'));
    themes.forEach((b) =>
      b.addEventListener('click', () => {
        rd.dataset.mode = b.dataset.theme;
        scene.classList.toggle('is-night', b.dataset.theme === 'night');
        themes.forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      })
    );
    // Flowing text / Original pages — original locks the text settings (the Play Books rule)
    const flows = Array.from(rd.querySelectorAll<HTMLButtonElement>('[data-flow]'));
    const textset = rd.querySelector<HTMLElement>('[data-textset]')!;
    const locknote = rd.querySelector<HTMLElement>('[data-locknote]')!;
    flows.forEach((b) =>
      b.addEventListener('click', () => {
        const original = b.dataset.flow === 'original';
        rd.setAttribute('data-flowmode', b.dataset.flow!);
        flows.forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        textset.classList.toggle('is-locked', original);
        textset.querySelectorAll<HTMLButtonElement | HTMLInputElement>('button, input').forEach((el) => { el.disabled = original; });
        locknote.hidden = !original;
      })
    );
    let size = 16;
    const szVal = rd.querySelector<HTMLElement>('[data-sz-val]')!;
    rd.querySelectorAll<HTMLButtonElement>('[data-sz]').forEach((b) =>
      b.addEventListener('click', () => {
        size = Math.min(20, Math.max(13, size + Number(b.dataset.sz)));
        page.style.fontSize = size + 'px';
        szVal.textContent = String(size);
      })
    );
    // weight drives the page, the M3 value bubble, AND the room's rail marker
    const wt = rd.querySelector<HTMLInputElement>('[data-wt]')!;
    const bub = rd.querySelector<HTMLElement>('[data-wt-bub]')!;
    const wtEcho = rd.querySelector<HTMLElement>('[data-wt-echo]')!;
    const railVal = scene.querySelector<HTMLElement>('[data-rail-val]');
    const presets = Array.from(rd.querySelectorAll<HTMLButtonElement>('[data-wt-preset]'));
    const setWeight = (v: string, smooth: boolean) => {
      scene.classList.toggle('is-smooth', smooth && !reduce);
      scene.style.setProperty('--rw', v);
      bub.textContent = v;
      wtEcho.textContent = v;
      if (railVal) railVal.textContent = v;
      presets.forEach((p) => p.classList.toggle('is-on', p.dataset.wtPreset === v));
      if (wt.value !== v) wt.value = v;
    };
    wt.addEventListener('input', () => setWeight(wt.value, false));
    presets.forEach((p) => p.addEventListener('click', () => setWeight(p.dataset.wtPreset!, true)));
  });

  // ---- 05: tonnage — the lever drives the axis; the platform takes the load ----
  document.querySelectorAll<HTMLElement>('[data-tn]').forEach((tn) => {
    const lever = tn.querySelector<HTMLInputElement>('[data-lever]')!;
    const tons = tn.querySelector<HTMLElement>('[data-tons]')!;
    const wval = tn.querySelector<HTMLElement>('[data-wval]')!;
    const set = (v: number, smooth: boolean) => {
      tn.classList.toggle('is-smooth', smooth && !reduce);
      tn.style.setProperty('--w', String(v));
      tn.style.setProperty('--load', String((v - 100) / 800));
      // as engraved on the deck: 2 t per 100 units of wght (tare 2 t, max 18 t)
      tons.textContent = (v / 50).toFixed(1);
      wval.textContent = String(v);
      if (lever.value !== String(v)) lever.value = String(v);
    };
    lever.addEventListener('input', () => set(Number(lever.value), false));
    tn.querySelector('[data-tare]')!.addEventListener('click', () => set(100, true));
    tn.querySelector('[data-max]')!.addEventListener('click', () => set(900, true));
    // the bridge opens at tare: the first pull of the lever performs the whole 100 → 900 journey
    set(100, false);
  });
</script>

<style>
