  .nw__body { display: grid; grid-template-columns: minmax(0, 2.1fr) minmax(0, 1fr); gap: clamp(1.2rem, 3cqi, 2.75rem); padding-top: clamp(1rem, 2.6cqi, 2.2rem); }
  /* columns by measure, not by count: each column must clear ~36ch or it collapses
     to one — no sub-35ch choppy rag at any width (column-count caps at 2) */
  .nw__cols { columns: 36ch 2; column-gap: clamp(1.1rem, 2.4cqi, 2.2rem); column-rule: 1px solid #18141018; font-size: clamp(12.5px, 1.45cqi, 16.5px); font-weight: 400; line-height: 1.58; }
  .nw__cols p + p { margin-top: 0.9em; }
