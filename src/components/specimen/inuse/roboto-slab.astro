  /* ============================================================
     04 — READER · real device px, Play Books “Display options”.
     The whole scene is the weight instrument: the same Coketown
     sentence stands live at wght 100 and 900 flanking the device,
     and a graduated rail runs pole to pole under the room with a
     vermilion marker tracking the slider's --rw. The rail is the
     ground line act 05's weighbridge platform then inherits.
     ============================================================ */
  @property --rw { syntax: '<number>'; inherits: true; initial-value: 400; }
  .iu__scene--rd {
    position: relative;
    background:
      radial-gradient(90% 80% at 50% 12%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 62%),
      var(--bg-2);
    --room-ink: var(--fg);
    --room-mut: var(--fg-2);
    --room-line: color-mix(in srgb, var(--fg) 58%, transparent);
  }
  /* .rd-room carries the layout so its container queries resolve against the scene */
  .rd-room { position: relative; padding: clamp(2.5rem, 5cqi, 4.5rem) clamp(0.5rem, 2cqi, 2rem) 7.5rem; }
  @media (prefers-reduced-motion: no-preference) {
    .iu__scene--rd.is-smooth { transition: --rw 0.3s var(--ease-out); }
  }
  /* Night follows the reader out of the device: a dark layer settles on the room */
  .iu__scene--rd::before { content: ''; position: absolute; inset: 0; background: #131008; opacity: 0; pointer-events: none; }
  .iu__scene--rd.is-night::before { opacity: 0.94; }
  .iu__scene--rd.is-night { --room-ink: #e8dcc0; --room-mut: #b3a37d; --room-line: #e8dcc06b; }
  @media (prefers-reduced-motion: no-preference) {
    .iu__scene--rd::before { transition: opacity 0.45s var(--ease); }
    .rd-pole, .rd-rail { transition: color 0.45s var(--ease), border-color 0.45s var(--ease); }
    .rd-rail__k { transition: color 0.45s var(--ease); }
  }
  /* the poles: the same page, set live at the ends of the axis */
  .rd-pole {
    position: absolute; z-index: 1; bottom: calc(3.4rem + 1.4rem);
    width: min(24cqi, 330px);
    font-size: clamp(15px, 1.9cqi, 23px); line-height: 1.5;
    color: var(--room-ink);
  }
  .rd-pole--l { left: 4cqi; font-weight: 100; }
