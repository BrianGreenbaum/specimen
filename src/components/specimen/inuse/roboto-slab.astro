  .np__badge-t i { font-weight: 300; letter-spacing: 0.16em; color: #c9b890; font-size: 0.82em; }
  .np__map { display: flex; flex-direction: column; justify-content: center; background: #efe4cd; color: #33240f; padding: clamp(0.8rem, 2cqi, 1.5rem) clamp(0.9rem, 2.2cqi, 1.75rem); border-left: 4px solid var(--verm); }
  .np__map-k { font-size: clamp(9px, 1.15cqi, 13px); font-weight: 500; letter-spacing: 0.2em; text-transform: uppercase; color: #7a6845; }
  .np__map-w { font-size: clamp(14px, 2.2cqi, 27px); font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; margin-top: 0.15em; }
  .np__map-s { font-size: clamp(9px, 1.15cqi, 13px); font-weight: 400; letter-spacing: 0.06em; margin-top: 0.3em; font-feature-settings: 'frac'; color: #5d4d2e; }
  /* the junction post: the board's own routed detail, at hand-rail scale */
  .np__way { display: flex; flex-direction: column; justify-content: center; background: #2a1d0e; padding: clamp(0.8rem, 2cqi, 1.5rem) clamp(0.9rem, 2.2cqi, 1.75rem); box-shadow: inset 0 0 0 6px #2a1d0e, inset 0 0 0 7px #150d04, inset 0 0 0 8px #efe4cd30; }
