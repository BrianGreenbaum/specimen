  .nw__drop { float: left; font-size: 5.35em; line-height: 0.74; font-weight: 900; padding: 0.024em 0.1em 0 0; color: var(--verm); }
  /* the spread's second register: vermilion rules and an oversized 900 opening
     quote give the middle of the page its own focal accent */
  .nw__pull { grid-column: 1; border-top: 3px solid var(--verm); border-bottom: 1px solid color-mix(in srgb, var(--verm) 38%, transparent); margin-top: clamp(0.4rem, 1cqi, 0.8rem); padding: clamp(0.8rem, 1.8cqi, 1.4rem) 0; }
  /* hung punctuation: the oversized opening quote sits in the margin, text optically flush */
  .nw__pull p { font-size: clamp(17px, 2.9cqi, 33px); font-weight: 900; line-height: 1.16; letter-spacing: -0.01em; max-width: 30ch; text-indent: -0.52em; }
  .nw__pull-q { font-size: 1.85em; font-weight: 900; line-height: 0; color: var(--verm); vertical-align: -0.28em; letter-spacing: -0.06em; }
  .nw__pull footer { font-size: clamp(10.5px, 1.3cqi, 14px); font-weight: 400; color: #6e6354; margin-top: 0.8em; }
  .nw__side { grid-column: 2; grid-row: 1 / span 2; background: #efe8d6; padding: clamp(0.9rem, 2.2cqi, 1.75rem); align-self: start; }
  .nw__side-k { font-size: clamp(13px, 1.8cqi, 20px); font-weight: 900; letter-spacing: 0.01em; }
  .nw__side-sub { font-size: clamp(10.5px, 1.3cqi, 14px); font-weight: 400; color: #6e6354; margin-top: 0.3em; line-height: 1.4; }
  .nw__route { margin-top: clamp(0.7rem, 1.6cqi, 1.2rem); outline: none; }
  /* name and figure share one line above the bar — each route reads as one unit */
  .nw__route-t { display: flex; justify-content: space-between; align-items: baseline; gap: 1em; }
  .nw__route-n { font-size: clamp(11px, 1.4cqi, 15px); font-weight: 700; }
  .nw__bar { display: block; height: clamp(8px, 1.2cqi, 12px); background: #18141014; margin-top: 0.35em; }
  .nw__bar i { display: block; height: 100%; width: var(--p); background: #181410; transform-origin: left; transition: background 0.2s var(--ease); }
  .nw__route:hover .nw__bar i, .nw__route:focus-visible .nw__bar i { background: var(--verm); }
  .nw__km { font-size: clamp(12px, 1.6cqi, 18px); font-weight: 900; white-space: nowrap; }
  .nw__side-src { font-size: clamp(9.5px, 1.15cqi, 12px); font-weight: 300; color: #6e6354; margin-top: clamp(0.8rem, 1.8cqi, 1.3rem); }
  .nw__folio { display: flex; justify-content: space-between; gap: 1em; border-top: 1px solid #18141033; margin-top: clamp(1.1rem, 2.8cqi, 2.4rem); padding-top: 0.5rem; font-size: clamp(9.5px, 1.15cqi, 12px); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: #6e6354; }

  @container (max-width: 760px) {
