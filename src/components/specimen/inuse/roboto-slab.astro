     ============================================================ */
  .nw { background: #f9f5ea; color: #181410; padding: clamp(1.25rem, 3.5cqi, 3.25rem) clamp(1.1rem, 4cqi, 4rem) clamp(1rem, 2.5cqi, 2rem); }
