  .nw__sec { font-size: clamp(11px, 1.4cqi, 15px); font-weight: 500; letter-spacing: 0.26em; text-transform: uppercase; color: var(--verm); }
  .nw__date { margin-left: auto; font-size: clamp(10px, 1.3cqi, 14px); font-weight: 400; color: #6e6354; }
  .nw__lede { padding: clamp(0.9rem, 2.4cqi, 1.9rem) 0 clamp(0.8rem, 2.1cqi, 1.7rem); border-bottom: 1px solid #18141022; }
  .nw__kick { font-size: clamp(11px, 1.5cqi, 16px); font-weight: 900; letter-spacing: 0.2em; text-transform: uppercase; color: var(--verm); }
  /* the Guardian Egyptian move: news headline in the LIGHT end of the slab —
     it eases 300 → 100 (a performed hairline) as the page scrolls into view.
     The hairline IS the page's picture: it dominates the sheet at 1440. */
  .nw__head { font-size: clamp(2.2rem, 10.6cqi, 8.6rem); font-weight: 300; font-variation-settings: 'wght' 300; line-height: 1.0; letter-spacing: -0.015em; margin-top: 0.16em; max-width: 14ch; }
