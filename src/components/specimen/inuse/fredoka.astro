---
import type { CollectionEntry } from 'astro:content';
export interface Props { font: CollectionEntry<'fonts'>['data']; }
const { font } = Astro.props;
const fam = font.fontFamily;

// 01 — Plump! cold-pressed juice: the wdth axis as flavour voice
const cans = [
  { mod: 'cherry', flav: ['SOUR', 'CHERRY'], wd: 75,  hd: 125, note: 'tight & tart — wdth 75',  blurb: 'Puckers first, smiles after.' },
  { mod: 'yuzu',   flav: ['YUZU', 'FIZZ'],   wd: 100, hd: 125, note: 'true round — wdth 100',   blurb: 'The circle, carbonated.' },
  { mod: 'peach',  flav: ['PEACH', 'SUN'],   wd: 125, hd: 75,  note: 'wide open — wdth 125',    blurb: 'Cheeks full of July.' },
];

// 03 — Snack magazine: ingredients exercise the live `frac` feature
const ingredients = [
  { pre: '1 ', frac: '1/2', post: ' cups flour, the fluffy kind' },
  { pre: '',   frac: '3/4', post: ' cup milk, cold as a creek' },
  { pre: '',   frac: '1/4', post: ' tsp salt (a small pinch, big job)' },
  { pre: '',   frac: '1/2', post: ' stick butter, for the pan & the soul' },
  { pre: '2 ', frac: '',    post: 'eggs, cracked with confidence' },
];
const steps = [
  { n: '1', t: 'Whisk like you mean it', d: 'Lumps are shy. Chase them out with twenty big circles.' },
  { n: '2', t: 'Pour a puddle', d: 'About the size of your hand. The pan should whisper, not shout.' },
  { n: '3', t: 'Wait for the wink', d: 'When the bubbles open and wink at you — flip. One brave motion.' },
];

// 04 — Alef: a Hebrew lesson at real device scale (Hebrew subset ships with Fredoka)
const quiz = [
  { prompt: 'thank you', opts: [
    { he: 'שלום',     tr: 'shalom',     right: false },
    { he: 'תודה',     tr: 'todá',       right: true  },
    { he: 'סליחה',    tr: 'slichá',     right: false },
    { he: 'להתראות',  tr: 'lehitra’ot', right: false },
  ]},
  { prompt: 'good morning', opts: [
    { he: 'לילה טוב', tr: 'láyla tov',  right: false },
    { he: 'בוקר טוב', tr: 'bóker tov',  right: true  },
    { he: 'מה נשמע',  tr: 'ma nishmá',  right: false },
    { he: 'שלום',     tr: 'shalom',     right: false },
  ]},
  { prompt: 'please', opts: [
    { he: 'כן',       tr: 'ken',        right: false },
    { he: 'לא',       tr: 'lo',         right: false },
    { he: 'בבקשה',    tr: 'bevakashá',  right: true  },
    { he: 'סליחה',    tr: 'slichá',     right: false },
  ]},
];

// 05 — Balloon practice
const word = 'BALLOON'.split('');
---
<div class="iu iu--fredoka" style={`--fam:${fam}`}>

  <!-- ============ 01 · BRANDING & IDENTITY — Plump! ============ -->
  <figure class="iu__item iu__item--bleed">
    <figcaption class="iu__cap"><span class="index-num">01</span><span class="label">Branding &amp; identity — Plump! cold-pressed juice; the width axis as flavour voice</span></figcaption>
    <div class="iu__scene">
      <div class="plump">
      <div class="plump__intro">
        <span class="plump__eyebrow">Identity system · cold-pressed · 2026</span>
        <span class="plump__wm">plump!</span>
        <p class="plump__manifesto">Juice with its cheeks full. One rounded skeleton, three widths&nbsp;— every flavour speaks at its own setting of the same wordmark.</p>
        <div class="plump__spec">
          <span>Wordmark · SemiBold 600</span>
          <span>Voice · wdth 75 / 100 / 125</span>
          <span>Squeezed, never shouted</span>
        </div>
      </div>
      <div class="plump__shelf">
        {cans.map((c) => (
          <div class={`plump__can plump__can--${c.mod}`} style={`--wd:${c.wd}; --hd:${c.hd}`} tabindex="0">
            <span class="plump__lid" aria-hidden="true"></span>
            <span class="plump__mark">plump!</span>
            <span class="plump__flav">{c.flav.map((l) => <span class="plump__fl">{l}</span>)}</span>
            <span class="plump__blurb">{c.blurb}</span>
            <span class="plump__note">{c.note}</span>
            <span class="plump__meta">
              <span class="plump__ml">330&thinsp;ml</span>
              <span class="plump__barcode" aria-hidden="true"></span>
            </span>
          </div>
        ))}
        <span class="plump__shelfline" aria-hidden="true"></span>
      </div>
      </div>
    </div>
    <p class="iu__hint label">Give a can a squeeze (hover) — each flavour name springs to the far end of Fredoka’s width axis and settles back.</p>
  </figure>

  <!-- ============ 02 · ILLUSTRATION & COMMERCIAL — The Big Scoop ============ -->
  <figure class="iu__item iu__item--bleed">
    <figcaption class="iu__cap"><span class="index-num">02</span><span class="label">Illustration &amp; commercial — The Big Scoop, an ice-cream-social broadside after Push Pin</span></figcaption>
    <div class="iu__scene">
      <div class="scoop">
      <div class="scoop__sun" aria-hidden="true">
        <i class="scoop__arc scoop__arc--1"></i>
        <i class="scoop__arc scoop__arc--2"></i>
        <i class="scoop__arc scoop__arc--3"></i>
        <i class="scoop__arc scoop__arc--4"></i>
        <i class="scoop__arc scoop__arc--5"></i>
      </div>
      <div class="scoop__ringwrap" aria-hidden="true">
        <svg class="scoop__ring" viewBox="0 0 100 100">
          <defs><path id="fredoka-scoop-ring" d="M50,50 m-42,0 a42,42 0 1,1 84,0 a42,42 0 1,1 -84,0" fill="none"/></defs>
          <text><textPath href="#fredoka-scoop-ring">EVERYBODY GETS A DOUBLE&ensp;·&ensp;EVERYBODY GETS A DOUBLE&ensp;·&ensp;</textPath></text>
        </svg>
      </div>
      <header class="scoop__mast">The Ninth Street Block Association presents</header>
      <h3 class="scoop__title"><span class="scoop__t1">THE BIG</span><span class="scoop__t2">SCOOP</span></h3>
      <p class="scoop__sub">An ice-cream social on the green</p>
      <p class="scoop__sub2">Free admission · bring a spoon</p>
      <footer class="scoop__foot">
        <span>Sat July 18 · noon till dusk</span>
        <span>Silkscreen in four colours</span>
      </footer>
      </div>
    </div>
    <p class="iu__hint label">Wide-track Bold at wdth 125 with a solid offset shadow — the Push Pin sunrise, reset on the web; the date ring turns like a carousel.</p>
  </figure>

  <!-- ============ 03 · EDITORIAL — Snack magazine ============ -->
  <figure class="iu__item">
    <figcaption class="iu__cap"><span class="index-num">03</span><span class="label">Editorial — Snack, the happy food mag for kids (after Anorak); live OpenType fractions</span></figcaption>
    <div class="iu__scene">
      <div class="snack">
      <div class="snack__page snack__page--verso">
        <span class="snack__head">snack <i>· the happy food mag</i></span>
        <span class="snack__badge"><b>No.&thinsp;12</b>the breakfast issue</span>
        <h3 class="snack__display" data-flip>FLIP!</h3>
        <p class="snack__deck">Twelve pancakes, one spatula, zero fear — a field guide for small chefs and their tall assistants.</p>
        <p class="snack__byline">Words · Pip Okafor&emsp;Pans · Grandma Rosa</p>
        <span class="snack__folio">24</span>
      </div>
      <span class="snack__gutter" aria-hidden="true"></span>
      <div class="snack__page snack__page--recto">
        <div class="snack__col snack__col--need">
          <h4 class="snack__h">What you need <em class="snack__tag">OpenType frac — live</em></h4>
          <ul class="snack__list">
            {ingredients.map((it) => (
              <li>{it.pre}{it.frac && <span class="snack__frac">{it.frac}</span>}{it.post}</li>
            ))}
          </ul>
          <blockquote class="snack__pull">“Butter first. Always butter&nbsp;first.”<cite>— Grandma Rosa, pan sage</cite></blockquote>
        </div>
        <div class="snack__col snack__col--do">
          <h4 class="snack__h">What you do</h4>
          <ol class="snack__steps">
            {steps.map((s) => (
              <li><span class="snack__num">{s.n}</span><span class="snack__step"><b>{s.t}</b>{s.d}</span></li>
            ))}
          </ol>
        </div>
        <span class="snack__folio snack__folio--r">25 · flip!</span>
      </div>
      </div>
    </div>
    <p class="iu__hint label">The fractions are real OpenType <code>frac</code> — Fredoka’s own numerals, not typed glyphs. Click FLIP! to flip it.</p>
  </figure>

  <!-- ============ 04 · WEB & APP UI — Alef ============ -->
  <figure class="iu__item" data-shoot-click='[data-q="0"] [data-right]'>
    <figcaption class="iu__cap"><span class="index-num">04</span><span class="label">Web &amp; app UI — Alef, a Hebrew lesson at real device scale (interactive)</span></figcaption>
    <div class="iu__scene alef-scene">
      <div class="alef" data-alef>
        <div class="alef__statusbar"><span>9:41</span><span class="alef__notch" aria-hidden="true"></span><svg class="alef__batt" viewBox="0 0 26 12" aria-hidden="true"><rect x="0.5" y="0.5" width="22" height="11" rx="3" fill="none" stroke="currentColor"/><rect x="24" y="3.5" width="2" height="5" rx="1" fill="currentColor"/><rect x="2.5" y="2.5" width="15" height="7" rx="1.5" fill="currentColor"/></svg></div>
        <header class="alef__top">
          <button class="alef__back" aria-label="Back to units"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <div class="alef__progress" aria-label="Lesson progress">
            <i data-seg></i><i data-seg></i><i data-seg></i>
          </div>
          <span class="alef__streak"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2c1 4-3 5.5-3 9a3.4 3.4 0 002 3c-.2-1.6.8-2.4 1.6-3.6C13.8 12.6 17 14 17 17a5 5 0 01-10 .2C7 13 10 11 10 7c1.4 1 2 2.4 2 4 1.4-2.2.6-5.6 0-9z" fill="currentColor"/></svg>23</span>
        </header>
        <span class="alef__unit">Unit 2 · Greetings</span>
        <div class="alef__panels">
          {quiz.map((q, qi) => (
            <section class={`alef__q ${qi === 0 ? 'is-active' : ''}`} data-q={qi}>
              <h4 class="alef__prompt">Which one means <em>“{q.prompt}”</em>?</h4>
              <div class="alef__opts">
                {q.opts.map((o) => (
                  <button class="alef__opt" {...(o.right ? { 'data-right': '' } : {})}>
                    <span class="alef__he" dir="rtl" lang="he">{o.he}</span>
                    <span class="alef__tr">{o.tr}</span>
                  </button>
                ))}
              </div>
            </section>
          ))}
          <section class="alef__q alef__q--done" data-q="done">
            <span class="alef__bigdone" dir="rtl" lang="he">!כל הכבוד</span>
            <span class="alef__donesub">Kol hakavod — nice work.</span>
            <span class="alef__xp">+30 XP &ensp;·&ensp; 24-day streak</span>
            <button class="alef__again" data-reset>Practice again</button>
          </section>
        </div>
        <footer class="alef__foot">
          <button class="alef__cta" data-continue disabled>Continue</button>
        </footer>
      </div>
    </div>
    <p class="iu__hint label">A real lesson, 13&thinsp;px body — tap the right answer, the bar fills, the streak holds. Fredoka ships its Hebrew alongside the Latin.</p>
  </figure>

  <!-- ============ 05 · INTERACTIVE & EXPERIMENTAL — Balloon practice ============ -->
  <figure class="iu__item iu__item--bleed">
    <figcaption class="iu__cap"><span class="index-num">05</span><span class="label">Interactive &amp; experimental — Balloon practice: the cursor is the air pump</span></figcaption>
    <div class="iu__scene">
      <div class="balloon" data-balloon>
      <span class="balloon__eyebrow">After DIA’s kinetic wordmarks · two live axes, no italic, all air</span>
      <div class="balloon__word">
        {word.map((l) => (
          <button class="balloon__l" data-l aria-label={`Pop the letter ${l}`}><span class="balloon__g">{l}</span></button>
        ))}
      </div>
      <div class="balloon__readout" aria-hidden="true">
        <span data-read-w>wght 300</span>
        <span class="balloon__sep">·</span>
        <span data-read-d>wdth 75</span>
      </div>
      <span class="balloon__foot">Fredoka Variable — wght 300–700 × wdth 75–125</span>
      </div>
    </div>
    <p class="iu__hint label">Sweep across the word to pump air into the letters; click one and it pops. Reduced motion holds the full ramp, 300 to 700, left to right.</p>
  </figure>

</div>

<script>
// ---- 03 · FLIP! ----
document.querySelectorAll<HTMLElement>('[data-flip]').forEach((el) => {
  el.addEventListener('click', () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    el.classList.remove('is-flip');
    void el.offsetWidth;
    el.classList.add('is-flip');
  });
});

// ---- 04 · Alef lesson ----
document.querySelectorAll<HTMLElement>('[data-alef]').forEach((app) => {
  const panels = Array.from(app.querySelectorAll<HTMLElement>('[data-q]'));
  const qPanels = panels.filter((p) => p.dataset.q !== 'done');
  const donePanel = panels.find((p) => p.dataset.q === 'done')!;
  const segs = Array.from(app.querySelectorAll<HTMLElement>('[data-seg]'));
  const cont = app.querySelector<HTMLButtonElement>('[data-continue]')!;
  const reset = app.querySelector<HTMLButtonElement>('[data-reset]')!;
  let idx = 0;

  const show = (p: HTMLElement) => panels.forEach((x) => x.classList.toggle('is-active', x === p));

  qPanels.forEach((panel, qi) => {
    panel.querySelectorAll<HTMLButtonElement>('.alef__opt').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (panel.classList.contains('is-solved')) return;
        if (btn.hasAttribute('data-right')) {
          panel.classList.add('is-solved');
          btn.classList.add('is-right');
          segs[qi]?.classList.add('is-full');
          cont.disabled = false;
          cont.textContent = qi === qPanels.length - 1 ? 'Finish lesson' : 'Continue';
        } else {
          btn.classList.add('is-wrong');
          window.setTimeout(() => btn.classList.remove('is-wrong'), 600);
        }
      });
    });
  });

  cont.addEventListener('click', () => {
    if (cont.disabled) return;
    idx += 1;
    if (idx < qPanels.length) {
      show(qPanels[idx]);
      cont.disabled = true;
      cont.textContent = 'Continue';
    } else {
      show(donePanel);
      app.classList.add('is-done');
    }
  });

  reset.addEventListener('click', () => {
    idx = 0;
    qPanels.forEach((p) => {
      p.classList.remove('is-solved');
      p.querySelectorAll('.alef__opt').forEach((b) => b.classList.remove('is-right', 'is-wrong'));
    });
    segs.forEach((s) => s.classList.remove('is-full'));
    app.classList.remove('is-done');
    cont.disabled = true;
    cont.textContent = 'Continue';
    show(qPanels[0]);
  });
});

// ---- 05 · Balloon practice ----
document.querySelectorAll<HTMLElement>('[data-balloon]').forEach((scene) => {
  const letters = Array.from(scene.querySelectorAll<HTMLButtonElement>('[data-l]'));
  const readW = scene.querySelector<HTMLElement>('[data-read-w]');
  const readD = scene.querySelector<HTMLElement>('[data-read-d]');
  const n = letters.length;
  const rest = letters.map((_, i) => (n > 1 ? i / (n - 1) : 0));
  const cur = rest.slice();
  const target = rest.slice();
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  function apply(i: number, t: number): [number, number] {
    const wg = Math.round(300 + 400 * t);
    const wd = Math.round(75 + 50 * t);
    letters[i].style.fontVariationSettings = `'wght' ${wg}, 'wdth' ${wd}`;
    letters[i].style.transform = `translateY(${(-0.1 * t).toFixed(3)}em)`;
    return [wg, wd];
  }
  letters.forEach((_, i) => apply(i, rest[i]));

  if (!reduce.matches) {
    let raf = 0;
    const tick = () => {
      let busy = false;
      let maxT = -1, mw = 300, md = 75;
      cur.forEach((c, i) => {
        const d = target[i] - c;
        if (Math.abs(d) > 0.004) { cur[i] = c + d * 0.16; busy = true; } else { cur[i] = target[i]; }
        const [wg, wd] = apply(i, cur[i]);
        if (cur[i] > maxT) { maxT = cur[i]; mw = wg; md = wd; }
      });
      if (readW) readW.textContent = `wght ${mw}`;
      if (readD) readD.textContent = `wdth ${md}`;
      raf = busy ? requestAnimationFrame(tick) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };

    scene.addEventListener('pointermove', (e) => {
      letters.forEach((l, i) => {
        const r = l.getBoundingClientRect();
        const cx = r.left + r.width / 2;
        const cy = r.top + r.height / 2;
        const dist = Math.hypot(e.clientX - cx, (e.clientY - cy) * 0.55);
        target[i] = Math.max(0, Math.min(1, 1 - dist / (r.width * 2.1)));
      });
      kick();
    });
    scene.addEventListener('pointerleave', () => {
      rest.forEach((v, i) => { target[i] = v; });
      kick();
    });
  }

  letters.forEach((l) => {
    l.addEventListener('click', () => {
      if (reduce.matches) return;
      const g = l.querySelector<HTMLElement>('.balloon__g');
      if (!g) return;
      g.classList.remove('is-pop');
      void g.offsetWidth;
      g.classList.add('is-pop');
    });
  });
});
</script>

<style>
  /* ================= the stack: pacing & handoffs ================= */
  .iu--fredoka { gap: clamp(3.25rem, 8vh, 6rem); }
  .iu--fredoka * { font-family: var(--fam); }
  .iu--fredoka ::selection { background: #f5820a; color: #fffcf5; }
  /* 01→02 run tight: two silkscreens off the same press */
  .iu--fredoka > .iu__item:nth-child(2) { margin-top: calc(clamp(3.25rem, 8vh, 6rem) * -0.45); }
  /* a longer breath before the dark finale */
  .iu--fredoka > .iu__item:nth-child(5) { margin-top: clamp(1.5rem, 4vh, 3.5rem); }

  /* =================================================================
     01 · PLUMP! — DTC shelf (self-declared surface: orange field)
     ================================================================= */
  .plump {
    --field: #ee7e08;
    --ink: #2b1502;
    --cream: #fff4e0;
    background: var(--field);
    color: var(--ink);
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: 5cqi;
    padding: 6cqi 8cqi 0;
  }
  .plump__intro { display: flex; flex-direction: column; gap: 1.6cqi; padding-bottom: 6cqi; }
  .plump__eyebrow {
    font-size: clamp(11px, 1.05cqi, 16px); font-weight: 600;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--cream);
  }
  .plump__wm {
    font-size: clamp(56px, 9.5cqi, 150px); font-weight: 600; line-height: 0.95;
    letter-spacing: -0.025em; color: var(--ink);
    font-variation-settings: 'wght' 600, 'wdth' 100;
  }
  .plump__manifesto {
    margin: 0; max-width: 30ch;
    font-size: clamp(14px, 1.35cqi, 21px); font-weight: 500; line-height: 1.45;
    color: color-mix(in srgb, var(--ink) 82%, var(--field));
  }
  .plump__spec {
    display: flex; flex-wrap: wrap; gap: 0.5em 1.6em;
    margin-top: 0.6cqi; padding-top: 1.2cqi;
    border-top: 2px solid color-mix(in srgb, var(--ink) 30%, transparent);
    font-size: clamp(10px, 0.95cqi, 14px); font-weight: 600;
    letter-spacing: 0.06em; color: var(--ink);
  }

  .plump__shelf {
    position: relative; align-self: end;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3cqi; padding: 0 1cqi;
  }
  .plump__shelfline {
    position: absolute; left: -4cqi; right: -9cqi; bottom: 0; height: 2px;
    background: color-mix(in srgb, var(--ink) 38%, transparent);
  }
  .plump__can {
    --flav: #c8372d;
    position: relative;
    display: flex; flex-direction: column; align-items: center;
    background: var(--cream); color: var(--ink);
    border-radius: 2.2cqi 2.2cqi 0.7cqi 0.7cqi;
    padding: 0 1.6cqi 1.8cqi;
    min-height: 30cqi;
    transition: transform 0.35s cubic-bezier(.3,1.6,.4,1);
  }
  .plump__can:hover, .plump__can:focus-visible { transform: translateY(-1.2cqi); }
  .plump__can--cherry { --flav: #c0332a; }
  .plump__can--yuzu   { --flav: #c98f0e; }
  .plump__can--peach  { --flav: #8a4ab8; }
  .plump__lid {
    width: 62%; height: 1.1cqi; margin-top: 1.4cqi;
    border-radius: 100px; background: var(--flav); opacity: 0.9;
  }
  .plump__mark {
    margin-top: 1.6cqi;
    font-size: clamp(13px, 1.6cqi, 24px); font-weight: 600; letter-spacing: -0.02em;
    color: var(--ink);
  }
  .plump__flav {
    margin-top: auto; padding-top: 1cqi;
    display: flex; flex-direction: column; align-items: center;
    color: var(--flav); text-align: center;
  }
  .plump__fl {
    font-size: clamp(22px, 3.6cqi, 56px); font-weight: 700; line-height: 0.98;
    letter-spacing: 0;
    font-variation-settings: 'wght' 700, 'wdth' var(--wd);
    transition: font-variation-settings 0.45s cubic-bezier(.3,1.4,.4,1);
  }
  .plump__can:hover .plump__fl, .plump__can:focus-visible .plump__fl {
    font-variation-settings: 'wght' 700, 'wdth' var(--hd);
  }
  .plump__blurb {
    margin-top: 0.9cqi; text-align: center;
    font-size: clamp(10px, 1.05cqi, 15px); font-weight: 500;
    color: color-mix(in srgb, var(--ink) 75%, var(--cream));
  }
  .plump__note {
    margin: auto 0 0; padding-top: 1.4cqi;
    font-size: clamp(9px, 0.85cqi, 12px); font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 60%, var(--cream));
  }
  .plump__meta {
    width: 100%; margin-top: 1cqi; padding-top: 0.9cqi;
    border-top: 1.5px solid color-mix(in srgb, var(--ink) 16%, transparent);
    display: flex; align-items: center; justify-content: space-between; gap: 1cqi;
  }
  .plump__ml { font-size: clamp(10px, 1cqi, 14px); font-weight: 600; }
  .plump__barcode {
    width: 5.5cqi; min-width: 34px; height: 1.6cqi; min-height: 12px;
    background: repeating-linear-gradient(90deg,
      var(--ink) 0 2px, transparent 2px 4px, var(--ink) 4px 5px, transparent 5px 8px,
      var(--ink) 8px 11px, transparent 11px 13px);
    opacity: 0.8;
  }

  /* 768: intro on top, shelf of three below */
  @container (max-width: 979px) {
    .plump { grid-template-columns: 1fr; gap: 2cqi; padding: 7cqi 8cqi 0; }
    .plump__intro { padding-bottom: 0; }
    .plump__manifesto { max-width: 44ch; }
    .plump__shelf { margin-top: 4cqi; }
    .plump__can { min-height: 34cqi; }
  }
  /* 390: cans recompose into full-width shelf-label strips */
  @container (max-width: 559px) {
    .plump { padding: 10cqi 7cqi 0; }
    .plump__shelf { grid-template-columns: 1fr; gap: 3.5cqi; padding: 0; margin-top: 7cqi; }
    .plump__shelfline { left: -7cqi; right: -7cqi; }
    .plump__can {
      min-height: 0;
      display: grid;
      grid-template-columns: auto 1fr auto;
      grid-template-rows: auto auto;
      align-items: center;
      column-gap: 4cqi;
      padding: 3.5cqi 5cqi;
      border-radius: 3cqi;
    }
    .plump__can:hover, .plump__can:focus-visible { transform: none; }
    .plump__lid { display: none; }
    .plump__mark { grid-column: 1; grid-row: 1; margin: 0; font-size: 4cqi; }
    .plump__flav { grid-column: 2; grid-row: 1 / 3; margin: 0; padding: 0; flex-direction: row; gap: 0.28em; justify-content: center; }
    .plump__fl { font-size: 7.4cqi; }
    .plump__blurb { display: none; }
    .plump__note { grid-column: 1; grid-row: 2; margin: 0; padding: 0; font-size: 2.4cqi; text-transform: none; letter-spacing: 0.05em; }
    .plump__meta { grid-column: 3; grid-row: 1 / 3; width: auto; margin: 0; padding: 0; border: 0; flex-direction: column; align-items: flex-end; gap: 1.4cqi; }
  }

  @media (prefers-reduced-motion: reduce) {
    .plump__can, .plump__fl { transition: none; }
  }

  /* =================================================================
     02 · THE BIG SCOOP — Push Pin broadside (self-declared: cream paper)
     ================================================================= */
  .scoop {
    --paper: #f4e8cf;
    --ink2: #38241a;
    --red: #d94f30;
    --gold: #eda33b;
    --pink: #df7e9d;
    --leaf: #8a9a5b;
    position: relative;
    background: var(--paper);
    color: var(--ink2);
    min-height: clamp(420px, 46cqi, 720px);
    display: flex; flex-direction: column; align-items: center;
    padding: 3.2cqi 6cqi 0;
    text-align: center;
  }
  .scoop__sun { position: absolute; left: 50%; bottom: 0; width: 0; height: 0; }
  .scoop__arc {
    position: absolute; left: 0; bottom: 0;
    transform: translate(-50%, 50%);
    border-radius: 50%;
  }
  .scoop__arc--1 { width: 62cqi; height: 62cqi; background: var(--leaf); }
  .scoop__arc--2 { width: 50cqi; height: 50cqi; background: var(--pink); }
  .scoop__arc--3 { width: 38cqi; height: 38cqi; background: var(--gold); }
  .scoop__arc--4 { width: 26cqi; height: 26cqi; background: var(--red); }
  .scoop__arc--5 { width: 14cqi; height: 14cqi; background: var(--paper); }

  .scoop__ringwrap {
    position: absolute; left: 50%; bottom: 0;
    width: 21cqi; height: 21cqi;
    transform: translate(-50%, 50%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .scoop__ringwrap { animation: scoop-spin 46s linear infinite; }
  }
  @keyframes scoop-spin { to { transform: translate(-50%, 50%) rotate(360deg); } }
  .scoop__ring { width: 100%; height: 100%; overflow: visible; }
  .scoop__ring text {
    font-size: 7.6px; font-weight: 700; letter-spacing: 0.12em;
    fill: var(--paper);
    font-variation-settings: 'wght' 700, 'wdth' 100;
  }

  .scoop__mast {
    position: relative; z-index: 1;
    font-size: clamp(11px, 1.15cqi, 17px); font-weight: 600;
    letter-spacing: 0.3em; text-transform: uppercase;
    color: color-mix(in srgb, var(--ink2) 72%, var(--paper));
  }
  .scoop__title {
    position: relative; z-index: 1;
    margin: 1cqi 0 0; display: flex; flex-direction: column; align-items: center;
    color: var(--red);
    text-shadow: 0.035em 0.045em 0 var(--ink2);
  }
  .scoop__t1 {
    font-size: clamp(30px, 5.4cqi, 86px); font-weight: 700; line-height: 1;
    letter-spacing: 0.08em;
    font-variation-settings: 'wght' 700, 'wdth' 125;
  }
  .scoop__t2 {
    font-size: clamp(64px, 15.5cqi, 240px); font-weight: 700; line-height: 0.86;
    letter-spacing: -0.005em;
    font-variation-settings: 'wght' 700, 'wdth' 125;
  }
  .scoop__sub {
    position: relative; z-index: 1;
    margin: 1.4cqi 0 0;
    font-size: clamp(14px, 1.7cqi, 26px); font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink2);
  }
  .scoop__foot {
    position: relative; z-index: 1;
    margin-top: auto; width: 100%;
    display: flex; justify-content: space-between; align-items: flex-end; gap: 2cqi;
    padding-bottom: 2.2cqi;
    font-size: clamp(10px, 1.05cqi, 15px); font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink2);
  }
  .scoop__foot-mid { color: var(--paper); }

  @container (max-width: 767px) {
    .scoop { min-height: 120cqi; padding: 8cqi 7cqi 0; }
    .scoop__arc--1 { width: 130cqi; height: 130cqi; }
    .scoop__arc--2 { width: 104cqi; height: 104cqi; }
    .scoop__arc--3 { width: 78cqi;  height: 78cqi; }
    .scoop__arc--4 { width: 52cqi;  height: 52cqi; }
    .scoop__arc--5 { width: 27cqi;  height: 27cqi; }
    .scoop__ringwrap { width: 40cqi; height: 40cqi; }
    .scoop__title { margin-top: 3cqi; }
    .scoop__t1 { font-size: 11cqi; }
    .scoop__t2 { font-size: 27cqi; }
    .scoop__sub { font-size: 4cqi; margin-top: 3cqi; }
    .scoop__foot { flex-direction: column; align-items: center; gap: 1.6cqi; padding-bottom: 5cqi; font-size: 2.9cqi; }
  }

  /* =================================================================
     03 · SNACK — kids food magazine spread (self-declared: white paper)
     ================================================================= */
  .snack {
    --paper3: #fffdf6;
    --ink3: #241a0d;
    --orange3: #f5820a;
    --blue3: #2f6fb4;
    background: var(--paper3);
    color: var(--ink3);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1.15fr);
  }
  .snack__gutter {
    width: 1px; align-self: stretch;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--ink3) 22%, transparent), transparent);
    box-shadow: 0 0 18px 6px color-mix(in srgb, var(--ink3) 7%, transparent);
  }
  .snack__page { position: relative; display: flex; flex-direction: column; padding: 4cqi 4.5cqi 5.5cqi; min-width: 0; }

  .snack__head {
    font-size: clamp(13px, 1.5cqi, 22px); font-weight: 700; letter-spacing: -0.01em;
    color: var(--orange3);
  }
  .snack__head i { font-style: normal; font-weight: 500; color: color-mix(in srgb, var(--ink3) 55%, var(--paper3)); font-size: 0.78em; }
  .snack__badge {
    position: absolute; top: 3.2cqi; right: 3.6cqi;
    width: 9.5cqi; height: 9.5cqi; min-width: 74px; min-height: 74px;
    border-radius: 50%;
    background: var(--blue3); color: var(--paper3);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; gap: 0.1em;
    font-size: clamp(8px, 0.85cqi, 12px); font-weight: 500; line-height: 1.15;
    padding: 0.8cqi; transform: rotate(7deg);
  }
  .snack__badge b { font-size: 1.7em; font-weight: 700; letter-spacing: -0.01em; }

  .snack__display {
    margin: auto 0 0; cursor: pointer;
    font-size: clamp(64px, 13.5cqi, 200px); font-weight: 700; line-height: 0.9;
    letter-spacing: -0.015em; color: var(--orange3);
    font-variation-settings: 'wght' 700, 'wdth' 125;
    transform-origin: 50% 55%;
    align-self: flex-start;
    user-select: none;
  }
  .snack__display.is-flip { animation: snack-flip 0.9s cubic-bezier(.3,.7,.3,1); }
  @keyframes snack-flip {
    0% { transform: rotateX(0); }
    45% { transform: rotateX(200deg); }
    100% { transform: rotateX(360deg); }
  }
  .snack__deck {
    margin: 1.6cqi 0 0; max-width: 30ch;
    font-size: clamp(15px, 1.75cqi, 26px); font-weight: 500; line-height: 1.35;
    color: var(--ink3);
  }
  .snack__byline {
    margin: 2cqi 0 0;
    font-size: clamp(10px, 1cqi, 14px); font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: color-mix(in srgb, var(--ink3) 55%, var(--paper3));
  }
  .snack__folio {
    position: absolute; bottom: 2.2cqi; left: 4.5cqi;
    font-size: clamp(10px, 1cqi, 14px); font-weight: 600;
    color: color-mix(in srgb, var(--ink3) 50%, var(--paper3));
  }
  .snack__folio--r { left: auto; right: 4.5cqi; }

  .snack__page--recto {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: 1fr;
    gap: 3.4cqi;
    align-content: start;
  }
  .snack__col { min-width: 0; display: flex; flex-direction: column; }
  .snack__h {
    margin: 0 0 1.4cqi; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.7em;
    font-size: clamp(15px, 1.7cqi, 25px); font-weight: 700; letter-spacing: -0.01em;
    color: var(--ink3);
  }
  .snack__tag {
    font-style: normal; font-weight: 600;
    font-size: clamp(8px, 0.8cqi, 11px); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--blue3);
    border: 1.5px solid color-mix(in srgb, var(--blue3) 45%, transparent);
    border-radius: 100px; padding: 0.2em 0.8em;
  }
  .snack__list { margin: 0; padding: 0; list-style: none; }
  .snack__list li {
    font-size: clamp(13px, 1.35cqi, 19px); font-weight: 500; line-height: 1.5;
    padding: 0.55em 0; border-bottom: 1.5px dotted color-mix(in srgb, var(--ink3) 28%, transparent);
    color: var(--ink3);
  }
  .snack__frac { font-feature-settings: 'frac' 1; color: var(--orange3); font-weight: 600; }

  .snack__pull {
    margin: auto 0 0; padding: 1.8cqi 0 0;
    font-size: clamp(16px, 1.9cqi, 28px); font-weight: 600; line-height: 1.25;
    letter-spacing: -0.01em; color: var(--blue3);
  }
  .snack__pull cite {
    display: block; margin-top: 0.6em;
    font-style: normal; font-size: clamp(10px, 1cqi, 14px); font-weight: 500;
    color: color-mix(in srgb, var(--ink3) 55%, var(--paper3));
  }

  .snack__steps { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 1.6cqi; }
  .snack__steps li { display: flex; gap: 1.4cqi; align-items: flex-start; }
  .snack__num {
    flex: none;
    width: 4cqi; height: 4cqi; min-width: 34px; min-height: 34px;
    border-radius: 50%;
    background: var(--orange3); color: var(--paper3);
    display: grid; place-items: center;
    font-size: clamp(15px, 1.8cqi, 26px); font-weight: 700;
  }
  .snack__step { display: flex; flex-direction: column; gap: 0.15em; min-width: 0; }
  .snack__step b {
    font-size: clamp(13px, 1.4cqi, 20px); font-weight: 700; color: var(--ink3);
  }
  .snack__step { font-size: clamp(12px, 1.2cqi, 17px); font-weight: 500; line-height: 1.45; color: color-mix(in srgb, var(--ink3) 75%, var(--paper3)); }

  /* 768-ish: a single page, two columns under the display */
  @container (max-width: 899px) {
    .snack { grid-template-columns: 1fr; }
    .snack__gutter { display: none; }
    .snack__page { padding: 5cqi 6cqi 7cqi; }
    .snack__page--verso { padding-bottom: 2cqi; }
    .snack__display { margin-top: 4cqi; font-size: 19cqi; }
    .snack__folio { display: none; }
    .snack__page--recto { gap: 5cqi; }
    .snack__folio--r { display: block; bottom: 2.4cqi; right: 6cqi; }
    .snack__pull { margin-top: 3cqi; }
  }
  /* 390: full single column */
  @container (max-width: 559px) {
    .snack__badge { top: auto; bottom: 4cqi; right: 6cqi; }
    .snack__display { font-size: 24cqi; }
    .snack__deck { font-size: 4.4cqi; max-width: none; }
    .snack__byline { font-size: 2.8cqi; }
    .snack__page--recto { grid-template-columns: 1fr; }
    .snack__h { font-size: 4.6cqi; }
    .snack__list li { font-size: 3.8cqi; }
    .snack__pull { font-size: 5cqi; margin-top: 5cqi; }
    .snack__pull cite { font-size: 3cqi; }
    .snack__num { width: 9cqi; height: 9cqi; font-size: 4.4cqi; }
    .snack__step b { font-size: 4cqi; }
    .snack__step { font-size: 3.6cqi; }
    .snack__folio--r { position: static; margin-top: 6cqi; align-self: flex-end; }
  }

  /* =================================================================
     04 · ALEF — Hebrew lesson app (theme tokens; real device px)
     ================================================================= */
  .alef-scene {
    display: grid; place-items: center;
    padding: clamp(2rem, 5vw, 4.5rem) 1rem;
    background:
      radial-gradient(ellipse 60% 70% at 50% 40%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%),
      var(--bg-2);
  }
  .alef {
    width: 354px; max-width: 100%;
    min-height: 660px;
    display: flex; flex-direction: column;
    background: var(--bg);
    color: var(--fg);
    border-radius: 40px;
    border: 1px solid var(--line);
    box-shadow: 0 30px 70px -30px color-mix(in srgb, var(--fg) 45%, transparent),
                0 0 0 9px color-mix(in srgb, var(--fg) 7%, transparent);
    padding: 10px 18px 16px;
    font-size: 13px;
  }
  .alef__statusbar {
    position: relative;
    display: flex; align-items: center; justify-content: space-between;
    padding: 2px 8px 6px;
    font-size: 12px; font-weight: 600;
    color: var(--fg-2);
  }
  .alef__notch {
    position: absolute; left: 50%; top: 0; transform: translateX(-50%);
    width: 76px; height: 17px; border-radius: 100px;
    background: color-mix(in srgb, var(--fg) 88%, transparent);
  }
  .alef__batt { width: 21px; height: 10px; }

  .alef__top { display: flex; align-items: center; gap: 12px; padding: 8px 0 2px; }
  .alef__back {
    flex: none; width: 30px; height: 30px;
    border: none; border-radius: 50%;
    background: color-mix(in srgb, var(--fg) 7%, transparent);
    color: var(--fg-2); cursor: pointer;
    display: grid; place-items: center;
  }
  .alef__back svg { width: 14px; height: 14px; }
  .alef__progress { flex: 1; display: flex; gap: 5px; }
  .alef__progress i {
    flex: 1; height: 8px; border-radius: 100px;
    background: color-mix(in srgb, var(--fg) 10%, transparent);
    overflow: hidden; position: relative;
  }
  .alef__progress i::after {
    content: ''; position: absolute; inset: 0;
    background: var(--accent); border-radius: 100px;
    transform: scaleX(0); transform-origin: left center;
    transition: transform 0.45s var(--ease-out, ease-out);
  }
  .alef__progress i.is-full::after { transform: scaleX(1); }
  .alef__streak {
    flex: none; display: inline-flex; align-items: center; gap: 4px;
    font-size: 13px; font-weight: 700; color: var(--accent);
  }
  .alef__streak svg { width: 14px; height: 14px; }
  .alef__unit {
    display: block; margin-top: 14px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--fg-3);
  }

  .alef__panels { flex: 1; display: grid; margin-top: 6px; min-height: 0; }
  .alef__q { grid-area: 1 / 1; display: none; flex-direction: column; }
  .alef__q.is-active { display: flex; }
  .alef__prompt { margin: 6px 0 14px; font-size: 19px; font-weight: 600; line-height: 1.3; color: var(--fg); letter-spacing: -0.01em; }
  .alef__prompt em { font-style: normal; font-weight: 700; color: var(--accent); }
  .alef__opts { display: flex; flex-direction: column; gap: 10px; }
  .alef__opt {
    display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
    padding: 13px 16px;
    background: var(--bg);
    border: 2px solid var(--line);
    border-bottom-width: 4px;
    border-radius: 16px;
    cursor: pointer; text-align: left;
    color: var(--fg);
    transition: border-color 0.15s, background 0.15s, transform 0.15s;
  }
  .alef__opt:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--line)); }
  .alef__opt:active { transform: translateY(1px); border-bottom-width: 2px; margin-bottom: 2px; }
  .alef__he { font-size: 21px; font-weight: 600; line-height: 1.2; }
  .alef__tr { font-size: 12px; font-weight: 500; color: var(--fg-3); letter-spacing: 0.03em; }
  .alef__opt.is-right {
    border-color: #3da356;
    background: color-mix(in srgb, #3da356 12%, var(--bg));
  }
  .alef__opt.is-right .alef__tr { color: #2c7a40; font-weight: 700; }
  .alef__opt.is-wrong {
    border-color: #cf4631;
    background: color-mix(in srgb, #cf4631 10%, var(--bg));
  }
  @media (prefers-reduced-motion: no-preference) {
    .alef__opt.is-wrong { animation: alef-shake 0.4s var(--ease, ease); }
  }
  @keyframes alef-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    55% { transform: translateX(4px); }
    80% { transform: translateX(-2px); }
  }
  .alef__q.is-solved .alef__opt:not(.is-right) { opacity: 0.45; }

  .alef__q--done { align-items: center; justify-content: center; text-align: center; gap: 8px; }
  .alef__bigdone { font-size: 40px; font-weight: 700; color: var(--accent); letter-spacing: -0.01em; }
  .alef__donesub { font-size: 14px; font-weight: 500; color: var(--fg-2); }
  .alef__xp {
    margin-top: 8px; font-size: 12px; font-weight: 700; letter-spacing: 0.06em;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-radius: 100px; padding: 6px 14px;
  }
  .alef__again {
    margin-top: 18px; padding: 11px 22px;
    background: var(--accent); color: var(--accent-contrast);
    border: none; border-radius: 14px;
    font-size: 14px; font-weight: 700; cursor: pointer;
  }
  .alef__foot { padding-top: 14px; }
  .alef__cta {
    width: 100%; padding: 13px;
    background: var(--accent); color: var(--accent-contrast);
    border: none; border-radius: 16px;
    font-size: 15px; font-weight: 700; letter-spacing: 0.01em;
    cursor: pointer;
    transition: opacity 0.2s, filter 0.15s;
  }
  .alef__cta:hover:not(:disabled) { filter: brightness(1.07); }
  .alef__cta:disabled { opacity: 0.35; cursor: default; }
  .alef.is-done .alef__cta { visibility: hidden; }

  @media (prefers-reduced-motion: reduce) {
    .alef__progress i::after, .alef__opt, .alef__cta { transition: none; }
  }

  /* =================================================================
     05 · BALLOON — pointer-pumped variable type (self-declared: night)
     ================================================================= */
  .balloon {
    --night: #19102d;
    --air: #ffeccd;
    --pump: #ff8a1e;
    background:
      radial-gradient(ellipse 70% 90% at 50% 110%, color-mix(in srgb, var(--pump) 16%, transparent), transparent 70%),
      var(--night);
    color: var(--air);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    min-height: clamp(380px, 42cqi, 660px);
    padding: 5cqi 4cqi;
    touch-action: manipulation;
  }
  .balloon__eyebrow {
    font-size: clamp(10px, 1cqi, 15px); font-weight: 600;
    letter-spacing: 0.24em; text-transform: uppercase;
    color: color-mix(in srgb, var(--air) 55%, var(--night));
    text-align: center;
  }
  .balloon__word {
    display: flex; flex-wrap: wrap; justify-content: center;
    margin-top: 2cqi;
  }
  .balloon__l {
    appearance: none; background: none; border: none; padding: 0; margin: 0;
    width: 12.4cqi;
    display: grid; place-items: center;
    font-size: 13cqi; line-height: 1.1;
    color: var(--air); cursor: pointer;
    font-variation-settings: 'wght' 300, 'wdth' 75;
    will-change: transform;
  }
  .balloon__l:nth-child(odd):hover .balloon__g,
  .balloon__l:focus-visible .balloon__g { color: var(--pump); }
  .balloon__g { display: block; transition: color 0.25s; }
  .balloon__g.is-pop { animation: balloon-pop 0.5s cubic-bezier(.3,1.8,.4,1); }
  @keyframes balloon-pop {
    0% { transform: scale(1, 1); }
    30% { transform: scale(1.22, 0.82); }
    55% { transform: scale(0.88, 1.16); }
    100% { transform: scale(1, 1); }
  }
  .balloon__readout {
