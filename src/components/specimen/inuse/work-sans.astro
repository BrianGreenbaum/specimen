---
import type { CollectionEntry } from 'astro:content';
export interface Props { font: CollectionEntry<'fonts'>['data']; }
const { font } = Astro.props;
const fam = font.fontFamily;

// ── The sequence ─────────────────────────────────────────────────────────────
// WORK SANS IS THE QUIET PROFESSIONAL — Hamilton wood-type gothics, restored
// for the interface. Five acts trace one civic institution: the exhibition
// wall type (01, bleeding) → the annual-report spread (02) → the wood-type
// poster that started the lineage (03) → the city's open-data portal in
// real px (04, sortable table) → a weight-axis specimen bench (05).
//
// Honesty ledger (verified via fontTools against wght binaries):
// · VARIABLE: wght 100–900; true italic same range. No other axes.
// · GSUB includes cswh (contextual swashes) — shown only as a toggle demo.

const stats = [
  { n: '1889', l: 'founded as a print works' },
  { n: '46', l: 'exhibitions this decade' },
  { n: '2.1M', l: 'archive records online' },
];
const sortRows = [
  { name: 'Rivers & Bridges', cat: 'Infrastructure', year: '1897' },
  { name: 'The Print Works', cat: 'Industry', year: '1889' },
  { name: 'Common Ground', cat: 'Parks', year: '1904' },
  { name: 'Night Shift', cat: 'Labour', year: '1921' },
];
---
<div class="iu ws" style={`--fam:${fam}`}>

  <!-- ════════ 01 · BRANDING — the exhibition wall ════════ -->
  <figure class="iu__item iu__item--bleed">
    <figcaption class="iu__cap"><span class="index-num">01</span><span class="label">Branding — museum exhibition identity</span></figcaption>
    <div class="iu__scene wl">
      <div class="wl__wall">
        <span class="wl__kicker">The City Archive presents</span>
        <h3 class="wl__title">Ink&nbsp;&amp;&nbsp;Industry</h3>
        <p class="wl__sub">One hundred years of work, printed on demand.</p>
        <div class="wl__stats">
          {stats.map((s) => (
            <div class="wl__stat"><span class="wl__n">{s.n}</span><span class="wl__l">{s.l}</span></div>
          ))}
        </div>
      </div>
    </div>
    <p class="iu__hint label">Civic graphics live and die by neutrality that still has a spine — the wood-gothic spur at display size is the whole personality budget.</p>
  </figure>

  <!-- ════════ 02 · EDITORIAL — the annual report spread ════════ -->
  <figure class="iu__item">
    <figcaption class="iu__cap"><span class="index-num">02</span><span class="label">Editorial — annual report, the director’s letter</span></figcaption>
    <div class="iu__scene ar">
      <div class="ar__page">
        <header class="ar__head">
          <span class="ar__doc">Annual Report · FY25</span>
          <i aria-hidden="true"></i>
          <span class="ar__org">City Archive</span>
        </header>
        <h4 class="ar__lede">A quiet year for loud times.</h4>
        <p class="ar__p">Institutions are judged by what they keep. This year we kept more than ever — 214,000 negatives digitised, 38 oral histories recorded, and the reading room open every Saturday without exception.</p>
        <p class="ar__p">We also said goodbye to our oldest press, retired with honours to the workshop floor, where it now prints letterpress keepsakes for members. Its last commercial run, fittingly, was this report’s cover stock.</p>
        <p class="ar__sig"><em>E. Marsh, Director</em></p>
      </div>
    </div>
  </figure>

  <!-- ════════ 03 · ILLUSTRATION — the ancestor poster ════════ -->
  <figure class="iu__item">
    <figcaption class="iu__cap"><span class="index-num">03</span><span class="label">Illustration — the wood-type ancestor, reprinted</span></figcaption>
    <div class="iu__scene wp">
      <div class="wp__poster">
        <span class="wp__top">Hamilton &amp; Sons · Two Rivers, Wis.</span>
        <span class="wp__big">GRAND</span>
        <span class="wp__mid">CONCERT&nbsp;HALL</span>
        <span class="wp__line">SATURDAY EVENING · APRIL NINETEENTH · EIGHT O’CLOCK</span>
        <span class="wp__bottom">ADMISSION TWENTY-FIVE CENTS · CHILDREN TEN</span>
      </div>
    </div>
    <p class="iu__hint label">The genre Work Sans descends from: condensed gothics cut in wood, printed fast, read from across the street.</p>
  </figure>

  <!-- ════════ 04 · WEB UI — the open-data portal, real px ════════ -->
  <figure class="iu__item">
    <figcaption class="iu__cap"><span class="index-num">04</span><span class="label">Web UI — the archive’s public search, sortable</span></figcaption>
    <div class="iu__scene od">
      <div class="od__app">
        <header class="od__bar">
          <span class="od__brand">archive.city/collections</span>
          <span class="od__count">4 of 2,114,808 records</span>
        </header>
        <table class="od__table">
          <thead>
            <tr>
              <th><button class="od__sort" data-ws-sort="name" aria-label="Sort by title">Title ↕</button></th>
              <th><button class="od__sort" data-ws-sort="cat" aria-label="Sort by category">Collection ↕</button></th>
              <th><button class="od__sort" data-ws-sort="year" aria-label="Sort by year">Year ↕</button></th>
            </tr>
          </thead>
          <tbody data-ws-body>
            {sortRows.map((r) => (
              <tr data-name={r.name} data-cat={r.cat} data-year={r.year}>
                <td>{r.name}</td><td>{r.cat}</td><td class="od__yr">{r.year}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <footer class="od__foot">Open data · CC0 · bulk download available</footer>
      </div>
    </div>
  </figure>

  <!-- ════════ 05 · INTERACTIVE — the weight bench ════════ -->
  <figure class="iu__item">
    <figcaption class="iu__cap"><span class="index-num">05</span><span class="label">Interactive — one axis, nine jobs</span></figcaption>
    <div class="iu__scene wb">
      <label class="wb__ctl" for="ws-wght">weight <output data-ws-out>400</output></label>
      <input id="ws-wght" class="wb__range" type="range" min="100" max="900" step="1" value="400" data-ws-range />
      <div class="wb__rows">
        <p class="wb__row" style="font-variation-settings:'wght' 400"><span class="wb__tag">caption</span>Reading room opens at ten.</p>
        <p class="wb__row" style="font-variation-settings:'wght' 500"><span class="wb__tag">body</span>The negative is clean; the sleeve is not.</p>
        <p class="wb__row" style="font-variation-settings:'wght' 700"><span class="wb__tag">heading</span>New in the print works.</p>
        <p class="wb__row" style="font-variation-settings:'wght' 900"><span class="wb__tag">display</span>INK &amp; INDUSTRY</p>
      </div>
    </div>
  </figure>

</div>

<script>
  // 04 — sortable columns
  document.querySelectorAll<HTMLElement>('.ws .od').forEach((root) => {
    const body = root.querySelector<HTMLElement>('[data-ws-body]')!;
    let dir = 1; let key = '';
    root.querySelectorAll<HTMLButtonElement>('[data-ws-sort]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const k = btn.dataset.wsSort!;
        dir = k === key ? -dir : 1;
        key = k;
        const rows = Array.from(body.querySelectorAll('tr'));
        rows.sort((a, b) => {
          const av = a.dataset[k as 'name' | 'cat' | 'year']!;
          const bv = b.dataset[k as 'name' | 'cat' | 'year']!;
          return k === 'year' ? (+av - +bv) * dir : av.localeCompare(bv) * dir;
        });
        rows.forEach((r) => body.appendChild(r));
      })
    );
  });

  // 05 — weight slider drives all rows
  document.querySelectorAll<HTMLElement>('.ws .wb').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('[data-ws-range]');
    const out = root.querySelector<HTMLElement>('[data-ws-out]');
    range?.addEventListener('input', () => {
      if (out) out.textContent = range.value;
      // each row keeps its role offset from the master value
      const offsets = [0, 100, 300, 500];
      root.querySelectorAll<HTMLElement>('.wb__row').forEach((r, i) => {
        const v = Math.min(900, Math.max(100, +range.value + offsets[i]));
        r.style.fontVariationSettings = `'wght' ${v}`;
      });
    });
  });
</script>

<style>
  .ws .iu__scene * { font-family: var(--fam); }

  /* ── 01 wall ── */
  .wl { background: #1c1d1f; color: #f5f4f2; padding: clamp(3rem, 12cqi, 8rem) clamp(1.5rem, 6cqi, 4rem); }
  .wl__wall { max-width: 56rem; margin-inline: auto; }
  .wl__kicker { font-size: clamp(0.72rem, 1.8cqi, 0.85rem); letter-spacing: 0.18em; text-transform: uppercase; color: #7a7d83; }
  .wl__title {
    font-weight: 800; font-size: clamp(4rem, 17cqi, 11rem);
    line-height: 0.92; letter-spacing: -0.025em;
    background: linear-gradient(90deg, #f5f4f2 60%, #2456a6 60.2%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .wl__sub { color: #b9bcc1; font-size: clamp(1rem, 2.8cqi, 1.35rem); margin-top: 1rem; }
  .wl__stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr)); gap: 1.5rem; margin-top: clamp(2rem, 6cqi, 3.5rem); border-top: 1px solid #f5f4f22e; padding-top: 1.5rem; }
  .wl__n { display: block; font-weight: 700; font-size: clamp(1.8rem, 5.4cqi, 3rem); font-feature-settings: 'tnum'; }
  .wl__l { color: #7a7d83; font-size: clamp(0.78rem, 1.9cqi, 0.9rem); }

  /* ── 02 annual report ── */
  .ar { background: var(--bg); padding: clamp(1.5rem, 5cqi, 3.5rem); }
  .ar__page { max-width: 40rem; margin-inline: auto; }
  .ar__head { display: flex; align-items: baseline; gap: 1rem; border-bottom: 2px solid var(--fg); padding-bottom: 0.7rem; margin-bottom: 1.4rem; }
  .ar__head i { flex: 1; }
  .ar__doc { font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: #2456a6; }
  .ar__org { font-weight: 600; }
  .ar__lede { font-weight: 700; font-size: clamp(1.7rem, 5.4cqi, 2.6rem); line-height: 1.1; letter-spacing: -0.01em; margin-bottom: 1rem; }
  .ar__p { line-height: 1.65; color: var(--fg-2); margin-bottom: 0.9em; max-width: 62ch; }
  .ar__sig { margin-top: 1.2rem; color: var(--fg-3); }

  /* ── 03 wood poster ── */
  .wp { background: #efe9db; color: #241d16; display: grid; place-items: center; padding: clamp(2rem, 8cqi, 5rem); }
  .wp__poster {
    width: min(100%, 30rem); text-align: center;
    border: 4px solid #241d16; padding: clamp(1.4rem, 5cqi, 2.6rem) clamp(1rem, 3.5cqi, 2rem);
    display: flex; flex-direction: column; gap: 0.6rem;
    box-shadow: 14px 14px 0 #241d1622;
    filter: contrast(1.02);
  }
  .wp__top, .wp__bottom { font-size: clamp(0.62rem, 1.8cqi, 0.75rem); letter-spacing: 0.14em; text-transform: uppercase; color: #57493c; }
  .wp__big { font-weight: 900; font-size: clamp(3.4rem, 15cqi, 7rem); line-height: 0.9; letter-spacing: 0.01em; }
  .wp__mid { font-weight: 600; font-size: clamp(1.5rem, 6cqi, 2.8rem); letter-spacing: 0.06em; }
  .wp__line { border-top: 2px solid #241d16; border-bottom: 2px solid #241d16; padding-block: 0.45em; font-size: clamp(0.8rem, 2.6cqi, 1.05rem); letter-spacing: 0.08em; }

  /* ── 04 data portal (real px) ── */
  .od { display: grid; place-items: start center; background: var(--bg); }
  .od__app { width: min(100%, 36rem); border: 1px solid var(--line); background: var(--bg); color: var(--fg); }
  .od__bar { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 10px 14px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--fg) 4%, var(--bg)); }
  .od__brand { font-family: var(--font-mono), monospace; font-size: 12px; }
  .od__count { font-size: 11px; color: var(--fg-3); font-feature-settings: 'tnum'; }
  .od__table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
  .od__table th { text-align: left; padding: 0 14px; border-bottom: 1px solid var(--line); }
  .od__sort { font-family: var(--font-ui); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--fg-3); padding-block: 9px; }
  .od__sort:hover { color: var(--accent); }
  .od__table td { padding: 10px 14px; border-bottom: 1px solid var(--line-soft); }
  .od__yr { font-feature-settings: 'tnum'; color: var(--fg-2); }
  .od__foot { padding: 9px 14px; font-size: 11px; color: var(--fg-3); }

  /* ── 05 weight bench ── */
  .wb { background: var(--bg-2); padding: clamp(1.5rem, 6cqi, 4rem); }
  .wb__inner { max-width: 34rem; margin-inline: auto; }
  .wb__ctl { display: flex; justify-content: space-between; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent); }
  .wb__range { width: min(34rem, 100%); accent-color: var(--accent); cursor: ew-resize; margin-block: 0.6rem 1.6rem; display: block; margin-inline: auto; }
  .wb__rows { max-width: 34rem; margin-inline: auto; display: flex; flex-direction: column; gap: 1rem; transition-duration: 0s; }
  .wb__row { transition: font-variation-settings 0.1s linear; display: flex; flex-direction: column; }
  .wb__tag { font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); margin-bottom: 0.15rem; }
  .wb__row:nth-child(1) { --w: 400; font-size: 0.95rem; }
  .wb__row:nth-child(2) { --w: 500; font-size: 1.25rem; line-height: 1.5; }
  .wb__row:nth-child(3) { --w: 700; font-size: 1.8rem; }
  .wb__row:nth-child(4) { --w: 900; font-size: clamp(2.4rem, 7cqi, 3.6rem); letter-spacing: -0.01em; }
</style>
