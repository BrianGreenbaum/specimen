---
// CLIMATE CRISIS — a showpiece specimen, built by hand outside the collection
// template. The letters are the ice, the page is the sea, and scroll is time.
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { inkByAxis } from '../../lib/ink';

const Y0 = 1979;
const Y1 = 2050;
const LAST_MEASURED = 2019; // the designers' data ends here; later years follow a projection

// How much of each letter is left, measured from the real outlines at build time.
const ink = await inkByAxis({
  pkg: '@fontsource-variable/climate-crisis',
  file: 'climate-crisis-latin-year-normal.woff2',
  axis: 'YEAR', min: Y0, max: Y1,
  sample: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
});
const years = ink.map((v, i) => ({ year: Y0 + i, ink: v, pct: Math.round(v * 100) }));

// One sentence, exactly 72 letters: each letter is set one year later than the last.
const SENTENCE = 'Every letter in this sentence is one year older and a little thinner than the one before';
let n = 0;
const words = SENTENCE.toUpperCase().split(' ').map((w) => [...w].map((ch) => ({ ch, ...years[Math.min(n++, years.length - 1)] })));
if (n !== years.length) throw new Error(`Sentence must have ${years.length} letters, has ${n}`);

const frontPages = [
  { year: 1979, date: 'September 1979', ed: 'Morning edition', note: 'The satellite record begins' },
  { year: 2012, date: 'September 2012', ed: 'Morning edition', note: 'Lowest minimum yet measured' },
  { year: 2050, date: 'September 2050', ed: 'Forecast edition', note: 'Not yet written' },
];
const HEADLINE = ['Arctic ice', 'at summer', 'low'];

const themeStyle = [
  '--bg:#04141f', '--bg-2:#0a2231', '--fg:#eaf6fb', '--fg-2:#a9c6d4', '--fg-3:#7397a8',
  '--accent:#8fd8f0', '--accent-contrast:#04141f', '--line:#eaf6fb26', '--line-soft:#eaf6fb12',
  'color-scheme:dark',
].join(';');
---
<Layout
  title="Climate Crisis — Specimen"
  description="Climate Crisis, a variable font whose single axis is a year: the letters melt from 1979 to 2050 as Arctic sea ice does."
  themeStyle={themeStyle}
  mode="dark"
  fixedTheme
>
  <SiteHeader current="Climate Crisis" showToggle={false} />

  <div class="cc-page" data-cc data-ink={JSON.stringify(years.map((y) => y.pct))}>

    <!-- ============ SCROLL = TIME ============ -->
    <header class="cc-scrolly" data-cc-scrolly>
      <div class="cc-stage" data-cc-stage>
        <div class="cc-stage__top">
          <p>Climate Crisis <span>— a typeface by Helsingin Sanomat, 2020</span></p>
          <p class="cc-stage__cue" data-cc-cue>Scroll to move through time <i aria-hidden="true">↓</i></p>
        </div>

        <h1 class="cc-title cc" aria-label="Climate Crisis">
          <span aria-hidden="true">CLIMATE</span>
          <span aria-hidden="true">CRISIS</span>
        </h1>

        <div class="cc-stage__band">
          <p class="cc-year cc" data-cc-yearnum aria-live="off">1979</p>
          <div class="cc-captions">
            <p data-cap data-from="1979" data-to="1986" class="is-on"><b>1979.</b> Satellites begin keeping a continuous record of Arctic sea ice. The typeface starts here, at its heaviest.</p>
            <p data-cap data-from="1987" data-to="1999">The axis has one stop for every year since. The measurements behind it come from the US National Snow and Ice Data Center.</p>
            <p data-cap data-from="2000" data-to="2011">The decline isn’t smooth. Some years the ice recovers a little, and the letters with it. The direction holds.</p>
            <p data-cap data-from="2012" data-to="2018"><b>2012.</b> The lowest September extent in the satellite record — roughly half of what was there in 1979.</p>
            <p data-cap data-from="2019" data-to="2024" data-cap-measured><b>2019.</b> The measurements the designers had end here. Everything after this line is the IPCC’s projection.</p>
            <p data-cap data-from="2025" data-to="2031" data-cap-now><b><span data-cc-now>2026</span>.</b> You are here. The letters past this point haven’t happened yet.</p>
            <p data-cap data-from="2032" data-to="2049">The counters fill with water. Stems thin to threads. Words stop holding together.</p>
            <p data-cap data-from="2050" data-to="2050"><b>2050.</b> By its makers’ account, the lightest cut stands for a September minimum 30% the size of 1979’s.</p>
          </div>
          <dl class="cc-ink">
            <dt>Ink remaining</dt>
            <dd><span data-cc-ink>100</span><small>%</small></dd>
          </dl>
        </div>

        <div class="cc-rule" aria-hidden="true">
          <div class="cc-rule__bars">
            {years.map((y) => (
              <i data-bar={y.year} class:list={[y.year > LAST_MEASURED && 'is-proj']} style={`--v:${y.ink.toFixed(3)}`}></i>
            ))}
            <span class="cc-rule__now" data-cc-nowmark><em>now</em></span>
          </div>
          <div class="cc-rule__labels">
            <span style="--at:0">1979</span>
            <span style={`--at:${(1990 - Y0) / (Y1 - Y0)}`}>1990</span>
            <span style={`--at:${(2000 - Y0) / (Y1 - Y0)}`}>2000</span>
            <span style={`--at:${(2010 - Y0) / (Y1 - Y0)}`}>2010</span>
            <span style={`--at:${(2019 - Y0) / (Y1 - Y0)}`} class="cc-rule__split">2019 · data ends</span>
            <span style={`--at:${(2040 - Y0) / (Y1 - Y0)}`}>2040</span>
            <span style="--at:1">2050</span>
          </div>
        </div>
      </div>
    </header>

    <main class="cc-main">
      <!-- ============ 72 LETTERS ============ -->
      <section class="cc-sec cc-core" data-cc-core>
        <div class="cc-kicker"><span>01</span> One axis</div>
        <h2 class="cc-h2">No bold, no italic, no width.<br />The only setting is <em>when</em>.</h2>
        <p class="cc-lede">
          Most variable fonts let you choose a weight. This one asks for a year between 1979 and 2050 and works the
          weight out itself. Read the next sentence slowly — it ages as you go.
        </p>

        <p class="cc-sentence" aria-label={SENTENCE}>
          {words.map((w) => (
            <span class="cc-sentence__w" aria-hidden="true">
              {w.map((l) => (
                <span class="cc cc-sentence__l" data-y={l.year} data-p={l.pct} style={`--year:${l.year}`}>{l.ch}</span>
              ))}
            </span>
          ))}
        </p>

        <div class="cc-chart">
          <div class="cc-chart__head">
            <p class="cc-chart__read" data-core-read>
              <b>72 letters, 72 years.</b> <span>Point at any letter or bar.</span>
            </p>
            <p class="cc-chart__key"><i></i> drawn from measurements <i class="is-proj"></i> drawn from the projection</p>
          </div>
          <div class="cc-chart__bars" role="img" aria-label={`Ink remaining in the letterforms by year, falling from 100% in 1979 to ${years[years.length - 1].pct}% in 2050`}>
            {years.map((y) => (
              <i data-y={y.year} data-p={y.pct} class:list={[y.year > LAST_MEASURED && 'is-proj']} style={`--v:${y.ink.toFixed(3)}`}></i>
            ))}
          </div>
          <div class="cc-chart__axis"><span>1979 · 100%</span><span>ink left in the alphabet, measured from the font’s own outlines</span><span>2050 · {years[years.length - 1].pct}%</span></div>
        </div>
      </section>

      <!-- ============ FRONT PAGES ============ -->
      <section class="cc-sec cc-press">
        <div class="cc-kicker"><span>02</span> In use</div>
        <h2 class="cc-h2">It was made by a newspaper,<br />to be a headline.</h2>
        <p class="cc-lede">Three front pages, the same six words. Only the year on the masthead changes — the type does the reporting.</p>

        <div class="cc-pages">
          {frontPages.map((p, i) => (
            <article class="cc-paper" style={`--year:${p.year};--i:${i}`} data-reveal>
              <header class="cc-paper__mast">
                <span>{p.ed}</span>
                <b>The Northern Record</b>
                <span>{p.date}</span>
              </header>
              <h3 class="cc cc-paper__head">{HEADLINE.map((l) => <span>{l}</span>)}</h3>
              <div class="cc-paper__body" aria-hidden="true">
                <div class="cc-paper__col"><i></i><i></i><i></i><i></i><i></i><i style="width:62%"></i></div>
                <div class="cc-paper__col"><i></i><i></i><i></i><i></i><i></i><i style="width:38%"></i></div>
              </div>
              <footer class="cc-paper__foot"><span class="cc">{p.year}</span><span>{p.note}</span></footer>
            </article>
          ))}
        </div>
        <p class="cc-cap">A fictional paper, for demonstration. The original lives at Helsingin Sanomat, Finland’s largest daily.</p>
      </section>

      <!-- ============ TESTER ============ -->
      <section class="cc-sec cc-test" data-cc-test>
        <div class="cc-kicker"><span>03</span> Your turn</div>
        <h2 class="cc-h2">Say something.<br />Then pick the year you say it in.</h2>

        <div class="cc-test__stage">
          <div class="cc cc-test__text" contenteditable="plaintext-only" spellcheck="false" role="textbox" aria-label="Sample text — editable" data-test-text>Still here</div>
        </div>

        <div class="cc-test__ctl">
          <button type="button" class="cc-play" data-test-play aria-pressed="false"><i aria-hidden="true"></i><span>Play 1979 → 2050</span></button>
          <label class="cc-slider">
            <span>Year <b data-test-yv>1979</b></span>
            <input type="range" min={Y0} max={Y1} step="1" value="1979" data-test-y />
          </label>
          <div class="cc-chips">
            <button type="button" data-test-set="1979">1979</button>
            <button type="button" data-test-set="now">This year</button>
            <button type="button" data-test-set="2050">2050</button>
          </div>
        </div>
      </section>

      <!-- ============ STORY + SPECS ============ -->
      <section class="cc-sec cc-story">
        <div class="cc-kicker"><span>04</span> The story</div>
        <div class="cc-story__grid">
          <div class="cc-story__prose">
            <p class="cc-story__lede">
              In 2020 the Finnish newspaper <strong>Helsingin Sanomat</strong> wanted a way to make climate change
              visible in the one material a newspaper always has to hand: its own headlines. Working with type
              designers <strong>Daniel Coull</strong> and <strong>Eino Korkala</strong>, it commissioned a typeface
              whose weight is not a style choice but a reading.
            </p>
            <p>
              The heaviest cut stands for the extent of Arctic sea ice at its late-summer minimum in 1979, the first
              full year of satellite observation. From there the axis follows the record kept by the US National Snow
              and Ice Data Center, year by year, to 2019 — then carries on along the Intergovernmental Panel on
              Climate Change’s projection to 2050. The letters don’t simply get lighter. They warp, thin and come
              apart, until a word is a scatter of fragments on open water.
            </p>
            <p>
              The paper released it free, under an open licence, and it now sits in Google Fonts next to the
              workhorses. It may be the only face in the library where choosing a setting is also making a statement
              about a date.
            </p>
          </div>

          <dl class="cc-specs">
            <div><dt>Design</dt><dd>Daniel Coull &amp; Eino Korkala</dd></div>
            <div><dt>Commissioned by</dt><dd>Helsingin Sanomat</dd></div>
            <div><dt>Released</dt><dd>2020</dd></div>
            <div><dt>Format</dt><dd>Variable font, one custom axis</dd></div>
            <div><dt>Axis</dt><dd><code>YEAR</code> 1979–2050 (default 1979)</dd></div>
            <div><dt>Data</dt><dd>NSIDC satellite record to 2019; IPCC projection beyond</dd></div>
            <div><dt>Scripts</dt><dd>Latin, Latin Extended, Cyrillic</dd></div>
            <div><dt>Ink at 2050</dt><dd>{years[years.length - 1].pct}% of the 1979 outline area <small>(our measurement)</small></dd></div>
            <div><dt>Licence</dt><dd>SIL Open Font License 1.1</dd></div>
            <div class="cc-specs__links">
              <a href="https://fonts.google.com/specimen/Climate+Crisis" rel="noopener">Get it on Google Fonts ↗</a>
              <a href="https://github.com/dancoull/ClimateCrisis" rel="noopener">Source ↗</a>
            </div>
          </dl>
        </div>
      </section>

      <!-- ============ CLOSING ============ -->
      <section class="cc-end" data-cc-end>
        <p class="cc cc-end__big" aria-label="The axis runs both ways."><span aria-hidden="true">THE AXIS</span><span aria-hidden="true">RUNS BOTH</span><span aria-hidden="true">WAYS.</span></p>
        <p class="cc-end__small">The ice doesn’t.</p>
      </section>

      <a class="cc-next" href="/fonts/nabla">
        <span class="cc-next__k">Next showpiece →</span>
        <span class="cc-next__name" aria-label="Nabla">{[...'NABLA'].map((c, i) => <span style={`--i:${i}`} aria-hidden="true">{c}</span>)}</span>
        <span class="cc-next__sub">A colour font with a third dimension.</span>
      </a>
    </main>
  </div>

  <SiteFooter />
</Layout>

<script>
  const page = document.querySelector<HTMLElement>('[data-cc]');
  if (page) {
    const Y0 = 1979, Y1 = 2050;
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    const inkPct: number[] = JSON.parse(page.dataset.ink!);
    const inkAt = (y: number) => {
      const f = clamp(y - Y0, 0, Y1 - Y0), i = Math.floor(f), j = Math.min(i + 1, inkPct.length - 1);
      return inkPct[i] + (inkPct[j] - inkPct[i]) * (f - i);
    };
    const nowYear = clamp(new Date().getFullYear(), 2020, 2045);

    // ---------- "You are here": place the present on the timeline + in the captions ----------
    page.querySelectorAll('[data-cc-now]').forEach((el) => (el.textContent = String(nowYear)));
    const capNow = page.querySelector<HTMLElement>('[data-cap-now]')!;
    const capMeasured = page.querySelector<HTMLElement>('[data-cap-measured]')!;
    capMeasured.dataset.to = String(nowYear - 1);
    capNow.dataset.from = String(nowYear);
    capNow.dataset.to = String(Math.max(nowYear + 4, 2031));
    const afterNow = capNow.nextElementSibling as HTMLElement;
    afterNow.dataset.from = String(+capNow.dataset.to + 1);
    page.querySelector<HTMLElement>('[data-cc-nowmark]')!.style.setProperty('--at', String((nowYear - Y0) / (Y1 - Y0)));

    // ---------- Scroll drives the year ----------
    const scrolly = page.querySelector<HTMLElement>('[data-cc-scrolly]')!;
    const stage = page.querySelector<HTMLElement>('[data-cc-stage]')!;
    const yearNum = page.querySelector<HTMLElement>('[data-cc-yearnum]')!;
    const inkOut = page.querySelector<HTMLElement>('[data-cc-ink]')!;
    const caps = Array.from(page.querySelectorAll<HTMLElement>('[data-cap]'));
    const bars = Array.from(stage.querySelectorAll<HTMLElement>('[data-bar]'));
    const cue = page.querySelector<HTMLElement>('[data-cc-cue]')!;
    let cur = Y0, shown = -1, visible = true;
    new IntersectionObserver((es) => { visible = es[0].isIntersecting; }, { rootMargin: '200px' }).observe(scrolly);

    const target = () => {
      const r = scrolly.getBoundingClientRect();
      const span = r.height - stage.offsetHeight;
      const top = parseFloat(getComputedStyle(stage).top) || 0;
      return Y0 + (Y1 - Y0) * clamp((top - r.top) / Math.max(span, 1), 0, 1);
    };
    const paint = () => {
      const t = (cur - Y0) / (Y1 - Y0);
      stage.style.setProperty('--year', cur.toFixed(2));
      stage.style.setProperty('--t', t.toFixed(4));
      const y = Math.round(cur);
      if (y === shown) return;
      shown = y;
      yearNum.textContent = String(y);
      inkOut.textContent = String(Math.round(inkAt(cur)));
      caps.forEach((c) => c.classList.toggle('is-on', y >= +c.dataset.from! && y <= +c.dataset.to!));
      bars.forEach((b) => b.classList.toggle('is-past', +b.dataset.bar! <= y));
      cue.classList.toggle('is-off', y > Y0 + 1);
    };
    const loop = () => {
      requestAnimationFrame(loop);
      if (!visible) return;
      const tg = target();
      if (Math.abs(tg - cur) < 0.005) { if (cur !== tg) { cur = tg; paint(); } return; }
      cur += (tg - cur) * 0.16;
      paint();
    };
    cur = target();
    paint();
    requestAnimationFrame(loop);

    // ---------- The 72-letter sentence and its chart light each other up ----------
    const core = page.querySelector<HTMLElement>('[data-cc-core]')!;
    const read = core.querySelector<HTMLElement>('[data-core-read]')!;
    const idle = read.innerHTML;
    const pick = (y: string | null) => {
      core.querySelectorAll('.is-hot').forEach((el) => el.classList.remove('is-hot'));
      if (!y) { read.innerHTML = idle; return; }
      const hits = core.querySelectorAll<HTMLElement>(`[data-y="${y}"]`);
      hits.forEach((el) => el.classList.add('is-hot'));
      const p = hits[0]?.dataset.p;
      read.innerHTML = `<b>${y}</b> <span>${p}% of the ink is left${+y > 2019 ? ' — projected' : ''}</span>`;
    };
    core.addEventListener('pointerover', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-y]');
      if (el) pick(el.dataset.y!);
    });
    core.addEventListener('pointerleave', () => pick(null));

    // ---------- Tester ----------
    const test = page.querySelector<HTMLElement>('[data-cc-test]')!;
    const text = test.querySelector<HTMLElement>('[data-test-text]')!;
    const slider = test.querySelector<HTMLInputElement>('[data-test-y]')!;
    const yv = test.querySelector<HTMLElement>('[data-test-yv]')!;
    const play = test.querySelector<HTMLButtonElement>('[data-test-play]')!;
    let raf = 0;
    const setYear = (y: number) => {
      text.style.setProperty('--year', y.toFixed(2));
      test.style.setProperty('--t', String((y - Y0) / (Y1 - Y0)));
      slider.value = String(Math.round(y));
      yv.textContent = String(Math.round(y));
    };
    const stop = () => {
      cancelAnimationFrame(raf); raf = 0;
      play.setAttribute('aria-pressed', 'false');
      play.querySelector('span')!.textContent = 'Play 1979 → 2050';
    };
    slider.addEventListener('input', () => { stop(); setYear(+slider.value); });
    test.querySelectorAll<HTMLButtonElement>('[data-test-set]').forEach((b) =>
      b.addEventListener('click', () => { stop(); setYear(b.dataset.testSet === 'now' ? nowYear : +b.dataset.testSet!); })
    );
    play.addEventListener('click', () => {
      if (raf) return stop();
      play.setAttribute('aria-pressed', 'true');
      play.querySelector('span')!.textContent = 'Pause';
      let y = +slider.value >= Y1 ? Y0 : +slider.value;
      let last = performance.now();
      const step = (now: number) => {
        y += ((now - last) / 1000) * 9; // nine years a second
        last = now;
        if (y >= Y1) { setYear(Y1); return stop(); }
        setYear(y);
        raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    });
    // contenteditable="plaintext-only" isn't universal; fall back gracefully.
    if (text.contentEditable !== 'plaintext-only') text.contentEditable = 'true';
    text.addEventListener('keydown', (e) => { if (e.key === 'Enter') e.preventDefault(); });
    setYear(Y0);

    // ---------- Closing line breathes between the two ends of the axis ----------
    const end = page.querySelector<HTMLElement>('[data-cc-end]')!;
    new IntersectionObserver((es) => end.classList.toggle('is-in', es[0].isIntersecting), { threshold: 0.4 }).observe(end);
  }
</script>

<style is:global>
  @property --year { syntax: '<number>'; inherits: true; initial-value: 1979; }

  .cc-page {
    --ice: #eaf6fb;
    --sea: #04141f;
    --warm: #2b0d10;
    --heat: #ff6a3d;
    --cc-mono: var(--font-mono);
    background: var(--sea);
  }
  .cc {
    font-family: 'Climate Crisis Variable', 'Arial Black', sans-serif;
    font-variation-settings: 'YEAR' var(--year);
    font-weight: 400;
    font-feature-settings: normal;
    line-height: 0.9;
    text-transform: uppercase;
  }
  .cc * { font-variation-settings: 'YEAR' var(--year); }

  /* ---------- scrolly stage ---------- */
  .cc-scrolly { height: 520vh; position: relative; }
  .cc-stage {
    --t: 0;
    --tone: color-mix(in oklab, var(--accent), var(--heat) calc(var(--t) * 100%));
    position: sticky; top: 64px;
    height: calc(100svh - 64px);
    display: grid; grid-template-rows: auto 1fr auto auto;
    gap: clamp(0.6rem, 1.6vh, 1.4rem);
    padding: clamp(1rem, 2.2vw, 1.8rem) var(--gutter) clamp(1rem, 2vw, 1.6rem);
    overflow: hidden;
    background:
      radial-gradient(120% 70% at 50% 110%, color-mix(in oklab, #0b3a55, #7a1d12 calc(var(--t) * 100%)) 0%, transparent 70%),
      color-mix(in oklab, var(--sea), var(--warm) calc(var(--t) * 100%));
  }
  .cc-stage__top {
    display: flex; justify-content: space-between; gap: 1rem;
    font-family: var(--cc-mono); font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--fg);
  }
  .cc-stage__top span { color: var(--fg-3); }
  .cc-stage__cue { color: var(--tone); transition: opacity 0.5s; white-space: nowrap; }
  .cc-stage__cue i { display: inline-block; font-style: normal; animation: cc-bob 1.6s ease-in-out infinite; }
  .cc-stage__cue.is-off { opacity: 0; }
  @keyframes cc-bob { 50% { transform: translateY(4px); } }

  .cc-title {
    align-self: center;
    display: flex; flex-direction: column;
    font-size: min(14.1vw, 27svh);
    line-height: 0.86;
    color: var(--ice);
    white-space: nowrap;
    margin-left: -0.02em;
  }
  .cc-title span:last-child { align-self: flex-end; margin-right: -0.02em; }

  .cc-stage__band {
    display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: end;
    gap: clamp(1.2rem, 4vw, 4.5rem);
    margin-bottom: 1.1rem;
  }
  .cc-year {
    font-size: clamp(2.6rem, 6.4vw, 6.6rem);
    color: var(--tone);
    font-variant-numeric: tabular-nums;
    min-width: 4.3em;
  }
  .cc-captions { position: relative; min-height: 5.6em; font-size: clamp(0.98rem, 0.8rem + 0.6vw, 1.3rem); line-height: 1.4; }
  .cc-captions p {
    position: absolute; left: 0; bottom: 0; max-width: 46ch;
    color: var(--fg-2);
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.45s var(--ease), transform 0.6s var(--ease);
    text-wrap: pretty;
  }
  .cc-captions p.is-on { opacity: 1; transform: none; }
  .cc-captions b { color: var(--fg); font-weight: 600; }
  .cc-ink { text-align: right; }
  .cc-ink dt { font-family: var(--cc-mono); font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-3); }
  .cc-ink dd {
    font-family: var(--cc-mono); font-weight: 300; font-size: clamp(2rem, 1.2rem + 3vw, 4.2rem); line-height: 1;
