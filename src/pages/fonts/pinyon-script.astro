---
// PINYON SCRIPT — new edition. A pen that writes itself: every example on
// this page is new and built for this face.
import '../../styles/edition.css';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EditionTail from '../../components/edition/EditionTail.astro';
import { getEdition } from '../../lib/edition';

const { entry, font, prev, next, themeStyle } = await getEdition('pinyon-script');
const inks = [{ n: 'Iron gall', c: '#1e1812' }, { n: 'Oxblood', c: '#7a1626' }, { n: 'Prussian blue', c: '#12355b' }, { n: 'Forest', c: '#1f4a36' }, { n: 'Gold', c: '#9a7426' }];
const cards = ['Mr. Hartwell', 'Ms. Okonkwo', 'Dr. Lindqvist', 'Grandmama'];
---
<Layout title="Pinyon Script — Specimen" description={font.blurb} themeStyle={themeStyle} mode={font.theme.mode} fixedTheme>
  <SiteHeader current="Pinyon Script" showToggle={false} />

  <div class="ed ps" data-ps>
    <header class="ed-hero ps-hero" data-hero>
      <div class="ed-hero__top"><span>Pinyon Script · {font.designer} · {font.year}</span><span>One style. It is enough.</span></div>
      <h1 class="ed-hero__word ps-hero__word" aria-label="Pinyon Script">
        <span class="ps-write" data-write><span class="ps-f" aria-hidden="true">Pinyon Script</span></span>
      </h1>
      <div class="ed-hero__foot">
        <p class="ed-hero__lede">
          The handwriting you <em>wish</em> you had.
          <span class="ed-hero__hint" data-fine>Click anywhere to watch it written again.</span>
          <span class="ed-hero__hint" data-coarse>Tap anywhere to watch it written again.</span>
        </p>
        <dl class="ed-readout"><div><dt>slant</dt><dd>≈ 52°</dd></div><div><dt>styles</dt><dd>1</dd></div></dl>
      </div>
    </header>

    <main>
      <section class="ed-sec" data-invite>
        <div class="ed-kicker"><span>01</span> By post</div>
        <h2 class="ed-h2">Some news deserves<br />better than <em>a text message</em>.</h2>
        <p class="ed-lede">Put two names in. The invitation writes itself.</p>
        <div class="ed-body ps-invite">
          <div class="ps-invite__card" data-invite-card>
            <p class="ps-invite__small">Together with their families</p>
            <p class="ps-f ps-invite__names"><span class="ps-write" data-write><span data-inv-a>Eleanor</span></span><i class="ps-f">&amp;</i><span class="ps-write" data-write><span data-inv-b>Sebastian</span></span></p>
            <p class="ps-invite__small">request the pleasure of your company<br />at their wedding</p>
            <p class="ps-f ps-invite__date">Saturday, the fourteenth of June</p>
            <p class="ps-invite__small">Four o’clock · The Orangery · Dinner &amp; dancing to follow</p>
          </div>
          <div class="ps-invite__form">
            <label><span>First name</span><input type="text" value="Eleanor" maxlength="14" data-inv-in="a" /></label>
            <label><span>Second name</span><input type="text" value="Sebastian" maxlength="14" data-inv-in="b" /></label>
            <div class="ps-inks" role="radiogroup" aria-label="Ink">
              {inks.map((k, i) => <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-ink={k.c} style={`--c:${k.c}`} title={k.n} aria-label={k.n}></button>)}
            </div>
            <p class="ed-cap">Five inks. The whole page changes with them.</p>
          </div>
        </div>
      </section>

      <section class="ed-sec">
        <div class="ed-kicker"><span>02</span> At the table</div>
        <h2 class="ed-h2">It makes a seating plan<br />feel like <em>an honour</em>.</h2>
        <div class="ed-body ps-table">
          {cards.map((c, i) => <div class="ps-place" style={`--i:${i}`}><p class="ps-f">{c}</p><span>Table {['One', 'One', 'Two', 'Two'][i]}</span></div>)}
        </div>
        <p class="ed-cap">Place cards — hover one and it stands up</p>
      </section>

      <section class="ed-sec">
        <div class="ed-kicker"><span>03</span> For the record</div>
        <h2 class="ed-h2">Sign here, and <em>mean it</em>.</h2>
        <div class="ed-body ps-cert" data-cert>
          <div class="ps-cert__sheet">
            <p class="ps-cert__k">Certificate of Honour</p>
            <p class="ps-f ps-cert__title">In recognition of</p>
            <p class="ps-f ps-cert__name"><span class="ps-write" data-write data-cert-out><span>Your Name</span></span></p>
            <p class="ps-cert__body">for outstanding taste in typefaces, and for reading this far down the page.</p>
            <div class="ps-cert__foot">
              <p><span class="ps-f">The Specimen Library</span><i>Issued by</i></p>
              <div class="ps-seal ps-f" aria-hidden="true"><span data-cert-mono>YN</span></div>
              <p><span class="ps-f" data-cert-date>Today</span><i>Date</i></p>
            </div>
          </div>
          <label class="ps-cert__in"><span>Your name</span><input type="text" placeholder="Type your name" maxlength="24" data-cert-in /></label>
        </div>
        <p class="ed-cap">A keepsake, not a credential. The seal takes your initials.</p>
      </section>

      <section class="ed-sec">
        <div class="ed-kicker"><span>04</span> Size matters</div>
        <h2 class="ed-h2">Give it room.<br />It repays <em>every inch</em>.</h2>
        <div class="ed-body ps-scale">
          {[['18', 'Too small. The hairlines vanish.'], ['36', 'Legible. Not yet lovely.'], ['72', 'Now the loops open up.'], ['144', 'Here it sings.']].map(([s, note]) => (
            <p style={`--s:${s}`}><b>{s} px</b><span class="ps-f">Sincerely yours</span><i>{note}</i></p>
          ))}
        </div>
      </section>

      <EditionTail entry={entry} from={5} extra={[{ k: 'Styles', v: 'Regular only' }]} />
    </main>
  </div>
  <SiteFooter prev={prev} next={next} />
</Layout>

<script>
  const page = document.querySelector<HTMLElement>('[data-ps]');
  if (page) {
    // Any .ps-write wipes its text in left to right, like a pen crossing the paper.
    const write = (el: HTMLElement) => { el.classList.remove('is-writing'); void el.offsetWidth; el.style.setProperty('--len', String(Math.max(4, el.textContent!.trim().length))); el.classList.add('is-writing'); };
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { write(e.target as HTMLElement); io.unobserve(e.target); } }), { threshold: 0.5 });
    page.querySelectorAll<HTMLElement>('[data-write]').forEach((el) => io.observe(el));
    const hero = page.querySelector<HTMLElement>('[data-hero]')!;
    hero.addEventListener('click', () => write(hero.querySelector<HTMLElement>('[data-write]')!));

    // Invitation
    const inv = page.querySelector<HTMLElement>('[data-invite]')!;
    inv.querySelectorAll<HTMLInputElement>('[data-inv-in]').forEach((input) => input.addEventListener('input', () => {
      const out = inv.querySelector<HTMLElement>(`[data-inv-${input.dataset.invIn}]`)!;
      out.textContent = input.value || '…'; write(out.parentElement!);
    }));
    const inks = Array.from(inv.querySelectorAll<HTMLButtonElement>('[data-ink]'));
    inks.forEach((b) => b.addEventListener('click', () => { page.style.setProperty('--ink', b.dataset.ink!); inks.forEach((o) => o.setAttribute('aria-checked', String(o === b))); }));

    // Certificate
    const cert = page.querySelector<HTMLElement>('[data-cert]')!;
    const out = cert.querySelector<HTMLElement>('[data-cert-out]')!;
    cert.querySelector('[data-cert-date]')!.textContent = new Date().toLocaleDateString(undefined, { day: 'numeric', month: 'long', year: 'numeric' });
    let t = 0;
    cert.querySelector<HTMLInputElement>('[data-cert-in]')!.addEventListener('input', (e) => {
      const v = (e.target as HTMLInputElement).value.trim();
      clearTimeout(t);
      t = window.setTimeout(() => {
        out.firstElementChild!.textContent = v || 'Your Name';
        cert.querySelector('[data-cert-mono]')!.textContent = (v || 'Your Name').split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
        write(out);
      }, 350);
    });
  }
</script>

<style is:global>
  .ps { --ink: #1e1812; --ed-head: 'Cormorant Garamond', Georgia, serif; --ed-radius: 2px; }
  .ps .ed-h2 { font-weight: 500; letter-spacing: -0.01em; }
  .ps .ed-h2 em, .ps .ed-hero__lede em { font-family: 'Pinyon Script', cursive; font-style: normal; font-size: 1.35em; line-height: 0.6; color: var(--ink); padding-inline: 0.06em; }
  .ps .ed-hero__lede { font-weight: 500; font-size: clamp(1.5rem, 1rem + 2vw, 2.7rem); }
  .ps-f { font-family: 'Pinyon Script', cursive; font-weight: 400; font-feature-settings: 'liga', 'calt'; color: var(--ink); transition: color 0.5s; }

  /* the pen: a left-to-right wipe, stepped so it reads as strokes rather than a slide */
  .ps-write { display: inline-block; padding: 0.25em 0.3em 0.35em 0.12em; margin: -0.25em -0.3em -0.35em -0.12em; clip-path: inset(-20% 0 -30% 0); }
  .ps-write.is-writing { animation: ps-write calc(var(--len, 8) * 0.13s) cubic-bezier(0.4, 0.1, 0.5, 1) both; }
  @keyframes ps-write { from { clip-path: inset(-20% 100% -30% 0); } to { clip-path: inset(-20% -5% -30% 0); } }
  @media (prefers-reduced-motion: reduce) { .ps-write.is-writing { animation: none; } }

  .ps-hero { background: radial-gradient(80% 70% at 50% 40%, #fffdf7, transparent 70%), repeating-linear-gradient(0deg, transparent 0 2.4rem, #1e181210 2.4rem calc(2.4rem + 1px)); }
  .ps-hero__word { font-size: min(16.6vw, 44svh); line-height: 1.1; }

  .ps-invite { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: center; }
  .ps-invite__card { container-type: inline-size; background: #fffdf7; padding: 9cqi 6cqi; text-align: center; display: grid; gap: 3.4cqi; box-shadow: 0 1px 0 #fff inset, 0 30px 60px -30px #1e181266, 0 0 0 1px #1e181214; outline: 1px solid color-mix(in srgb, var(--ink) 50%, transparent); outline-offset: -2.6cqi; transform: rotate(-1deg); }
  .ps-invite__small { font-family: 'Cormorant Garamond', serif; font-size: 2.7cqi; letter-spacing: 0.2em; text-transform: uppercase; line-height: 1.7; color: #453e32; }
  .ps-invite__names { display: grid; justify-items: center; font-size: 17cqi; line-height: 0.95; white-space: nowrap; }
  .ps-invite__names i { font-style: normal; font-size: 0.5em; line-height: 0.8; opacity: 0.7; }
  .ps-invite__date { font-size: 6.4cqi; line-height: 1.1; }
  .ps-invite__form { display: grid; gap: 1.2rem; }
  .ps-invite__form label, .ps-cert__in { display: grid; gap: 0.4rem; font: 400 0.7rem/1.4 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-3); }
  .ps input[type='text'] { font: 500 1.5rem/1.2 'Cormorant Garamond', serif; padding: 0.4rem 0; background: none; border: 0; border-bottom: 1px solid var(--fg-3); color: var(--fg); outline: none; letter-spacing: 0; text-transform: none; }
  .ps input[type='text']:focus { border-color: var(--ink); }
  .ps-inks { display: flex; gap: 0.7rem; padding-top: 0.5rem; }
  .ps-inks button { width: 30px; height: 30px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 3px var(--bg), 0 0 0 4px transparent; transition: box-shadow 0.2s; }
  .ps-inks button[aria-checked='true'] { box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--c); }

  .ps-table { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(0.8rem, 2vw, 2rem); padding: clamp(2.5rem, 6vw, 6rem) clamp(1rem, 3vw, 3rem) clamp(1.5rem, 3vw, 3rem); background: radial-gradient(90% 120% at 50% 0%, #3a2a22, #1b1310); perspective: 900px; }
  .ps-place { container-type: inline-size; background: linear-gradient(180deg, #fffdf7, #efe7d6); padding: 10cqi 4cqi 8cqi; text-align: center; display: grid; gap: 4cqi; transform-origin: 50% 100%; transform: rotateX(38deg); transition: transform 0.6s cubic-bezier(0.34, 1.5, 0.64, 1), box-shadow 0.6s; box-shadow: 0 30px 30px -20px #000a; }
  .ps-place:hover { transform: rotateX(4deg) translateY(-6px); box-shadow: 0 50px 40px -30px #000c; }
  .ps-place p { font-size: 25cqi; line-height: 1; white-space: nowrap; }
  .ps-place span { font-family: 'Cormorant Garamond', serif; font-size: 5cqi; letter-spacing: 0.3em; text-transform: uppercase; color: #8a7f6e; }

  .ps-cert { display: grid; gap: 1.5rem; }
  .ps-cert__sheet { container-type: inline-size; background: #fffdf7; padding: 6cqi 7cqi 5cqi; text-align: center; display: grid; gap: 1.6cqi; border: 0.8cqi double color-mix(in srgb, var(--ink) 70%, transparent); box-shadow: 0 30px 60px -40px #1e1812aa; }
  .ps-cert__k { font-family: 'Cinzel Variable', serif; font-size: 2.6cqi; letter-spacing: 0.42em; text-transform: uppercase; color: #453e32; }
  .ps-cert__title { font-size: 5.4cqi; line-height: 1.1; opacity: 0.75; }
  .ps-cert__name { font-size: 14.5cqi; line-height: 1; white-space: nowrap; min-height: 1.1em; }
  .ps-cert__body { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 2.6cqi; max-width: 36em; margin-inline: auto; color: #453e32; }
  .ps-cert__foot { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 4cqi; margin-top: 3cqi; }
  .ps-cert__foot p { display: grid; gap: 0.6cqi; }
  .ps-cert__foot p span { font-size: 4cqi; line-height: 1.2; border-bottom: 1px solid #453e32; white-space: nowrap; }
  .ps-cert__foot i { font: normal 400 1.3cqi/1 var(--font-mono); letter-spacing: 0.16em; text-transform: uppercase; color: #8a7f6e; }
  .ps-seal { width: 13cqi; height: 13cqi; border-radius: 50%; display: grid; place-items: center; background: radial-gradient(circle at 35% 30%, #c8324a, #7a1626 60%, #4d0b16); box-shadow: inset 0 0 0 0.5cqi #ffffff22, inset 0 0 0 1.4cqi #7a1626, 0 0.6cqi 1cqi #0005; }
  .ps-seal span { font-size: 6cqi; color: #ffd9d0; text-shadow: 0 0.1cqi 0 #4d0b16; }
  .ps-cert__in { max-width: 26rem; }

  .ps-scale p { display: grid; grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 16rem); align-items: center; gap: 1.5rem; padding: 1rem 0; border-top: 1px solid var(--line); overflow: hidden; }
  .ps-scale b { font: 400 0.72rem/1 var(--font-mono); color: var(--fg-3); }
  .ps-scale span { font-size: min(calc(var(--s) * 1px), 15.5vw); line-height: 1.15; white-space: nowrap; }
  .ps-scale i { font-family: 'Cormorant Garamond', serif; font-size: 1.15rem; color: var(--fg-2); text-align: right; }

  .ps .ed-story__prose { font-family: 'Cormorant Garamond', serif; font-size: calc(var(--step-1) * 1.12); font-weight: 500; }

  @media (max-width: 900px) {
    .ps-invite { grid-template-columns: minmax(0, 1fr); }
    .ps-table { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 2.5rem; }
    .ps-scale p { grid-template-columns: 3.4rem minmax(0, 1fr); }
    .ps-scale i { grid-column: 2; text-align: left; }
  }
</style>
