---
// HANDJET — new edition. A hand-built page; the face is also in the `fonts`
// collection. Every letter is a grid of identical elements; the page is a wall
// of displays that lets you choose what that element is.
import Layout from '../../layouts/Layout.astro';
import PosterWall from '../../components/edition/PosterWall.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GlyphInspector from '../../components/specimen/GlyphInspector.astro';

// The whole-number stops of the Element Shape axis. The font only numbers
// them; the nicknames are ours.
const shapes = [
  'Sawtooth', 'Square', 'Tile', 'Hairline', 'Needle', 'Brick', 'Pebble', 'Dot',
  'Seed', 'Grain', 'Bead', 'Clover', 'Flower', 'Sparkle', 'Diamond', 'Heart',
].map((name, i) => ({ n: i + 1, name }));

const board = [
  { time: '18:04', to: 'PRAHA HL.N.', plat: '2', status: 'ON TIME' },
  { time: '18:11', to: 'WIEN HBF', plat: '5', status: 'BOARDING' },
  { time: '18:19', to: 'BRATISLAVA', plat: '1', status: 'ON TIME' },
  { time: '18:32', to: 'BERLIN HBF', plat: '4', status: 'DELAYED 12' },
  { time: '18:47', to: 'KRAKOW GL.', plat: '3', status: 'ON TIME' },
];

const receipt = [
  ['2 x ESPRESSO', '5.60'],
  ['1 x CINNAMON BUN', '3.20'],
  ['1 x SPARKLING WATER', '2.40'],
  ['1 x POSTCARD', '1.10'],
];

const hellos = [
  { text: 'Hello', lang: 'Latin', shape: 8, dir: 'ltr' },
  { text: 'Γειά σου', lang: 'Greek', shape: 2, dir: 'ltr' },
  { text: 'Привет', lang: 'Cyrillic', shape: 15, dir: 'ltr' },
  { text: 'שלום', lang: 'Hebrew', shape: 12, dir: 'rtl' },
  { text: 'مرحبا', lang: 'Arabic', shape: 11, dir: 'rtl' },
  { text: 'Բարեւ', lang: 'Armenian', shape: 7, dir: 'ltr' },
];

const ticker = ['NOW SHOWING', 'ONE FONT', 'SIXTEEN PIXELS', 'ZERO BITMAPS', 'MIND THE GAP', 'OPEN ALL NIGHT'];
const inks = [
  { id: 'amber', c: '#ffb000' }, { id: 'red', c: '#ff3b30' }, { id: 'green', c: '#6dff7a' },
  { id: 'ice', c: '#8fe3ff' }, { id: 'pink', c: '#ff5c9d' }, { id: 'white', c: '#f3efe6' },
];
const glyphs = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', ...'abcdefghijklmnopqrstuvwxyz', ...'0123456789', ...'!?&@#$%*+=/()[]{}<>'];

const themeStyle = [
  '--bg:#0a0a0b', '--bg-2:#141416', '--fg:#f3efe6', '--fg-2:#b8b3a6', '--fg-3:#7f7a6e',
  '--accent:#ffb000', '--accent-contrast:#0a0a0b', '--line:#f3efe624', '--line-soft:#f3efe612',
  'color-scheme:dark',
].join(';');
---
<Layout
  title="Handjet — Specimen"
  description="Handjet, an element-based variable font: every glyph is a grid of one repeated shape, and the shape itself is an axis."
  themeStyle={themeStyle}
  mode="dark"
  fixedTheme
>
  <SiteHeader current="Handjet" showToggle={false} />

  <div class="hj-page" data-hj>

    <!-- ============ HERO ============ -->
    <header class="hj-hero" data-hj-hero>
      <div class="hj-hero__top">
        <span>Handjet · Rosetta · David Březina</span>
        <span>Element-based variable font</span>
      </div>

      <h1 class="hj-hero__word hj" data-hero-word aria-label="Handjet">
        {[...'Handjet'].map((ch, i) => <span data-l style={`--i:${i}`} aria-hidden="true">{ch}</span>)}
      </h1>

      <div class="hj-hero__foot">
        <p class="hj-hero__lede">
          Every letter is a grid of one small shape. You get to choose the shape.
          <span class="hj-hero__hint" data-hint-fine>Move sideways to change the element, up and down for its size. Click to double the grid.</span>
          <span class="hj-hero__hint" data-hint-coarse>Drag across the word to change the element. Tap to double the grid.</span>
        </p>
        <dl class="hj-readout">
          <div><dt>ELSH · shape</dt><dd><span data-hud="elsh">02.0</span> <em data-hud="name">Square</em></dd></div>
          <div><dt>wght · size</dt><dd data-hud="wght">400</dd></div>
          <div><dt>ELGR · grid</dt><dd data-hud="elgr">1.0</dd></div>
        </dl>
      </div>
    </header>

    <!-- ============ TICKER ============ -->
    <div class="hj-ticker hj" aria-hidden="true">
      <div class="hj-ticker__track">
        {[0, 1].map(() => ticker.map((t, i) => <span style={`--elsh:${[8, 2, 16, 12, 15, 13][i]}`}>{t}<i>•</i></span>))}
      </div>
    </div>

    <main>
      <!-- ============ SHAPES ============ -->
      <section class="hj-sec" data-hj-shapes>
        <div class="hj-kicker"><span>01</span> Pick your pixel</div>
        <h2 class="hj-h2">Squares are only <em>one option</em>.</h2>
        <p class="hj-lede">
          The Element Shape axis runs from 0 to 16. Each whole number is a different mark — dots, diamonds, clovers,
          hearts — and everything in between is a smooth morph from one to the next. Choose one and the page follows.
        </p>

        <div class="hj-shapes" role="radiogroup" aria-label="Element shape">
          {shapes.map((s) => (
            <button type="button" class="hj-shape" role="radio" aria-checked={s.n === 8 ? 'true' : 'false'} data-shape={s.n} data-name={s.name} style={`--elsh:${s.n}`}>
              <span class="hj hj-shape__g" aria-hidden="true">a</span>
              <span class="hj-shape__n">{String(s.n).padStart(2, '0')}</span>
              <span class="hj-shape__name">{s.name}</span>
            </button>
          ))}
        </div>

        <div class="hj-morph">
          <p class="hj hj-morph__word" data-morph-word aria-hidden="true">In between</p>
          <label class="hj-slider">
            <span>ELSH <b data-morph-val>8.0</b></span>
            <input type="range" min="1" max="16" step="0.1" value="8" data-morph aria-label="Element shape" />
          </label>
        </div>
      </section>

      <!-- ============ THREE AXES ============ -->
      <section class="hj-sec">
        <div class="hj-kicker"><span>02</span> Three axes</div>
        <h2 class="hj-h2">What it is, how big it is,<br />and <em>how many</em> there are.</h2>

        <div class="hj-axes">
          <figure class="hj-axis hj-axis--shape" data-hj-inview>
            <p class="hj hj-axis__g" aria-hidden="true">Rg</p>
            <figcaption><b>Element Shape</b> <code>ELSH 0 – 16</code><p>What each element is. Sixteen stops, endless in-betweens.</p></figcaption>
          </figure>
          <figure class="hj-axis hj-axis--size" data-hj-inview>
            <p class="hj hj-axis__g" aria-hidden="true">Rg</p>
            <figcaption><b>Weight</b> <code>wght 100 – 900</code><p>How large each element is. The letter never changes width; the dots swell until they touch.</p></figcaption>
          </figure>
          <figure class="hj-axis hj-axis--grid" data-hj-inview>
            <p class="hj hj-axis__g" aria-hidden="true">Rg</p>
            <figcaption><b>Element Grid</b> <code>ELGR 1 – 2</code><p>How many elements fill each unit. At 2 the resolution doubles and the same letter is drawn with four times the marks.</p></figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ IN USE ============ -->
      <section class="hj-sec">
        <div class="hj-kicker"><span>03</span> In use</div>
        <h2 class="hj-h2">Anything that speaks in dots.</h2>

        <div class="hj-bento">
          <article class="hj-board" data-hj-inview>
            <div class="hj-board__panel hj">
              <header><span>DEPARTURES</span><span data-hj-clock>18:00:00</span></header>
              <ol>
                {board.map((r, i) => (
                  <li style={`--i:${i}`} class:list={[r.status === 'BOARDING' && 'is-boarding', r.status.startsWith('DELAYED') && 'is-late']}>
                    <span>{r.time}</span><span>{r.to}</span><span>{r.plat}</span><span>{r.status}</span>
                  </li>
                ))}
              </ol>
            </div>
            <p class="hj-cap">Departure board — the Dot element, amber on black</p>
          </article>

          <article class="hj-receipt">
            <div class="hj-receipt__paper hj">
              <p class="hj-receipt__shop">CORNER SHOP</p>
              <p class="hj-receipt__meta">TILL 02 · RECEIPT 004127</p>
              <ul>
                {receipt.map(([a, b]) => <li><span>{a}</span><span>{b}</span></li>)}
              </ul>
              <p class="hj-receipt__total"><span>TOTAL</span><span>12.30</span></p>
              <p class="hj-receipt__thanks">THANK YOU</p>
            </div>
            <p class="hj-cap">Till receipt — and the last line switches to hearts</p>
          </article>

          <article class="hj-love" data-hj-inview>
            <div class="hj-love__card hj"><span>LOVE</span><span>LETTERS</span></div>
            <p class="hj-cap">Card — the Heart element, growing and shrinking</p>
          </article>
        </div>
      </section>

      <!-- ============ SCRIPTS ============ -->
      <section class="hj-sec">
        <div class="hj-kicker"><span>04</span> Six scripts</div>
        <h2 class="hj-h2">The same dots, in six alphabets.</h2>
        <p class="hj-lede">Pixel fonts usually stop at A to Z. This one also sets Greek, Cyrillic, Hebrew, Arabic and Armenian.</p>
        <div class="hj-hellos">
          {hellos.map((h) => (
            <figure class="hj-hello" style={`--elsh:${h.shape}`}>
              <p class="hj" dir={h.dir}>{h.text}</p>
              <figcaption>{h.lang}</figcaption>
            </figure>
          ))}
        </div>
      </section>

      <!-- ============ TESTER ============ -->
      <PosterWall slug="handjet" n="05" kicker="hj-kicker" sec="hj-sec" />
      <section class="hj-sec" data-hj-test>
        <div class="hj-kicker"><span>06</span> Your turn</div>
        <h2 class="hj-h2">Write on the wall.</h2>

        <div class="hj-test__stage">
          <div class="hj hj-test__text" contenteditable="plaintext-only" spellcheck="false" role="textbox" aria-label="Sample text — editable" data-test-text>Type here</div>
        </div>
        <div class="hj-test__ctl">
          <label class="hj-slider"><span>Shape <b data-tv="elsh"></b></span><input type="range" min="1" max="16" step="0.1" value="13" data-t="elsh" /></label>
          <label class="hj-slider"><span>Size <b data-tv="hw"></b></span><input type="range" min="100" max="900" step="1" value="560" data-t="hw" /></label>
          <label class="hj-slider"><span>Grid <b data-tv="elgr"></b></span><input type="range" min="1" max="2" step="0.1" value="1" data-t="elgr" /></label>
          <div class="hj-inks" role="radiogroup" aria-label="Colour">
            {inks.map((k, i) => <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} aria-label={k.id} data-ink={k.c} style={`--c:${k.c}`}></button>)}
          </div>
        </div>
      </section>

      <!-- ============ GLYPHS ============ -->
      <section class="hj-sec">
        <div class="hj-kicker"><span>07</span> The set</div>
        <h2 class="hj-h2">Run a hand over it.</h2>
        <p class="hj-lede">Click any letter to see it large.</p>
        <div class="hj-keys" data-hj-keys data-glyphroot>
          {glyphs.map((g) => <button type="button" class="hj hj-key" data-glyph={g} aria-label={`Inspect ${g}`}>{g}</button>)}
        </div>
        <GlyphInspector family="Handjet Variable" variable />
      </section>

      <!-- ============ STORY + SPECS ============ -->
      <section class="hj-sec">
        <div class="hj-kicker"><span>08</span> The story</div>
        <div class="hj-story">
          <div class="hj-story__prose">
            <p class="hj-story__lede">
              Handjet comes from <strong>Rosetta</strong>, the foundry of <strong>David Březina</strong>, a studio best
              known for careful work across many writing systems. Here that care is pointed at the humblest kind of
              lettering there is: the kind made of dots.
            </p>
            <p>
              A pixel font is normally frozen. Someone decides the grid, fills in the squares, and that is the
              typeface. Handjet keeps the grid and unfreezes everything else. Every glyph is built from copies of a
              single element, and the element is a variable: its shape, its size, and how many of it fill a unit are
              all axes you can set or animate.
            </p>
            <p>
              So the same file is a ticket machine, a stadium scoreboard, a cross-stitch sampler and a valentine,
              and it can pass through all of them in one transition. Johannes Neumeier, Borna Izadpanah, Khajag
              Apelian and Meir Sadan contributed to it, and it covers six scripts rather than the usual one.
            </p>
          </div>

          <dl class="hj-specs">
            <div><dt>Design</dt><dd>David Březina, Rosetta</dd></div>
            <div><dt>With</dt><dd>Johannes Neumeier, Borna Izadpanah, Khajag Apelian, Meir Sadan</dd></div>
            <div><dt>Format</dt><dd>Element-based variable font, three axes</dd></div>
            <div><dt>Axes</dt><dd><code>ELSH</code> 0–16 (default 2)<br /><code>ELGR</code> 1–2 (default 1)<br /><code>wght</code> 100–900 (default 400)</dd></div>
            <div><dt>Scripts</dt><dd>Latin, Greek, Cyrillic, Hebrew, Arabic, Armenian</dd></div>
            <div><dt>Caveat</dt><dd>Its makers note that macOS can draw it with visual artefacts.</dd></div>
            <div><dt>Licence</dt><dd>SIL Open Font License 1.1</dd></div>
            <div class="hj-specs__links">
              <a href="https://fonts.google.com/specimen/Handjet" rel="noopener">Get it on Google Fonts ↗</a>
              <a href="https://github.com/rosettatype/handjet" rel="noopener">Source ↗</a>
            </div>
          </dl>
        </div>
      </section>

      <a class="hj-next" href="/fonts/recursive">
        <span class="hj-next__k">Next →</span>
        <span class="hj-next__name" aria-label="Recursive">{[...'Recursive'].map((c, i) => <span style={`--i:${i}`} aria-hidden="true">{c}</span>)}</span>
        <span class="hj-next__sub">One file, five dials.</span>
      </a>
    </main>
  </div>

  <SiteFooter />
</Layout>

<script>
  const page = document.querySelector<HTMLElement>('[data-hj]');
  if (page) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));
    const shapeBtns = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-shape]'));
    const nameOf = (v: number) => shapeBtns[clamp(Math.round(v), 1, 16) - 1].dataset.name!;

    const io = new IntersectionObserver(
      (es) => es.forEach((e) => e.target.classList.toggle('is-in', e.isIntersecting)),
      { threshold: 0.2 }
    );
    page.querySelectorAll('[data-hj-inview]').forEach((el) => io.observe(el));

    // ---------- Hero: sideways = shape, height + proximity = element size ----------
    const hero = page.querySelector<HTMLElement>('[data-hj-hero]')!;
    const word = hero.querySelector<HTMLElement>('[data-hero-word]')!;
    const letters = Array.from(word.querySelectorAll<HTMLElement>('[data-l]'));
    const hud = Object.fromEntries(Array.from(hero.querySelectorAll<HTMLElement>('[data-hud]')).map((el) => [el.dataset.hud!, el]));
    const w = letters.map(() => 400);
    let px = 0.5, py = 0.5, lastMove = -1e9, on = true, elsh = 8, elgr = 1, gridTarget = 1;
    let centers: number[] = [];
    const measure = () => {
      const r = hero.getBoundingClientRect();
      centers = letters.map((l) => { const b = l.getBoundingClientRect(); return (b.left + b.width / 2 - r.left) / r.width; });
    };
    measure();
    window.addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      px = clamp((e.clientX - r.left) / r.width, 0, 1);
      py = clamp((e.clientY - r.top) / r.height, 0, 1);
      lastMove = performance.now();
    });
    hero.addEventListener('click', () => { gridTarget = gridTarget === 1 ? 2 : 1; });
    new IntersectionObserver((es) => { on = es[0].isIntersecting; }).observe(hero);
    const tick = (now: number) => {
      requestAnimationFrame(tick);
      if (!on) return;
      const live = now - lastMove < 2600;
      const t = now / 1000;
      const ts = live ? 1 + 15 * clamp((px - 0.06) / 0.88, 0, 1) : reduce ? 8 : 8.5 + 7.5 * Math.sin(t * 0.33);
      elsh += (ts - elsh) * 0.12;
      elgr += (gridTarget - elgr) * 0.12;
      let sum = 0;
      letters.forEach((l, i) => {
        let tw: number;
        if (live) { const near = 1 - clamp(Math.abs(centers[i] - px) / 0.34, 0, 1); tw = 220 + (1 - py) * 330 + 350 * near * near; }
        else if (reduce) tw = 500;
        else tw = 520 + 330 * Math.sin(t * 1.5 - i * 0.7);
        w[i] += (clamp(tw, 100, 900) - w[i]) * 0.15;
        l.style.setProperty('--hw', w[i].toFixed(0));
        sum += w[i];
      });
      word.style.setProperty('--elsh', elsh.toFixed(2));
      word.style.setProperty('--elgr', elgr.toFixed(2));
      hud.elsh.textContent = elsh.toFixed(1).padStart(4, '0');
      hud.name.textContent = nameOf(elsh);
      hud.wght.textContent = String(Math.round(sum / letters.length));
      hud.elgr.textContent = elgr.toFixed(1);
    };
    requestAnimationFrame(tick);

    // ---------- Shapes: one choice re-dots the page ----------
    const morph = page.querySelector<HTMLInputElement>('[data-morph]')!;
    const morphVal = page.querySelector<HTMLElement>('[data-morph-val]')!;
    const setShape = (v: number, fromSlider = false) => {
      page.style.setProperty('--elsh', String(v));
      morphVal.textContent = v.toFixed(1);
      if (!fromSlider) morph.value = String(v);
      shapeBtns.forEach((b) => b.setAttribute('aria-checked', String(+b.dataset.shape! === v)));
    };
    shapeBtns.forEach((b) => b.addEventListener('click', () => setShape(+b.dataset.shape!)));
    morph.addEventListener('input', () => setShape(+morph.value, true));

    // ---------- Board clock ----------
    const clock = page.querySelector<HTMLElement>('[data-hj-clock]');
    if (clock) {
      const paint = () => { clock.textContent = new Date().toTimeString().slice(0, 8); };
      paint(); setInterval(paint, 1000);
    }

    // ---------- Tester ----------
    const test = page.querySelector<HTMLElement>('[data-hj-test]')!;
    const text = test.querySelector<HTMLElement>('[data-test-text]')!;
    test.querySelectorAll<HTMLInputElement>('[data-t]').forEach((s) => {
      const out = test.querySelector<HTMLElement>(`[data-tv="${s.dataset.t}"]`)!;
      const run = () => { text.style.setProperty(`--${s.dataset.t}`, s.value); out.textContent = s.dataset.t === 'elsh' ? `${(+s.value).toFixed(1)} · ${nameOf(+s.value)}` : s.value; };
      s.addEventListener('input', run); run();
    });
    const inkBtns = Array.from(test.querySelectorAll<HTMLButtonElement>('[data-ink]'));
    inkBtns.forEach((b) => b.addEventListener('click', () => {
      text.style.color = b.dataset.ink!;
      inkBtns.forEach((o) => o.setAttribute('aria-checked', String(o === b)));
    }));
    if (text.contentEditable !== 'plaintext-only') text.contentEditable = 'true';
    text.addEventListener('keydown', (e) => { if (e.key === 'Enter') e.preventDefault(); });
  }
</script>

<style is:global>
  /* Registered so shape, size and grid can be transitioned and keyframed. */
  @property --elsh { syntax: '<number>'; inherits: true; initial-value: 8; }
  @property --elgr { syntax: '<number>'; inherits: true; initial-value: 1; }
  @property --hw { syntax: '<number>'; inherits: true; initial-value: 500; }

  .hj-page {
    --elsh: 8;
    --amber: #ffb000;
    --m: var(--font-mono);
    background: var(--bg);
    transition: --elsh 0.9s var(--ease);
  }
  /* `.hj *` too: font-variation-settings inherits as a computed string. */
  .hj, .hj * { font-variation-settings: 'wght' var(--hw), 'ELGR' var(--elgr), 'ELSH' var(--elsh); }
  .hj { font-family: 'Handjet Variable', monospace; font-weight: 400; font-feature-settings: normal; line-height: 0.9; }

  /* ---------- hero ---------- */
  .hj-hero {
    position: relative; overflow: hidden; cursor: pointer; touch-action: pan-y;
    min-height: calc(100svh - 64px);
    display: grid; grid-template-rows: auto 1fr auto; grid-template-columns: minmax(0, 1fr);
    padding: clamp(1rem, 2.5vw, 2rem) var(--gutter) clamp(1.5rem, 3vw, 2.5rem);
    background:
      radial-gradient(90% 70% at 50% 45%, #ffb00022, transparent 70%),
      radial-gradient(#f3efe614 1.2px, transparent 1.6px) 0 0 / 14px 14px,
      var(--bg);
  }
  .hj-hero__top { display: flex; justify-content: space-between; gap: 1rem; font: 400 0.72rem/1.4 var(--m); letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-2); }
  .hj-hero__word {
    align-self: center; justify-self: center;
    display: flex; white-space: nowrap; user-select: none;
    font-size: min(35.5vw, 74svh); line-height: 0.82;
    color: var(--amber);
    filter: drop-shadow(0 0 0.04em #ffb00066);
  }
  .hj-hero__word span { display: block; }
  .hj-hero__foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; flex-wrap: wrap; }
  .hj-hero__lede { font-size: clamp(1.25rem, 0.9rem + 1.5vw, 2.1rem); font-weight: 500; letter-spacing: -0.02em; line-height: 1.15; max-width: 24ch; text-wrap: balance; }
  .hj-hero__hint { display: block; margin-top: 0.8rem; font: 400 0.78rem/1.5 var(--m); letter-spacing: 0.02em; color: var(--fg-2); max-width: 46ch; }
  [data-hint-coarse] { display: none; }
  @media (hover: none) { .hj-hero__hint[data-hint-fine] { display: none; } .hj-hero__hint[data-hint-coarse] { display: block; } }
  .hj-readout { display: flex; gap: clamp(1.2rem, 2.4vw, 2.4rem); }
  .hj-readout dt { font: 400 0.68rem/1.4 var(--m); letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-3); }
  .hj-readout dd { font: 300 clamp(1.5rem, 1rem + 1.8vw, 2.6rem)/1.15 var(--m); font-variant-numeric: tabular-nums; color: var(--amber); white-space: nowrap; }
