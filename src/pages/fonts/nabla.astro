---
// NABLA — new edition. A hand-built page; the face is also in the `fonts` collection.
// The whole page is an arcade at night: the letters are the only lamps.
import Layout from '../../layouts/Layout.astro';
import PosterWall from '../../components/edition/PosterWall.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GlyphInspector from '../../components/specimen/GlyphInspector.astro';

const FAMILY = 'Nabla Variable';

// The seven palettes that ship inside the font (CPAL), plus two mixed here
// with `override-colors`. Nicknames are ours — the font only numbers them.
const palettes = [
  { id: 'coin',      name: 'Coin',       base: 0, accent: '#ffd214', glow: '#ff6a1f', note: 'Palette 0 · the default' },
  { id: 'bubblegum', name: 'Bubblegum',  base: 1, accent: '#ff5c97', glow: '#a012b4', note: 'Palette 1' },
  { id: 'cabinet',   name: 'Cabinet',    base: 2, accent: '#1ee1ff', glow: '#2a1cf5', note: 'Palette 2' },
  { id: 'graphite',  name: 'Graphite',   base: 3, accent: '#a3a3c4', glow: '#3a3a66', note: 'Palette 3' },
  { id: 'chrome',    name: 'Chrome',     base: 4, accent: '#d7d7f5', glow: '#6a6a9c', note: 'Palette 4' },
  { id: 'tropic',    name: 'Tropic',     base: 5, accent: '#00dcdc', glow: '#00a050', note: 'Palette 5' },
  { id: 'afterdark', name: 'After Dark', base: 6, accent: '#ff5ac8', glow: '#d20050', note: 'Palette 6' },
  {
    id: 'mint', name: 'Mint', base: 0, accent: '#5dfac0', glow: '#0c8f7a', note: 'Mixed here · override-colors',
    over: ['#3df5b0', '#064e55', '#0c8f7a', '#0a7a70', '#3df5b0', '#8dffd2', '#3df5b0', '#8dffd2', '#d6fff0', '#ffffff'],
  },
  {
    id: 'ember', name: 'Ember', base: 0, accent: '#ff7a5c', glow: '#b3122e', note: 'Mixed here · override-colors',
    over: ['#ff5a3c', '#4d0016', '#b3122e', '#99102c', '#ff5a3c', '#ff9a7a', '#ff5a3c', '#ff9a7a', '#ffd9c9', '#ffffff'],
  },
];

const paletteCss = (p: (typeof palettes)[number]) =>
  `@font-palette-values --nb-${p.id} {\n  font-family: '${FAMILY}';\n  base-palette: ${p.base};` +
  (p.over ? `\n  override-colors:\n${p.over.map((c, i) => `    ${i} ${c}`).join(',\n')};` : '') +
  `\n}`;

// "Exploded view": the same glyph with every colour slot but one group made
// transparent — the layers of a COLRv1 letter, pulled apart with nothing but CSS.
const layers = [
  { id: 'sides', label: 'Shaded sides',   keep: [1, 2, 3] },
  { id: 'front', label: 'Front face',     keep: [0, 4, 6, 7] },
  { id: 'tops',  label: 'Lit tops',       keep: [5, 8] },
  { id: 'edges', label: 'Edge highlight', keep: [9] },
];
const layerCss = layers
  .map((l) => {
    const off = Array.from({ length: 10 }, (_, i) => i).filter((i) => !l.keep.includes(i));
    return `@font-palette-values --nb-layer-${l.id}{font-family:'${FAMILY}';base-palette:0;override-colors:${off.map((i) => `${i} transparent`).join(',')}}`;
  })
  .join('\n');

const globalPaletteCss =
  palettes.map(paletteCss).join('\n') + '\n' + layerCss + '\n' +
  palettes.map((p) => `.nb-page[data-pal='${p.id}']{--pal:--nb-${p.id};--accent:${p.accent};--glow:${p.glow}}`).join('\n');

const depthSteps = [0, 50, 100, 150, 200];
const lightSteps = [0, 6, 12, 18, 24];

const glyphs = [
  ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
  ...'abcdefghijklmnopqrstuvwxyz',
  ...'0123456789',
  ...'!?&@#$%*+=/()[]{}€£¥§©',
];

const scores = [
  { rank: '1ST', who: 'ARF', pts: '999990' },
  { rank: '2ND', who: 'JVR', pts: '875300' },
  { rank: '3RD', who: 'GFS', pts: '640250' },
  { rank: '4TH', who: 'YOU', pts: '000000' },
];

const themeStyle = [
  '--bg:#0a061c', '--bg-2:#140c30', '--fg:#f4eeff', '--fg-2:#bdb1de', '--fg-3:#8478ad',
  '--accent:#ffd214', '--accent-contrast:#0a061c', '--line:#f4eeff24', '--line-soft:#f4eeff12',
  'color-scheme:dark',
].join(';');
---
<Layout
  title="Nabla — Specimen"
  description="Nabla, a colour font with a third dimension: extrusion depth, edge highlight and seven palettes, shown live."
  themeStyle={themeStyle}
  mode="dark"
  fixedTheme
>
  <SiteHeader current="Nabla" showToggle={false} />
  <style is:global set:html={globalPaletteCss}></style>

  <div class="nb-page" data-nb data-pal="coin">

    <!-- ============ HERO: the letters rise to meet the pointer ============ -->
    <header class="nb-hero" data-nb-hero>
      <div class="nb-hero__floor" aria-hidden="true"></div>
      <div class="nb-hero__lamp" aria-hidden="true"></div>

      <div class="nb-hud nb-hud--tl">
        <span>1UP</span><b data-hud-score>000000</b>
      </div>
      <div class="nb-hud nb-hud--tr">
        <span>Google Fonts · 2022</span><b>Colour · COLRv1</b>
      </div>

      <h1 class="nb-hero__word nb" aria-label="Nabla">
        {[...'NABLA'].map((ch, i) => <span class="nb-hero__l" data-l style={`--i:${i}`} aria-hidden="true">{ch}</span>)}
      </h1>

      <div class="nb-hero__foot">
        <p class="nb-hero__lede">
          A colour font with a third dimension — and a light switch.
          <span class="nb-hero__hint" data-hint-fine>Move across the letters. They rise to meet you.</span>
          <span class="nb-hero__hint" data-hint-coarse>Drag a finger across the letters. They rise to meet you.</span>
        </p>
        <dl class="nb-readout" aria-live="off">
          <div><dt>EDPT · depth</dt><dd data-hud-d>100</dd></div>
          <div><dt>EHLT · light</dt><dd data-hud-h>12</dd></div>
        </dl>
      </div>
    </header>

    <main>
      <!-- ============ TWO AXES ============ -->
      <section class="nb-sec nb-axes">
        <div class="nb-kicker"><span>01</span> Two axes, nothing else</div>
        <h2 class="nb-h2">No weights. No italics.<br />Just <em>how tall</em> and <em>how bright</em>.</h2>

        <div class="nb-axes__grid">
          <figure class="nb-stair" data-nb-inview>
            <div class="nb-stair__word nb">
              {[...'DEPTH'].map((ch, i) => (
                <span class="nb-stair__l" style={`--d:${depthSteps[i]};--h:12;--i:${i}`}>
                  {ch}<i>{depthSteps[i]}</i>
                </span>
              ))}
            </div>
            <figcaption>
              <b>Extrusion Depth</b> <code>EDPT 0 – 200</code>
              <p>At zero the letter is a flat neon outline. Every unit after that pulls it up off the page, until each stroke is a little tower block.</p>
            </figcaption>
          </figure>

          <figure class="nb-stair" data-nb-inview>
            <div class="nb-stair__word nb">
              {[...'LIGHT'].map((ch, i) => (
                <span class="nb-stair__l" style={`--d:130;--h:${lightSteps[i]};--i:${i}`}>
                  {ch}<i>{lightSteps[i]}</i>
                </span>
              ))}
            </div>
            <figcaption>
              <b>Edge Highlight</b> <code>EHLT 0 – 24</code>
              <p>A bevel of pure light along every front edge. Off, the blocks are matte. Wide open, they look freshly dipped in lacquer.</p>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ EXPLODED VIEW ============ -->
      <section class="nb-sec nb-layers">
        <div class="nb-kicker"><span>02</span> Under the paint</div>
        <h2 class="nb-h2">One letter is four drawings<br />stacked in the same spot.</h2>
        <p class="nb-lede">
          Nabla is a COLRv1 font: each glyph is a pile of shapes, each filled with a gradient from a shared palette.
          Hide all but a few palette slots — which CSS can do — and the letter comes apart in your hands.
        </p>

        <div class="nb-explode" data-nb-inview>
          {layers.map((l, i) => (
            <>
              <figure class="nb-explode__piece" style={`--i:${i}`}>
                <span class="nb nb-explode__g" style={`font-palette:--nb-layer-${l.id}`} aria-hidden="true">R</span>
                <figcaption>{l.label}</figcaption>
              </figure>
              <span class="nb-explode__op" aria-hidden="true">{i < layers.length - 1 ? '+' : '='}</span>
            </>
          ))}
          <figure class="nb-explode__piece nb-explode__piece--sum" style="--i:4">
            <span class="nb nb-explode__g" aria-hidden="true">R</span>
            <figcaption>R</figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ PALETTES ============ -->
      <section class="nb-sec nb-pals" id="palettes">
        <div class="nb-kicker"><span>03</span> Seven coats of paint, and room for yours</div>
        <h2 class="nb-h2">Pick one. The whole page<br />gets repainted.</h2>

        <div class="nb-pals__grid">
          <div class="nb-pals__left">
          <div class="nb-pals__chips" role="radiogroup" aria-label="Colour palette">
            {palettes.map((p, i) => (
              <button
                class="nb-chip"
                type="button"
                role="radio"
                aria-checked={i === 0 ? 'true' : 'false'}
                data-pal-btn={p.id}
                data-css={paletteCss(p)}
                style={`--chip:${p.accent}`}
              >
                <span class="nb nb-chip__g" style={`font-palette:--nb-${p.id}`} aria-hidden="true">N</span>
                <span class="nb-chip__name">{p.name}</span>
                <span class="nb-chip__note">{p.note}</span>
              </button>
            ))}
          </div>
          <p class="nb nb-pals__demo" aria-hidden="true">
            {[...'NEW'].map((c, i) => <span style={`--i:${i}`}>{c}</span>)}
            <span class="nb-pals__gap"></span>
            {[...'GAME'].map((c, i) => <span style={`--i:${i + 3}`}>{c}</span>)}
          </p>
          </div>

          <div class="nb-pals__code">
            <div class="nb-pals__codehead"><span>palette.css</span><span data-pal-name>Coin</span></div>
            <pre><code data-pal-code>{paletteCss(palettes[0])}

h1 {'{'}
  font-family: 'Nabla';
  font-palette: --nb-{palettes[0].id};
{'}'}</code></pre>
            <p class="nb-pals__codenote">
              This is the real rule driving the page. The two “mixed here” palettes aren’t in the font at all —
              they’re ten colours typed into <code>override-colors</code>.
            </p>
          </div>
        </div>
      </section>

      <!-- ============ IN USE ============ -->
      <section class="nb-sec nb-use">
        <div class="nb-kicker"><span>04</span> In the wild</div>
        <h2 class="nb-h2">It was born for a screen<br />that glows in the dark.</h2>

        <div class="nb-bento">
          <article class="nb-crt" data-nb-inview>
            <div class="nb-crt__screen">
              <p class="nb-crt__title nb">HIGH SCORES</p>
              <ol class="nb-crt__table">
                {scores.map((s, i) => (
                  <li class:list={['nb-crt__row', s.who === 'YOU' && 'nb-crt__row--you']} style={`--i:${i}`}>
                    <span class="nb">{s.rank}</span>
                    <span class="nb">{s.who}</span>
                    <span class="nb nb-crt__pts">{s.pts}</span>
                  </li>
                ))}
              </ol>
              <p class="nb-crt__coin nb">INSERT COIN</p>
            </div>
            <p class="nb-cap">Attract mode — a cabinet that never got built</p>
          </article>

          <article class="nb-poster">
            <div class="nb-poster__sheet">
              <p class="nb-poster__top">Sat 21 June · from 8 pm · free</p>
              <p class="nb-poster__word nb" aria-label="Block Party"><span>BLOCK</span><span>PARTY</span></p>
              <p class="nb-poster__foot"><span>Rooftop, level 9</span><span>Bring a friend &amp; a jumper</span></p>
            </div>
            <p class="nb-cap">Poster — it holds its own on paper white</p>
          </article>

          <article class="nb-clock" data-nb-clock>
            <div class="nb-clock__face">
              <p class="nb-clock__time nb" data-clock aria-label="Current time">
                <span>0</span><span>0</span><i>:</i><span>0</span><span>0</span><i>:</i><span>0</span><span>0</span>
              </p>
              <p class="nb-clock__sub">Your time, right now — every digit jumps as it lands</p>
            </div>
            <p class="nb-cap">Clock — figures, live</p>
          </article>
        </div>
      </section>

      <!-- ============ TESTER ============ -->
      <PosterWall slug="nabla" n="05" kicker="nb-kicker" sec="nb-sec" />
      <section class="nb-sec nb-test" data-nb-test>
        <div class="nb-kicker"><span>06</span> Your turn</div>
        <h2 class="nb-h2">Type something.<br />Watch it get built.</h2>

        <div class="nb-test__stage">
          <div class="nb-hero__floor nb-hero__floor--stage" aria-hidden="true"></div>
          <p class="nb-test__out nb" data-test-out aria-hidden="true"></p>
          <label class="nb-test__field">
            <span>Your words</span>
            <input type="text" data-test-in value="PRESS START" maxlength="28" spellcheck="false" autocomplete="off" />
          </label>
        </div>

        <div class="nb-test__ctl">
          <label><span>Depth <b data-test-dv>120</b></span><input type="range" min="0" max="200" value="120" data-test-d /></label>
          <label><span>Light <b data-test-hv>14</b></span><input type="range" min="0" max="24" value="14" data-test-h /></label>
          <label><span>Size <b data-test-sv>100</b>%</span><input type="range" min="40" max="160" value="100" data-test-s /></label>
          <button type="button" class="nb-btn" data-test-wave aria-pressed="false">Make a wave</button>
        </div>
      </section>

      <!-- ============ GLYPHS ============ -->
      <section class="nb-sec nb-glyphs">
        <div class="nb-kicker"><span>07</span> The blocks</div>
        <h2 class="nb-h2">Every key, a tiny building.</h2>
        <p class="nb-lede">Run a pointer over the set. Click any letter to see it large.</p>
        <div class="nb-keys" data-nb-keys data-nb-inview data-glyphroot>
          {glyphs.map((g, i) => (
            <button type="button" class="nb-key nb" data-glyph={g} style={`--i:${i % 13 + Math.floor(i / 13)}`} aria-label={`Inspect ${g}`}>{g}</button>
          ))}
        </div>
        <GlyphInspector family="Nabla Variable" />
      </section>

      <!-- ============ STORY + SPECS ============ -->
      <section class="nb-sec nb-story">
        <div class="nb-kicker"><span>08</span> The story</div>
        <div class="nb-story__grid">
          <div class="nb-story__prose">
            <p class="nb-story__lede">
              Nabla was drawn by <strong>Arthur Reinders Folmer</strong> of Typearture, with font engineering by
              <strong>Just van Rossum</strong>, and joined Google Fonts in 2022. Its look comes straight out of
              isometric computer games: chunky blocks seen from above and to one side, lit from a single corner.
            </p>
            <p>
              What makes it more than a novelty is the format underneath. For decades a font file held one thing
              per letter: an outline, filled with whatever single colour the page asked for. COLRv1 lets a glyph be
              a small composition instead — layers, gradients, a palette — and, crucially, lets all of that
              <em>vary</em>. Nabla was an early showpiece for the idea. Its extrusion is not an effect applied to
              letters; it is the letters, and it is drawn all the way from flat to towering.
            </p>
            <p>
              The result behaves like type, not like an image. It sets in a line, wraps, selects, scales without
              blur, and can be searched and read aloud. Change the palette and it is a different object; change one
              number and it stands up.
            </p>
          </div>

          <dl class="nb-specs">
            <div><dt>Design</dt><dd>Arthur Reinders Folmer (Typearture)</dd></div>
            <div><dt>Engineering</dt><dd>Just van Rossum</dd></div>
            <div><dt>Released</dt><dd>2022, Google Fonts</dd></div>
            <div><dt>Format</dt><dd>Variable colour font · COLRv1</dd></div>
            <div><dt>Axes</dt><dd><code>EDPT</code> 0–200 (default 100)<br /><code>EHLT</code> 0–24 (default 12)</dd></div>
            <div><dt>Palettes</dt><dd>7 built in, 10 colours each</dd></div>
            <div><dt>Scripts</dt><dd>Latin, Latin Extended, Vietnamese, Cyrillic Extended, maths symbols</dd></div>
            <div><dt>Styles</dt><dd>One. Regular.</dd></div>
            <div><dt>Licence</dt><dd>SIL Open Font License 1.1</dd></div>
            <div class="nb-specs__links">
              <a href="https://fonts.google.com/specimen/Nabla" rel="noopener">Get it on Google Fonts ↗</a>
              <a href="https://github.com/justvanrossum/nabla" rel="noopener">Source ↗</a>
            </div>
          </dl>
        </div>
        <p class="nb-compat">Colour and depth need a browser that draws COLRv1 — current Chrome, Edge and Firefox do.</p>
      </section>

      <!-- ============ NEXT ============ -->
      <a class="nb-next" href="/fonts/handjet">
        <span class="nb-next__k">Next →</span>
        <span class="nb-next__name" aria-label="Handjet">{[...'Handjet'].map((c, i) => <span style={`--i:${i}`} aria-hidden="true">{c}</span>)}</span>
        <span class="nb-next__sub">Every letter is a grid of one small shape.</span>
      </a>
    </main>
  </div>

  <SiteFooter />
</Layout>

<script>
  const page = document.querySelector<HTMLElement>('[data-nb]');
  if (page) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

    // ---------- In-view flags (start CSS choreography when a block arrives) ----------
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => e.target.classList.toggle('is-in', e.isIntersecting)),
      { threshold: 0.25 }
    );
    page.querySelectorAll('[data-nb-inview]').forEach((el) => io.observe(el));

    // ---------- Hero: per-letter depth follows the pointer; height sets the light ----------
    const hero = page.querySelector<HTMLElement>('[data-nb-hero]')!;
    const letters = Array.from(hero.querySelectorAll<HTMLElement>('[data-l]'));
    const hudD = hero.querySelector<HTMLElement>('[data-hud-d]')!;
    const hudH = hero.querySelector<HTMLElement>('[data-hud-h]')!;
    const hudScore = hero.querySelector<HTMLElement>('[data-hud-score]')!;
    const cur = letters.map(() => ({ d: 100, h: 12 }));
    let px = 0.5, py = 0.5, lastMove = -1e9, heroOn = true, score = 0;
    let centers: number[] = [];
    const measure = () => {
      const r = hero.getBoundingClientRect();
      centers = letters.map((l) => {
        const b = l.getBoundingClientRect();
        return (b.left + b.width / 2 - r.left) / r.width;
      });
    };
    measure();
    window.addEventListener('resize', measure);
    document.fonts?.ready.then(measure);

    const onMove = (e: PointerEvent) => {
      const r = hero.getBoundingClientRect();
      const nx = clamp((e.clientX - r.left) / r.width, 0, 1);
      const ny = clamp((e.clientY - r.top) / r.height, 0, 1);
      score += Math.round(Math.hypot(nx - px, ny - py) * 4000);
      px = nx; py = ny; lastMove = performance.now();
      hero.style.setProperty('--mx', `${(px * 100).toFixed(1)}%`);
      hero.style.setProperty('--my', `${(py * 100).toFixed(1)}%`);
    };
    hero.addEventListener('pointermove', onMove);
    hero.addEventListener('pointerdown', onMove);
    new IntersectionObserver((es) => { heroOn = es[0].isIntersecting; }).observe(hero);

    const tick = (now: number) => {
      requestAnimationFrame(tick);
      if (!heroOn) return;
      const live = now - lastMove < 2600;
      const t = now / 1000;
      let sumD = 0, sumH = 0;
      letters.forEach((l, i) => {
        let td: number, th: number;
        if (live) {
          const dist = Math.abs(centers[i] - px);
          const near = 1 - clamp(dist / 0.42, 0, 1);
          td = 12 + 188 * near * near * (3 - 2 * near);
          th = 24 * (1 - py) * (0.35 + 0.65 * near);
        } else if (reduce) {
          td = 60 + i * 30; th = 12;
        } else {
          td = 100 + 100 * Math.sin(t * 1.5 - i * 0.75);
          th = 12 + 12 * Math.sin(t * 0.8 - i * 0.4);
        }
        const c = cur[i];
        c.d += (td - c.d) * 0.14;
        c.h += (th - c.h) * 0.14;
        l.style.setProperty('--d', c.d.toFixed(1));
        l.style.setProperty('--h', c.h.toFixed(2));
        sumD += c.d; sumH += c.h;
      });
      hudD.textContent = String(Math.round(sumD / letters.length)).padStart(3, '0');
      hudH.textContent = String(Math.round(sumH / letters.length)).padStart(2, '0');
      hudScore.textContent = String(score % 1000000).padStart(6, '0');
    };
    requestAnimationFrame(tick);

    // ---------- Palettes: repaint the page, show the live rule ----------
    const palBtns = Array.from(page.querySelectorAll<HTMLButtonElement>('[data-pal-btn]'));
    const palCode = page.querySelector<HTMLElement>('[data-pal-code]')!;
    const palName = page.querySelector<HTMLElement>('[data-pal-name]')!;
    palBtns.forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.palBtn!;
        page.dataset.pal = id;
        palBtns.forEach((o) => o.setAttribute('aria-checked', String(o === b)));
        palName.textContent = b.querySelector('.nb-chip__name')!.textContent;
        palCode.textContent = `${b.dataset.css}\n\nh1 {\n  font-family: 'Nabla';\n  font-palette: --nb-${id};\n}`;
      })
    );

    // ---------- Clock: each digit pops when it changes ----------
    const clock = page.querySelector<HTMLElement>('[data-clock]');
    if (clock) {
      const digits = Array.from(clock.querySelectorAll('span'));
      const paint = () => {
        const n = new Date();
        const s = [n.getHours(), n.getMinutes(), n.getSeconds()].map((v) => String(v).padStart(2, '0')).join('');
        digits.forEach((el, i) => {
          if (el.textContent === s[i]) return;
          el.textContent = s[i];
          el.classList.remove('is-pop');
          void el.offsetWidth;
          el.classList.add('is-pop');
        });
      };
      paint();
      setInterval(paint, 250);
    }

    // ---------- Tester: letters are built one keystroke at a time ----------
    const test = page.querySelector<HTMLElement>('[data-nb-test]')!;
    const input = test.querySelector<HTMLInputElement>('[data-test-in]')!;
    const out = test.querySelector<HTMLElement>('[data-test-out]')!;
    const stage = test.querySelector<HTMLElement>('.nb-test__stage')!;
    let prev = '';
    const render = () => {
      const val = input.value;
      let keep = 0;
      while (keep < prev.length && keep < val.length && prev[keep] === val[keep]) keep++;
      while (out.children.length > keep) out.lastElementChild!.remove();
      for (let i = keep; i < val.length; i++) {
        const s = document.createElement('span');
        s.textContent = val[i] === ' ' ? ' ' : val[i];
        s.style.setProperty('--i', String(i));
        s.className = 'is-pop';
        out.appendChild(s);
      }
      prev = val;
    };
    input.addEventListener('input', render);
    render();
    stage.addEventListener('click', () => input.focus());

    const bind = (sel: string, valSel: string, apply: (v: number) => void) => {
      const el = test.querySelector<HTMLInputElement>(sel)!;
      const v = test.querySelector<HTMLElement>(valSel)!;
      const run = () => { v.textContent = el.value; apply(+el.value); };
      el.addEventListener('input', run);
      run();
    };
    bind('[data-test-d]', '[data-test-dv]', (v) => out.style.setProperty('--dset', String(v)));
    bind('[data-test-h]', '[data-test-hv]', (v) => out.style.setProperty('--hset', String(v)));
    bind('[data-test-s]', '[data-test-sv]', (v) => out.style.setProperty('--scale', String(v / 100)));
    const waveBtn = test.querySelector<HTMLButtonElement>('[data-test-wave]')!;
    waveBtn.addEventListener('click', () => {
      const on = waveBtn.getAttribute('aria-pressed') !== 'true';
      waveBtn.setAttribute('aria-pressed', String(on));
      waveBtn.textContent = on ? 'Hold still' : 'Make a wave';
      out.classList.toggle('is-wave', on);
    });
  }
</script>

