---
// INSTRUMENT SERIF — new edition. One weight, two styles, and a narrow body
// that fits more into a headline. Every example on this page is new.
import '../../styles/edition.css';
import PosterWall from '../../components/edition/PosterWall.astro';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EditionTester from '../../components/edition/EditionTester.astro';
import EditionTail from '../../components/edition/EditionTail.astro';
import { getEdition } from '../../lib/edition';

const { entry, font, prev, next, themeStyle } = await getEdition('instrument-serif');
const contents = [
  ['12', 'The last lighthouse keepers', 'Three people, one rock, and a job that was meant to end in 1998.'],
  ['28', 'Bread, again', 'Why every city seems to be falling in love with the same loaf.'],
  ['41', 'A short history of the pocket', 'It took four hundred years to sew one into a woman’s dress.'],
  ['56', 'Slow radio', 'The station that broadcasts nothing but rain, and its million listeners.'],
  ['70', 'In praise of the second draft', 'Six writers on the version nobody sees.'],
];
const quote = 'Most things worth reading were written slowly, by someone who expected to be ignored.';
const swaps = ['inbox', 'calendar', 'notes', 'weekends'];
---
<Layout title="Instrument Serif — Specimen" description={font.blurb} themeStyle={themeStyle} mode={font.theme.mode} fixedTheme>
  <SiteHeader current="Instrument Serif" showToggle={false} />
  <div class="ed is" data-is>
    <header class="ed-hero is-hero" data-hero>
      <div class="ed-hero__top"><span>Instrument Serif · {font.designer} · {font.year}</span><span>One weight. Roman & italic.</span></div>
      <h1 class="ed-hero__word is-hero__word" data-word aria-label="Instrument">
        {[...'Instrument'].map((c) => <span data-l aria-hidden="true"><b>{c}</b><i>{c}</i></span>)}
      </h1>
      <div class="ed-hero__foot">
        <p class="ed-hero__lede">
          No bold, no light. Just a roman, an italic, and <em>very good manners</em>.
          <span class="ed-hero__hint" data-fine>Move over the word. Letters near the pointer slip into italic, then straighten up when you leave.</span>
          <span class="ed-hero__hint" data-coarse>Drag across the word. Letters near your finger slip into italic.</span>
        </p>
        <dl class="ed-readout"><div><dt>roman</dt><dd data-hud="r">10</dd></div><div><dt>italic</dt><dd data-hud="i">0</dd></div></dl>
      </div>
    </header>

    <main>
      <section class="ed-sec" data-narrow>
        <div class="ed-kicker"><span>01</span> Why designers reach for it</div>
        <h2 class="ed-h2">Same size. Same words.<br /><em>Far less room.</em></h2>
        <p class="ed-lede">Below, one headline set at the same size twice: in Instrument Serif, and in Libre Baskerville, a typical book serif. The bars measure each line, live.</p>
        <div class="ed-body is-narrow">
          <div class="is-narrow__row">
            <p class="is-narrow__k">Instrument Serif</p>
            <p class="is-f is-narrow__line" data-n="a">The quiet return of the long walk</p>
            <span class="is-narrow__bar" data-nb="a"><i></i><b></b></span>
          </div>
          <div class="is-narrow__row">
            <p class="is-narrow__k">Libre Baskerville</p>
            <p class="is-narrow__line is-narrow__line--b" data-n="b">The quiet return of the long walk</p>
            <span class="is-narrow__bar" data-nb="b"><i></i><b></b></span>
          </div>
          <p class="is-narrow__sum" data-n-sum></p>
        </div>
      </section>

      <section class="ed-sec" data-site>
        <div class="ed-kicker"><span>02</span> On the web, everywhere</div>
        <h2 class="ed-h2">It became the face of<br />the <em>calm</em> product page.</h2>
        <div class="ed-body is-site">
          <div class="is-site__frame">
            <div class="is-site__bar" aria-hidden="true"><i></i><i></i><i></i><span>stillwater.app</span></div>
            <div class="is-site__page">
              <nav><b class="is-f">Stillwater</b><span>Product</span><span>Pricing</span><span>Journal</span><a>Sign in</a></nav>
              <p class="is-site__tag">New · Quiet mode for teams</p>
              <h3 class="is-f is-site__h">A calmer <span class="is-site__swap" data-swap aria-live="polite"><i>{swaps[0]}</i></span>,<br />without the noise.</h3>
              <p class="is-site__sub">Fewer pings, better summaries, and a weekly digest you might actually read.</p>
              <p class="is-site__cta"><a>Start free</a><a>See how it works →</a></p>
              <div class="is-site__card" aria-hidden="true">
                <p class="is-f">Good morning, Ines.</p>
                <ul><li><b>3 things</b> need you today</li><li><b>14</b> updates summarised</li><li><b>0</b> unread, by design</li></ul>
              </div>
            </div>
          </div>
          <script type="application/json" data-swaps set:html={JSON.stringify(swaps)} />
        </div>
        <p class="ed-cap">An invented product. The serif carries the headline; the sans does the small print.</p>
      </section>

      <section class="ed-sec">
        <div class="ed-kicker"><span>03</span> In the magazine</div>
        <h2 class="ed-h2">Roman says what it is.<br /><em>Italic tells you why.</em></h2>
        <ol class="ed-body is-toc">
          {contents.map(([n, t, s]) => <li><span class="is-f is-toc__n">{n}</span><span class="is-f is-toc__t">{t}</span><span class="is-f is-toc__s">{s}</span></li>)}
        </ol>
        <p class="ed-cap">Contents page for an invented quarterly. Hover a story.</p>
      </section>

      <section class="ed-sec is-quote" data-quote>
        <p class="is-f is-quote__q" aria-label={quote}>{quote.split(' ').map((w, i) => <span style={`--i:${i}`} aria-hidden="true">{w} </span>)}</p>
        <p class="is-quote__by">— Anonymous editor, probably tired</p>
      </section>

      <PosterWall slug="instrument-serif" n="04" kicker="ed-kicker" />
      <section class="ed-sec">
        <div class="ed-kicker"><span>05</span> Your turn</div>
        <h2 class="ed-h2">Two styles. <em>Choose well.</em></h2>
        <div class="ed-body">
          <EditionTester family="Instrument Serif" sample="Quietly, with conviction" axes={[]}
            presets={[{ name: 'Roman', v: [] }, { name: 'Italic', v: [], italic: true }]} start={1} />
        </div>
      </section>
      <EditionTail entry={entry} from={6} extra={[{ k: 'Styles', v: 'Regular and Italic' }]} />
    </main>
  </div>
  <SiteFooter prev={prev} next={next} />
</Layout>

<script>
  import { runHero, clamp } from '../../lib/hero';
  const page = document.querySelector<HTMLElement>('[data-is]');
  if (page) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---------- Hero: proximity crossfades each letter from roman to italic ----------
    const hero = page.querySelector<HTMLElement>('[data-hero]')!;
    const letters = Array.from(hero.querySelectorAll<HTMLElement>('[data-l]'));
    const hud = Object.fromEntries(Array.from(hero.querySelectorAll<HTMLElement>('[data-hud]')).map((e) => [e.dataset.hud!, e]));
    const k = letters.map(() => 0);
    runHero(hero, (f) => {
      const r = hero.getBoundingClientRect();
      let it = 0;
      letters.forEach((l, i) => {
        const b = l.getBoundingClientRect(), cx = (b.left + b.width / 2 - r.left) / r.width;
        const tk = f.live ? clamp(1 - Math.abs(cx - f.px) / 0.12, 0, 1) : f.reduce ? 0 : (Math.sin(f.t * 1.2 - i * 0.55) > 0.55 ? 1 : 0);
        k[i] += (tk - k[i]) * 0.14;
        l.style.setProperty('--k', k[i].toFixed(3));
        if (k[i] > 0.5) it++;
      });
      hud.r.textContent = String(letters.length - it); hud.i.textContent = String(it);
    });

    // ---------- Narrow: measure both lines ----------
    const nw = page.querySelector<HTMLElement>('[data-narrow]')!;
    const measureN = () => {
      const a = nw.querySelector<HTMLElement>('[data-n="a"]')!, b = nw.querySelector<HTMLElement>('[data-n="b"]')!;
      const wa = a.scrollWidth, wb = b.scrollWidth, max = Math.max(wa, wb, a.parentElement!.clientWidth);
      (['a', 'b'] as const).forEach((key) => {
        const w = key === 'a' ? wa : wb, bar = nw.querySelector<HTMLElement>(`[data-nb="${key}"]`)!;
        bar.querySelector('i')!.style.width = `${(w / max) * 100}%`;
        bar.querySelector('b')!.textContent = key === 'a' ? `${Math.round((wa / wb) * 100)}% of the width` : 'baseline';
      });
      nw.querySelector('[data-n-sum]')!.textContent = `Instrument Serif sets this line in ${Math.round((wa / wb) * 100)}% of the width. At the same column width, that is room for about ${Math.round((wb / wa - 1) * 100)}% more words.`;
    };
    document.fonts.ready.then(measureN); window.addEventListener('resize', measureN);

    // ---------- Product page: the italic word swaps ----------
    const swapEl = page.querySelector<HTMLElement>('[data-swap]')!;
    const words: string[] = JSON.parse(page.querySelector('[data-swaps]')!.textContent!);
    let wi = 0, siteOn = false;
    new IntersectionObserver((es) => { siteOn = es[0].isIntersecting; }, { threshold: 0.3 }).observe(page.querySelector('[data-site]')!);
    if (!reduce) setInterval(() => {
      if (!siteOn) return;
      wi = (wi + 1) % words.length;
      const old = swapEl.querySelector('i')!, nx = document.createElement('i');
      nx.textContent = words[wi]; nx.className = 'is-in';
      old.classList.add('is-out'); swapEl.appendChild(nx);
      swapEl.style.width = `${old.offsetWidth}px`;
      requestAnimationFrame(() => { swapEl.style.width = `${nx.scrollWidth}px`; });
      setTimeout(() => { old.remove(); nx.classList.remove('is-in'); swapEl.style.width = ''; }, 700);
    }, 2600);

    // ---------- Quote: words fade in as it scrolls into view ----------
    const q = page.querySelector<HTMLElement>('[data-quote]')!;
    new IntersectionObserver((es) => q.classList.toggle('is-in', es[0].isIntersecting), { threshold: 0.5 }).observe(q);
  }
</script>

<style is:global>
  .is { --ed-head: 'Instrument Serif', Georgia, serif; --ed-radius: 4px; }
  .is .ed-h2 { font-size: clamp(2.4rem, 1rem + 5.4vw, 6.6rem); letter-spacing: -0.02em; line-height: 0.96; }
  .is .ed-h2 em, .is .ed-hero__lede em { font-style: italic; }
  .is .ed-hero__lede { font-size: clamp(1.6rem, 1rem + 2.2vw, 3rem); line-height: 1.02; max-width: 18ch; letter-spacing: -0.01em; }
  .is-f { font-family: 'Instrument Serif', Georgia, serif; font-weight: 400; font-feature-settings: normal; }
  .is .ed-story__prose { font-family: 'Instrument Serif', serif; font-size: calc(var(--step-1) * 1.2); line-height: 1.4; }
  .is .ed-story__prose em { font-style: italic; }
  .is .ed-story__prose strong { font-weight: 400; font-style: italic; color: var(--accent); }

  /* ---------- hero ---------- */
  .is-hero { background: radial-gradient(70% 60% at 50% 45%, #fffaf0, transparent 70%), var(--bg); }
  .is-hero__word { display: flex; font-family: 'Instrument Serif', serif; font-size: min(21vw, 52svh); line-height: 1; letter-spacing: -0.035em; }
  .is-hero__word [data-l] { --k: 0; display: inline-grid; }
  .is-hero__word [data-l] > * { grid-area: 1 / 1; font-weight: 400; }
  .is-hero__word b { font-style: normal; opacity: calc(1 - var(--k)); filter: blur(calc(var(--k) * 3px)); }
  .is-hero__word i { font-style: italic; color: var(--accent); opacity: var(--k); filter: blur(calc((1 - var(--k)) * 3px)); transform: translateX(calc((1 - var(--k)) * -0.03em)); }

  /* ---------- narrow ---------- */
  .is-narrow { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.8rem; }
  .is-narrow__row { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.6rem; overflow: hidden; min-width: 0; }
  .is-narrow__k { font: 400 0.72rem/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-3); }
  .is-narrow__line { font-size: clamp(1.8rem, 5.6vw, 6rem); line-height: 1.05; white-space: nowrap; width: max-content; max-width: none; }
  .is-narrow__line--b { font-family: 'Libre Baskerville', Georgia, serif; color: var(--fg-3); letter-spacing: -0.02em; }
  .is-narrow__bar { display: flex; align-items: center; gap: 0.8rem; }
  .is-narrow__bar i { height: 6px; background: var(--accent); transition: width 0.6s var(--ease); }
  .is-narrow__row:nth-child(2) .is-narrow__bar i { background: var(--fg-3); }
  .is-narrow__bar b { font: 400 0.8rem/1 var(--font-mono); color: var(--fg-2); }
  .is-narrow__sum { font-family: 'Instrument Serif', serif; font-style: italic; font-size: var(--step-2); line-height: 1.2; max-width: 36ch; color: var(--accent); }

  /* ---------- product page ---------- */
  .is-site__frame { border-radius: 14px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 50px 90px -50px #211b1488; background: #fbf8f2; }
  .is-site__bar { display: flex; align-items: center; gap: 6px; padding: 0.7rem 1rem; background: #ece4d4; }
  .is-site__bar i { width: 10px; height: 10px; border-radius: 50%; background: #211b1430; }
  .is-site__bar span { margin-left: 1rem; padding: 0.25rem 1rem; border-radius: 100px; background: #fbf8f2; font: 400 0.72rem/1 var(--font-mono); color: #7c7361; }
  .is-site__page { position: relative; padding: clamp(1.2rem, 4vw, 3.5rem) clamp(1.2rem, 5vw, 4.5rem) clamp(2rem, 6vw, 5rem); font-family: 'Inter Variable', system-ui, sans-serif; font-variation-settings: 'wght' 420, 'opsz' 14; color: #211b14; overflow: hidden; }
  .is-site__page nav { display: flex; align-items: center; gap: 1.6rem; font-size: 0.85rem; color: #4d4536; margin-bottom: clamp(2rem, 6vw, 5rem); }
  .is-site__page nav b { font-size: 1.6rem; color: #211b14; margin-right: auto; letter-spacing: -0.01em; }
  .is-site__page nav a { padding: 0.45rem 0.9rem; border: 1px solid #211b1430; border-radius: 100px; }
  .is-site__tag { display: inline-block; padding: 0.3rem 0.8rem; border-radius: 100px; background: #8a332414; color: #8a3324; font-size: 0.8rem; font-variation-settings: 'wght' 550, 'opsz' 14; }
  .is-site__h { font-size: clamp(2.6rem, 7.6vw, 7.4rem); line-height: 0.95; letter-spacing: -0.03em; margin: 1.2rem 0 1.4rem; max-width: 12ch; }
  .is-site__swap { position: relative; display: inline-grid; vertical-align: bottom; transition: width 0.6s var(--ease); white-space: nowrap; }
  .is-site__swap i { grid-area: 1 / 1; font-style: italic; color: #8a3324; transition: opacity 0.5s, transform 0.6s var(--ease), filter 0.5s; }
  .is-site__swap i.is-out { opacity: 0; transform: translateY(-0.35em); filter: blur(4px); }
  .is-site__swap i.is-in { animation: is-in 0.6s var(--ease); }
  @keyframes is-in { from { opacity: 0; transform: translateY(0.35em); filter: blur(4px); } }
  .is-site__sub { max-width: 34ch; font-size: clamp(1rem, 0.8rem + 0.7vw, 1.3rem); line-height: 1.45; color: #4d4536; }
  .is-site__cta { display: flex; gap: 0.8rem; margin-top: 1.8rem; flex-wrap: wrap; }
  .is-site__cta a { padding: 0.8rem 1.3rem; border-radius: 100px; font-size: 0.92rem; font-variation-settings: 'wght' 560, 'opsz' 14; }
  .is-site__cta a:first-child { background: #211b14; color: #fbf8f2; }
  .is-site__card { position: absolute; right: clamp(1rem, 5vw, 4.5rem); bottom: clamp(2rem, 6vw, 5rem); width: min(42%, 22rem); padding: 1.3rem 1.4rem; border-radius: 16px; background: #fff; box-shadow: 0 30px 50px -30px #211b1466, 0 0 0 1px #211b1414; transform: rotate(2deg); }
  .is-site__card p { font-size: 1.8rem; line-height: 1.1; margin-bottom: 0.8rem; }
  .is-site__card ul { display: grid; gap: 0.5rem; font-size: 0.86rem; color: #4d4536; }
  .is-site__card b { font-weight: 400; font-variation-settings: 'wght' 650, 'opsz' 14; color: #211b14; }

  /* ---------- contents ---------- */
  .is-toc { border-top: 1px solid var(--fg); }
  .is-toc li { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 0.9fr); align-items: baseline; gap: 1.5rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line); transition: padding 0.4s var(--ease), background 0.4s; }
  .is-toc li:hover { padding-left: 0.8rem; background: var(--bg-2); }
  .is-toc__n { font-size: clamp(1.8rem, 3.4vw, 3rem); color: var(--accent); line-height: 1; }
  .is-toc__t { font-size: clamp(1.8rem, 3.8vw, 3.6rem); line-height: 1; letter-spacing: -0.02em; }
  .is-toc__s { font-style: italic; font-size: clamp(1.1rem, 1.5vw, 1.4rem); line-height: 1.3; color: var(--fg-2); }
  .is-toc li:hover .is-toc__t { font-style: italic; }

  /* ---------- quote ---------- */
  .is-quote { text-align: center; }
  .is-quote__q { font-size: clamp(2.2rem, 6.4vw, 6.8rem); line-height: 1.02; letter-spacing: -0.02em; max-width: 16ch; margin-inline: auto; }
  .is-quote__q span { display: inline; opacity: 0.12; transition: opacity 0.6s var(--ease); transition-delay: calc(var(--i) * 90ms); }
  .is-quote__q span:nth-child(3n + 2) { font-style: italic; }
  .is-quote.is-in .is-quote__q span { opacity: 1; }
  .is-quote__by { margin-top: 1.4rem; font: 400 0.74rem/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--fg-3); }
  @media (prefers-reduced-motion: reduce) { .is-quote__q span { opacity: 1; } }

  .is .ed-test__text { font-size: clamp(2.8rem, 8vw, 8.6rem); line-height: 0.98; letter-spacing: -0.02em; }

  @media (max-width: 900px) { .is-toc li { grid-template-columns: 3rem minmax(0, 1fr); } .is-toc__s { grid-column: 2; } .is-site__card { position: static; width: auto; margin-top: 2rem; transform: none; } .is-site__page nav span { display: none; } }
</style>
