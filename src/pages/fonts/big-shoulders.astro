---
// BIG SHOULDERS — new edition. Chicago after dark: a theatre marquee, a
// scoreboard, a platform sign. Every example on this page is new.
import '../../styles/edition.css';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EditionTester from '../../components/edition/EditionTester.astro';
import EditionTail from '../../components/edition/EditionTail.astro';
import { getEdition } from '../../lib/edition';

const { entry, font, prev, next, themeStyle } = await getEdition('big-shoulders');

const skyline = [...'BROADSHOULDERS'];
const stops = [
  { name: 'Division', mins: 2, tone: '#3b82f6' },
  { name: 'Clark & Lake', mins: 5, tone: '#f97316' },
  { name: 'Stockyards', mins: 9, tone: '#22c55e' },
  { name: 'Lakefront', mins: 14, tone: '#e11d48' },
];
---
<Layout title="Big Shoulders — Specimen" description={font.blurb} themeStyle={themeStyle} mode={font.theme.mode} fixedTheme>
  <SiteHeader current="Big Shoulders" showToggle={false} />

  <div class="ed bs" data-bs>
    <!-- ============ HERO ============ -->
    <header class="ed-hero bs-hero" data-hero>
      <div class="bs-hero__city" aria-hidden="true"></div>
      <div class="ed-hero__top"><span>Big Shoulders · Chicago · {font.year}</span><span>Thin 100 to Black 900</span></div>

      <h1 class="ed-hero__word bs-hero__word" data-word aria-label="Big Shoulders">
        <span class="bs-hero__row">{[...'BIG'].map((c) => <span data-l aria-hidden="true">{c}</span>)}</span>
        <span class="bs-hero__row">{[...'SHOULDERS'].map((c) => <span data-l aria-hidden="true">{c}</span>)}</span>
      </h1>

      <div class="ed-hero__foot">
        <p class="ed-hero__lede">
          Tall, narrow and built like <em>a steel frame</em>.
          <span class="ed-hero__hint" data-fine>Sweep across: the letters under the pointer bulk up to Black, the rest stand down to Thin.</span>
          <span class="ed-hero__hint" data-coarse>Drag across the name: letters under your finger bulk up to Black.</span>
        </p>
        <dl class="ed-readout">
          <div><dt>lightest</dt><dd data-hud="lo">100</dd></div>
          <div><dt>heaviest</dt><dd data-hud="hi">900</dd></div>
        </dl>
      </div>
    </header>

    <main>
      <!-- ============ MARQUEE ============ -->
      <section class="ed-sec">
        <div class="ed-kicker"><span>01</span> On the marquee</div>
        <h2 class="ed-h2">It was drawn to be read<br /><em>from across the street</em>.</h2>

        <div class="ed-body bs-marquee" data-inview>
          <div class="bs-marquee__bulbs" aria-hidden="true"></div>
          <div class="bs-marquee__face">
            <p class="bs-f bs-marquee__name">THE <b>RIALTO</b></p>
            <div class="bs-marquee__board">
              <p class="bs-f" style="--i:0">TONIGHT · ONE NIGHT ONLY</p>
              <p class="bs-f bs-marquee__big" style="--i:1">CITY OF BIG SHOULDERS</p>
              <p class="bs-f" style="--i:2">DOORS 7 · SHOW 8 · ALL AGES</p>
            </div>
          </div>
        </div>
        <p class="ed-cap">A fictional theatre. The bulbs chase; the headline pulses from Light to Black without the sign changing width much at all.</p>
      </section>

      <!-- ============ SKYLINE ============ -->
      <section class="ed-sec" data-skyline>
        <div class="ed-kicker"><span>02</span> One axis, a whole skyline</div>
        <h2 class="ed-h2">Nine weights.<br />Stack them and you get <em>a city</em>.</h2>
        <p class="ed-lede">Each letter is a building. Its height is its weight. Run a pointer along the street to raise them.</p>

        <div class="ed-body bs-sky" data-sky>
          <div class="bs-sky__row">
            {skyline.map((c, i) => (
              <span class="bs-sky__b" data-b style={`--i:${i}`}><i class="bs-f" aria-hidden="true">{c}</i><em data-bv>100</em></span>
            ))}
          </div>
          <div class="bs-sky__street" aria-hidden="true"></div>
        </div>
      </section>

      <!-- ============ SCOREBOARD + PLATFORM ============ -->
      <section class="ed-sec">
        <div class="ed-kicker"><span>03</span> At the game, on the platform</div>
        <h2 class="ed-h2">Numbers you can read<br /><em>at a dead run</em>.</h2>

        <div class="ed-body bs-duo">
          <figure class="bs-score" data-score>
            <div class="bs-score__board bs-f">
              <div class="bs-score__team"><span>HOME</span><b data-s-home>88</b></div>
              <div class="bs-score__mid">
                <span class="bs-score__q">Q<i data-s-q>4</i></span>
                <b class="bs-score__clock" data-s-clock>02:00</b>
                <span class="bs-score__shot" data-s-shot>24</span>
              </div>
              <div class="bs-score__team"><span>AWAY</span><b data-s-away>86</b></div>
            </div>
            <figcaption class="ed-cap">Scoreboard — the clock is running. Tap a score to add two.</figcaption>
          </figure>

          <figure class="bs-plat">
            <div class="bs-plat__sign bs-f">
              <p class="bs-plat__head"><span>NORTHBOUND</span><span>PLATFORM 2</span></p>
              <ul>
                {stops.map((s) => (
                  <li style={`--tone:${s.tone}`}><i></i><span>{s.name}</span><b>{s.mins}<small>MIN</small></b></li>
                ))}
              </ul>
            </div>
            <figcaption class="ed-cap">Platform sign — invented stops, real legibility</figcaption>
          </figure>
        </div>
      </section>

      <!-- ============ POSTER ============ -->
      <section class="ed-sec">
        <div class="ed-kicker"><span>04</span> On the wall</div>
        <h2 class="ed-h2">Fill the sheet.<br /><em>Leave no air.</em></h2>
        <div class="ed-body bs-poster" data-inview>
          <p class="bs-f bs-poster__l1">FRIDAY NIGHT</p>
          <p class="bs-f bs-poster__l2">FIGHTS</p>
          <p class="bs-f bs-poster__l3"><span>KOWALSKI</span><i>VS</i><span>ALVAREZ</span></p>
          <p class="bs-f bs-poster__l4">TEN ROUNDS · SOUTH SIDE ARMORY · FIRST BELL 9 PM · STANDING ROOM $8</p>
        </div>
        <p class="ed-cap">Fight poster — an invented card, set tight the way wood type was</p>
      </section>

      <!-- ============ TESTER ============ -->
      <section class="ed-sec">
        <div class="ed-kicker"><span>05</span> Your turn</div>
        <h2 class="ed-h2">Put <em>your name</em> in lights.</h2>
        <div class="ed-body">
          <EditionTester
            family="Big Shoulders Variable"
            sample="Hog butcher for the world"
            upper
            axes={[{ tag: 'wght', name: 'Weight', min: 100, max: 900 }, { tag: 'opsz', name: 'Optical size', min: 10, max: 72, step: 0.5 }]}
            presets={[
              { name: 'Headline', v: [800, 72] },
              { name: 'Hairline', v: [100, 72] },
              { name: 'Signage', v: [600, 40] },
              { name: 'Small print', v: [500, 10] },
              { name: 'Black', v: [900, 72] },
            ]}
          />
        </div>
      </section>

      <EditionTail entry={entry} from={6} />
    </main>
  </div>

  <SiteFooter prev={prev} next={next} />
</Layout>

<script>
  import { runHero, near, clamp, watchInView } from '../../lib/hero';
  const page = document.querySelector<HTMLElement>('[data-bs]');
  if (page) {
    watchInView(page);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---------- Hero: weight follows the pointer along each row ----------
    const hero = page.querySelector<HTMLElement>('[data-hero]')!;
    const rows = Array.from(hero.querySelectorAll<HTMLElement>('.bs-hero__row')).map((r) => Array.from(r.querySelectorAll<HTMLElement>('[data-l]')));
    const all = rows.flat();
    const w = all.map(() => 500);
    const hud = Object.fromEntries(Array.from(hero.querySelectorAll<HTMLElement>('[data-hud]')).map((e) => [e.dataset.hud!, e]));
    runHero(hero, (f) => {
      let k = 0, lo = 900, hi = 100;
      rows.forEach((row, r) => {
        const pos = clamp((f.px - 0.06) / 0.88, 0, 1) * (row.length - 1);
        row.forEach((l, i) => {
          const tw = f.live ? 100 + 800 * near(i, pos, row.length * 0.32) : f.reduce ? 700 : 500 + 400 * Math.sin(f.t * 1.4 - i * 0.6 - r * 1.7);
          w[k] += (tw - w[k]) * 0.16;
          l.style.fontVariationSettings = `'wght' ${w[k].toFixed(0)}, 'opsz' 72`;
          lo = Math.min(lo, w[k]); hi = Math.max(hi, w[k]); k++;
        });
      });
      hud.lo.textContent = String(Math.round(lo)); hud.hi.textContent = String(Math.round(hi));
    });

    // ---------- Skyline: height = weight ----------
    const sky = page.querySelector<HTMLElement>('[data-sky]')!;
    const blds = Array.from(sky.querySelectorAll<HTMLElement>('[data-b]'));
    const bw = blds.map(() => 100);
    let sx = -1, sLast = -1e9, skyOn = false;
    sky.addEventListener('pointermove', (e) => { const r = sky.getBoundingClientRect(); sx = (e.clientX - r.left) / r.width; sLast = performance.now(); });
    new IntersectionObserver((es) => { skyOn = es[0].isIntersecting; }).observe(sky);
    const skyTick = (now: number) => {
      requestAnimationFrame(skyTick);
      if (!skyOn) return;
      const live = now - sLast < 2400, t = now / 1000;
      const pos = sx * (blds.length - 1);
      blds.forEach((b, i) => {
        const tw = live ? 100 + 800 * near(i, pos, 3.2) : reduce ? 100 + 800 * Math.abs(Math.sin(i * 1.3)) : 500 + 400 * Math.sin(t * 0.9 + i * 1.9) * Math.cos(t * 0.37 + i * 0.6);
        bw[i] += (tw - bw[i]) * 0.12;
        const v = clamp(bw[i], 100, 900);
        b.style.setProperty('--h', ((v - 100) / 800).toFixed(3));
        (b.firstElementChild as HTMLElement).style.fontVariationSettings = `'wght' ${v.toFixed(0)}, 'opsz' 72`;
        b.lastElementChild!.textContent = String(Math.round(v / 10) * 10);
      });
    };
    requestAnimationFrame(skyTick);

    // ---------- Scoreboard ----------
    const sb = page.querySelector<HTMLElement>('[data-score]')!;
    const el = (k: string) => sb.querySelector<HTMLElement>(`[data-s-${k}]`)!;
    let clock = 120, shot = 24, home = 88, away = 86, q = 4;
    const bump = (e: HTMLElement) => { e.classList.remove('is-bump'); void e.offsetWidth; e.classList.add('is-bump'); };
    const paint = () => {
      el('clock').textContent = `${String(Math.floor(clock / 60)).padStart(2, '0')}:${String(clock % 60).padStart(2, '0')}`;
      el('shot').textContent = String(shot).padStart(2, '0');
      el('home').textContent = String(home); el('away').textContent = String(away); el('q').textContent = String(q);
      sb.classList.toggle('is-late', clock <= 10);
    };
    el('home').addEventListener('click', () => { home += 2; shot = 24; bump(el('home')); paint(); });
    el('away').addEventListener('click', () => { away += 2; shot = 24; bump(el('away')); paint(); });
    setInterval(() => {
      if (reduce) return;
      clock--; shot--;
      if (shot < 0) { shot = 24; if (Math.random() < 0.6) { if (Math.random() < 0.5) { home += 2; bump(el('home')); } else { away += 2; bump(el('away')); } } }
      if (clock < 0) { clock = 120; q = (q % 4) + 1; if (q === 1) { home = 0; away = 0; } }
      paint();
    }, 1000);
    paint();
  }
</script>

<style is:global>
  .bs { --ed-head: 'Big Shoulders Variable', 'Arial Narrow', sans-serif; --ed-head-vf: 'wght' 800, 'opsz' 72; --ed-em-vf: 'wght' 200, 'opsz' 72; --ed-lede-vf: 'wght' 650, 'opsz' 40; --ed-radius: 2px; --bulb: #ffd86b; }
  .bs .ed-h2, .bs .ed-hero__lede { text-transform: uppercase; letter-spacing: 0; line-height: 0.92; }
  .bs .ed-h2 { font-size: clamp(2.6rem, 1.2rem + 6vw, 7rem); }
  .bs .ed-hero__lede { font-size: clamp(1.8rem, 1rem + 2.8vw, 3.4rem); max-width: 16ch; }
  .bs em { font-style: normal; }
  .bs-f { font-family: 'Big Shoulders Variable', 'Arial Narrow', sans-serif; font-weight: 400; font-feature-settings: normal; text-transform: uppercase; }

  /* ---------- hero ---------- */
  .bs-hero__city { position: absolute; inset: 0; z-index: -1; background:
    linear-gradient(180deg, transparent 55%, color-mix(in srgb, var(--accent) 30%, transparent) 130%),
    repeating-linear-gradient(90deg, #ffffff07 0 2px, transparent 2px 68px); }
  .bs-hero__word { font-family: 'Big Shoulders Variable', sans-serif; display: grid; justify-items: center; font-size: min(23.5vw, 33svh); line-height: 0.84; text-transform: uppercase; color: var(--fg); }
  .bs-hero__row { display: flex; }
  .bs-hero__row:first-child { color: var(--accent); }

  /* ---------- marquee ---------- */
  .bs-marquee { position: relative; background: #1a0f0b; border-radius: 6px; box-shadow: 0 40px 90px -40px #ff6a2e88; }
  /* a ring of bulbs: a dotted border, glowing, that flickers between two brightnesses */
  .bs-marquee { --bd: clamp(9px, 1.3vw, 18px); padding: calc(var(--bd) * 2.2); }
  .bs-marquee__bulbs { position: absolute; inset: calc(var(--bd) * 0.6); border: var(--bd) dotted var(--bulb); border-radius: 4px; pointer-events: none; filter: drop-shadow(0 0 6px #ffb23e); }
  .bs-marquee.is-in .bs-marquee__bulbs { animation: bs-chase 0.5s steps(2, jump-none) infinite; }
  @keyframes bs-chase { to { border-color: #ff9f2e; filter: drop-shadow(0 0 2px #ff7a1a); opacity: 0.72; } }
  .bs-marquee__face { container-type: inline-size; background: #2a0f0a; padding: 3cqi 4cqi 4cqi; display: grid; gap: 2.4cqi; }
  .bs-marquee__name { text-align: center; font-size: 11cqi; line-height: 0.8; color: #ff5a36; font-variation-settings: 'wght' 200, 'opsz' 72; text-shadow: 0 0 0.12em #ff5a36aa; }
  .bs-marquee__name b { font-weight: inherit; font-variation-settings: 'wght' 900, 'opsz' 72; color: var(--bulb); text-shadow: 0 0 0.14em #ffb23eaa; }
  .bs-marquee__board { background: #f6efe2; color: #17120f; padding: 2.4cqi 3cqi; display: grid; gap: 0.6cqi; text-align: center; box-shadow: inset 0 0 0 0.5cqi #17120f; background-image: repeating-linear-gradient(0deg, transparent 0 calc(100% / 3 - 1px), #17120f22 calc(100% / 3 - 1px) calc(100% / 3)); }
  .bs-marquee__board p { font-size: 5.2cqi; line-height: 1; font-variation-settings: 'wght' 700, 'opsz' 72; letter-spacing: 0.06em; white-space: nowrap; }
  .bs-marquee__board .bs-marquee__big { font-size: 11.6cqi; letter-spacing: 0; color: #c22a14; font-variation-settings: 'wght' 900, 'opsz' 72; }
  .bs-marquee.is-in .bs-marquee__big { animation: bs-pulse 2.6s ease-in-out infinite alternate; }
  @keyframes bs-pulse { from { font-variation-settings: 'wght' 300, 'opsz' 72; } to { font-variation-settings: 'wght' 900, 'opsz' 72; } }

  /* ---------- skyline ---------- */
  .bs-sky { position: relative; padding-top: 1rem; background: linear-gradient(180deg, #0b1220, #1b2436 70%, #3a2a2a); overflow: hidden; touch-action: pan-y; }
  .bs-sky__row { display: grid; grid-template-columns: repeat(14, minmax(0, 1fr)); align-items: end; gap: clamp(2px, 0.5vw, 8px); height: clamp(16rem, 42vw, 34rem); padding-inline: clamp(0.5rem, 2vw, 2rem); }
  .bs-sky__b { --h: 0.5; position: relative; height: calc(28% + var(--h) * 72%); display: flex; flex-direction: column; justify-content: flex-start; align-items: center; overflow: hidden;
    background: repeating-linear-gradient(0deg, #ffd86b22 0 3px, transparent 3px 14px), repeating-linear-gradient(90deg, #0b1220 0 3px, transparent 3px 11px), #121a2a;
    box-shadow: inset 0 0 0 1px #ffffff14; }
  .bs-sky__b i { font-style: normal; font-size: clamp(2rem, 7.4vw, 7.6rem); line-height: 0.82; color: #ffd86b; padding-top: 0.08em; text-shadow: 0 0 0.2em #ffb23e66; }
  .bs-sky__b em { position: absolute; bottom: 0.4rem; font: 400 0.6rem/1 var(--font-mono); font-style: normal; color: #9fb0c8; }
  .bs-sky__street { height: 10px; background: repeating-linear-gradient(90deg, #ffd86b 0 28px, transparent 28px 56px) 0 50% / auto 2px no-repeat, #0a0a0c; }

  /* ---------- scoreboard + platform ---------- */
  .bs-duo { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(1rem, 2.4vw, 2.4rem); align-items: start; }
  .bs-score__board { container-type: inline-size; background: #050506; border-radius: 10px; padding: 5cqi 4cqi; display: grid; grid-template-columns: 1fr auto 1fr; gap: 3cqi; align-items: center; box-shadow: inset 0 0 0 1px #ffffff1f, inset 0 0 0 0.9cqi #141418; }
  .bs-score__team { display: grid; justify-items: center; }
  .bs-score__team span { font-size: 5cqi; font-variation-settings: 'wght' 600, 'opsz' 40; letter-spacing: 0.14em; color: #9aa3ab; }
  .bs-score__team b { font-size: 30cqi; line-height: 0.82; font-weight: 400; font-variation-settings: 'wght' 800, 'opsz' 72; font-variant-numeric: tabular-nums; color: #ffb000; text-shadow: 0 0 0.12em #ffb00077; cursor: pointer; }
  .bs-score__team:last-child b { color: #f3efe6; text-shadow: 0 0 0.12em #ffffff55; }
  .bs-score__team b.is-bump { animation: bs-bump 0.6s var(--ease); }
  @keyframes bs-bump { 0% { font-variation-settings: 'wght' 100, 'opsz' 72; } 40% { font-variation-settings: 'wght' 900, 'opsz' 72; transform: scale(1.06); } 100% { font-variation-settings: 'wght' 800, 'opsz' 72; } }
  .bs-score__mid { display: grid; justify-items: center; gap: 1cqi; }
  .bs-score__q { font-size: 5cqi; font-variation-settings: 'wght' 600, 'opsz' 40; color: #9aa3ab; letter-spacing: 0.1em; }
  .bs-score__q i { font-style: normal; color: #f3efe6; }
  .bs-score__clock { font-size: 15cqi; line-height: 0.9; font-weight: 400; font-variation-settings: 'wght' 500, 'opsz' 72; font-variant-numeric: tabular-nums; color: #ff3b30; text-shadow: 0 0 0.14em #ff3b3088; }
  .bs-score.is-late .bs-score__clock { animation: bs-late 1s steps(2, jump-none) infinite; font-variation-settings: 'wght' 900, 'opsz' 72; }
  @keyframes bs-late { to { opacity: 0.35; } }
  .bs-score__shot { font-size: 8cqi; line-height: 1; font-variation-settings: 'wght' 700, 'opsz' 72; font-variant-numeric: tabular-nums; color: #6dff7a; }

  .bs-plat__sign { container-type: inline-size; background: #10151b; color: #f3f5f6; border-top: 2.4cqi solid var(--accent); padding: 4cqi 5cqi 3cqi; }
  .bs-plat__head { display: flex; justify-content: space-between; font-size: 5.4cqi; font-variation-settings: 'wght' 500, 'opsz' 30; letter-spacing: 0.12em; color: #9aa3ab; padding-bottom: 2cqi; border-bottom: 1px solid #ffffff2e; }
  .bs-plat__sign li { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 3cqi; padding: 1.6cqi 0; border-bottom: 1px solid #ffffff1a; }
  .bs-plat__sign li i { width: 4.4cqi; height: 9cqi; background: var(--tone); }
  .bs-plat__sign li span { font-size: 12.5cqi; line-height: 0.95; font-variation-settings: 'wght' 700, 'opsz' 72; white-space: nowrap; transition: font-variation-settings 0.5s var(--ease); }
  .bs-plat__sign li:hover span { font-variation-settings: 'wght' 900, 'opsz' 72; }
  .bs-plat__sign li b { font-size: 12.5cqi; line-height: 0.95; font-weight: 400; font-variation-settings: 'wght' 300, 'opsz' 72; color: var(--bulb); font-variant-numeric: tabular-nums; }
  .bs-plat__sign small { font-size: 0.3em; font-variation-settings: 'wght' 700, 'opsz' 20; letter-spacing: 0.1em; margin-left: 0.3em; }

  /* ---------- poster ---------- */
  .bs-poster { container-type: inline-size; background: #e9dcc0; color: #17120f; padding: 3cqi 3.5cqi 2.6cqi; text-align: center; overflow: hidden; background-image: radial-gradient(#17120f10 1px, transparent 1.3px); background-size: 7px 7px; }
  .bs-poster p { white-space: nowrap; line-height: 0.84; }
  .bs-poster__l1 { font-size: 13.6cqi; font-variation-settings: 'wght' 300, 'opsz' 72; letter-spacing: 0.115em; margin-right: -0.115em; }
  .bs-poster__l2 { font-size: 43.5cqi; font-variation-settings: 'wght' 900, 'opsz' 72; color: #c22a14; line-height: 0.8 !important; }
  .bs-poster.is-in .bs-poster__l2 { animation: bs-pulse 3s ease-in-out infinite alternate-reverse; }
  .bs-poster__l3 { display: flex; justify-content: space-between; align-items: center; font-size: 14.2cqi; font-variation-settings: 'wght' 800, 'opsz' 72; padding-top: 1cqi; }
  .bs-poster__l3 i { font-style: normal; font-size: 0.45em; font-variation-settings: 'wght' 200, 'opsz' 72; color: #c22a14; }
  .bs-poster__l4 { font-size: 3.35cqi; font-variation-settings: 'wght' 700, 'opsz' 16; letter-spacing: 0.05em; padding-top: 2cqi; margin-top: 1.6cqi; border-top: 0.5cqi solid #17120f; line-height: 1 !important; }

  .bs .ed-story__prose p:first-child { font-family: 'Big Shoulders Variable', sans-serif; font-variation-settings: 'wght' 600, 'opsz' 30; font-size: 1.55em; line-height: 1.16; }

  @media (max-width: 900px) {
    .bs-duo { grid-template-columns: minmax(0, 1fr); }
    .bs-sky__b em { display: none; }
  }
</style>
