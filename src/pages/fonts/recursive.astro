---
// RECURSIVE — new edition. A hand-built page; the face is also in the `fonts`
// collection. Everything below the site header is set in this one font file:
// headings, labels, body text, the code editor and the sign.
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GlyphInspector from '../../components/specimen/GlyphInspector.astro';

const axes = [
  {
    tag: 'MONO', name: 'Monospace', min: 0, max: 1, step: 0.01, from: 'Sans', to: 'Mono', word: 'Minimal fill',
    desc: 'Sans to Mono. Every glyph slides onto a fixed width, so one family sets both the interface and the editor beside it.',
  },
  {
    tag: 'CASL', name: 'Casual', min: 0, max: 1, step: 0.01, from: 'Linear', to: 'Casual', word: 'Casual',
    desc: 'Linear to Casual. Strokes soften and curl, as if the letters stopped being ruled and started being painted with a brush.',
  },
  {
    tag: 'wght', name: 'Weight', min: 300, max: 1000, step: 1, from: 'Light 300', to: 'ExtraBlack 1000', word: 'Weight',
    desc: 'Light to ExtraBlack. Watch the ends of the word: it gets heavier without getting any wider.',
  },
  {
    tag: 'slnt', name: 'Slant', min: -15, max: 0, step: 0.1, from: '−15°', to: 'Upright', word: 'Slant',
    desc: 'Upright to a fifteen-degree lean, and every angle in between.',
  },
  {
    tag: 'CRSV', name: 'Cursive', min: 0, max: 1, step: 0.5, from: 'Roman forms', to: 'Cursive forms', word: 'a quirky fig',
    desc: 'Swaps letters like a, f, g and i for handwritten shapes. Left at the default 0.5, the font decides for itself as the text slants.',
  },
];

const weights = [300, 400, 500, 600, 700, 800, 900, 1000];

const wave =
  'Most typefaces get wider as they get bolder, so text reflows the moment you emphasise it. Recursive keeps every letter on the same footprint from Light to ExtraBlack. Menus stay put on hover. Columns of figures stay in line. And this paragraph can do the wave without a single word changing lines.'
    .split(' ');

const presets = [
  { name: 'Sans Linear',  v: [0, 0, 400, 0, 0.5] },
  { name: 'Mono Linear',  v: [1, 0, 400, 0, 0.5] },
  { name: 'Terminal',     v: [1, 0, 300, 0, 0] },
  { name: 'Friendly UI',  v: [0, 0.6, 600, 0, 0.5] },
  { name: 'Marker',       v: [1, 1, 750, -9, 1] },
  { name: 'Sign painter', v: [0, 1, 1000, -13, 1] },
];

const glyphs = [
  ...'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
  ...'abcdefghijklmnopqrstuvwxyz',
  ...'0123456789',
  ...'!?&@#$%*+=/(){}[]<>€£',
];

const builds = [
  { name: 'web-app', branch: 'main', state: 'Passed', time: '1m 42s', size: '312.4 kB' },
  { name: 'api', branch: 'main', state: 'Passed', time: '0m 58s', size: '88.1 kB' },
  { name: 'docs', branch: 'type-refresh', state: 'Running', time: '0m 12s', size: '—' },
  { name: 'design-tokens', branch: 'main', state: 'Passed', time: '0m 07s', size: '4.6 kB' },
];

const themeStyle = [
  '--bg:#fbf6e9', '--bg-2:#f1e9d6', '--fg:#1a1723', '--fg-2:#4c4759', '--fg-3:#7a7488',
  '--accent:#e8391a', '--accent-contrast:#fbf6e9', '--line:#1a172326', '--line-soft:#1a172312',
  'color-scheme:light',
].join(';');
---
<Layout
  title="Recursive — Specimen"
  description="Recursive, a five-axis variable font that runs from monospaced code to a sign-painter’s casual brush, shown live."
  themeStyle={themeStyle}
  mode="light"
  fixedTheme
>
  <SiteHeader current="Recursive" showToggle={false} />

  <div class="rc-page" data-rc>

    <!-- ============ HERO ============ -->
    <header class="rc-hero" data-rc-hero>
      <div class="rc-hero__grid" aria-hidden="true"></div>
      <div class="rc-hero__wash" aria-hidden="true"></div>

      <div class="rc-hero__top rc-m">
        <span>Recursive · Arrow Type · 2020</span>
        <span>One file · five axes</span>
      </div>

      <h1 class="rc-hero__word" data-hero-word aria-label="Recursive">
        {[...'Recursive'].map((ch, i) => <span data-l style={`--i:${i}`} aria-hidden="true">{ch}</span>)}
      </h1>

      <div class="rc-hero__foot">
        <p class="rc-hero__lede">
          From code editor to sign-painter’s brush, without changing font.
          <span class="rc-hero__hint rc-m" data-hint-fine>Move: sideways for Casual, near a letter for Weight, fast for Slant. Click for Mono.</span>
          <span class="rc-hero__hint rc-m" data-hint-coarse>Drag across the word. Tap to switch Sans and Mono.</span>
        </p>
        <dl class="rc-dials rc-m">
          <div><dt>MONO</dt><dd data-hud="mono">0.00</dd></div>
          <div><dt>CASL</dt><dd data-hud="casl">0.00</dd></div>
          <div><dt>wght</dt><dd data-hud="wght">400</dd></div>
          <div><dt>slnt</dt><dd data-hud="slnt">0.0</dd></div>
          <div><dt>CRSV</dt><dd>auto</dd></div>
        </dl>
      </div>
    </header>

    <main>
      <!-- ============ FIVE DIALS ============ -->
      <section class="rc-sec">
        <div class="rc-kicker rc-m"><span>01</span> Five dials</div>
        <h2 class="rc-h2">Most fonts give you a weight slider.<br />This one gives you <em>a mixing desk</em>.</h2>

        <div class="rc-axes">
          {axes.map((a) => (
            <article class={`rc-axis rc-axis--${a.tag.toLowerCase()}`} data-axis={a.tag.toLowerCase()} data-rc-inview>
              <div class="rc-axis__meta">
                <p class="rc-axis__tag rc-m">{a.tag}</p>
                <h3>{a.name}</h3>
                <p class="rc-axis__desc">{a.desc}</p>
              </div>
              <div class="rc-axis__demo">
                <p class="rc-axis__word" data-axis-word aria-hidden="true">{a.word}</p>
                <label class="rc-axis__slider rc-m">
                  <span>{a.from}</span>
                  <input type="range" min={a.min} max={a.max} step={a.step} value={a.tag === 'slnt' ? 0 : a.min} aria-label={`${a.name} axis`} data-axis-input />
                  <span>{a.to}</span>
                </label>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ============ SAME WIDTH ============ -->
      <section class="rc-sec">
        <div class="rc-kicker rc-m"><span>02</span> The trick</div>
        <h2 class="rc-h2">Make it bold.<br /><em>Nothing moves.</em></h2>

        <div class="rc-plex">
          <div class="rc-plex__stack" aria-label="The same line at eight weights, all exactly the same width">
            {weights.map((w) => (
              <p style={`--wght:${w}`} aria-hidden="true"><span>Eight weights, one width</span><i class="rc-m">{w}</i></p>
            ))}
          </div>
          <div class="rc-plex__para" data-rc-inview>
            <p aria-label={wave.join(' ')}>
              {wave.map((w, i) => <><span style={`--i:${i}`} aria-hidden="true">{w}</span>{' '}</>)}
            </p>
            <p class="rc-plex__note rc-m">↑ live text, weight animating from 300 to 1000 — watch the line breaks</p>
          </div>
        </div>
      </section>

      <!-- ============ IN USE ============ -->
      <section class="rc-sec">
        <div class="rc-kicker rc-m"><span>03</span> In use</div>
        <h2 class="rc-h2">Built for the screen you work in,<br />borrowed from <em>the shop window</em>.</h2>

        <div class="rc-bento">
          <article class="rc-code" data-rc-code>
            <header class="rc-code__bar rc-m">
              <span class="rc-code__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span>fib.js</span>
              <span class="rc-code__switch" role="group" aria-label="Editor voice">
                <button type="button" data-code-casl="0" aria-pressed="true">Linear</button>
                <button type="button" data-code-casl="1" aria-pressed="false">Casual</button>
              </span>
            </header>
<pre class="rc-code__pre"><code><span class="c">// To understand recursion,</span>
<span class="c">// first understand recursion.</span>
<span class="k">function</span> <span class="f">fib</span>(n) {'{'}
  <span class="k">if</span> (n &lt; <span class="n">2</span>) <span class="k">return</span> n;
  <span class="k">return</span> <span class="f">fib</span>(n - <span class="n">1</span>) + <span class="f">fib</span>(n - <span class="n">2</span>);
{'}'}

<span class="k">const</span> weights = [<span class="n">300</span>, <span class="n">400</span>, <span class="n">700</span>, <span class="n">1000</span>];
<span class="k">const</span> label = <span class="s">'same width, every weight'</span>;

weights.<span class="f">map</span>((w) =&gt; <span class="f">fib</span>(w / <span class="n">100</span>)); <span class="c">// [2, 3, 13, 55]</span><span class="rc-code__caret" aria-hidden="true"></span></code></pre>
            <p class="rc-cap rc-m">Editor — comments in Casual cursive, keywords in Bold, and the columns never drift</p>
          </article>

          <article class="rc-sign">
            <div class="rc-sign__board">
              <p class="rc-sign__small">Fresh daily</p>
              <p class="rc-sign__big"><span>Open</span><span>Late!</span></p>
              <p class="rc-sign__row"><span>Coffee</span><i>✦</i><span>Pie</span><i>✦</i><span>Wi-Fi</span></p>
            </div>
            <p class="rc-cap rc-m">Shop sign — Casual ExtraBlack, slanted, cursive on</p>
          </article>

          <article class="rc-ui">
            <div class="rc-ui__card">
              <header><b>Builds</b><span class="rc-m">today</span></header>
              <table>
                <tbody>
                  {builds.map((b) => (
                    <tr>
                      <td><b>{b.name}</b><small class="rc-m">{b.branch}</small></td>
                      <td><span class:list={['rc-ui__chip', b.state === 'Running' && 'is-run']}>{b.state}</span></td>
                      <td class="rc-m rc-ui__num">{b.time}</td>
                      <td class="rc-m rc-ui__num">{b.size}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="rc-cap rc-m">Interface — Sans for names, Mono for figures, one family</p>
          </article>
        </div>
      </section>

      <!-- ============ TESTER ============ -->
      <section class="rc-sec" data-rc-test>
        <div class="rc-kicker rc-m"><span>04</span> Your turn</div>
        <h2 class="rc-h2">Take the desk.</h2>

        <div class="rc-test">
          <div class="rc-test__stage">
            <div class="rc-test__text" contenteditable="plaintext-only" spellcheck="false" role="textbox" aria-label="Sample text — editable" data-test-text>Type here, then turn the dials</div>
          </div>
          <div class="rc-test__panel">
            <div class="rc-test__presets">
              {presets.map((p, i) => (
                <button type="button" class="rc-m" data-preset={JSON.stringify(p.v)} aria-pressed={i === 0 ? 'true' : 'false'}>{p.name}</button>
              ))}
            </div>
            <div class="rc-test__sliders">
              {axes.map((a, i) => (
                <label class="rc-m">
                  <span>{a.tag} <b data-test-val={i}></b></span>
                  <input type="range" min={a.min} max={a.max} step={a.tag === 'CRSV' ? 0.5 : a.step} data-test-ax={i} />
                </label>
              ))}
            </div>
            <pre class="rc-test__css rc-m"><code data-test-css></code></pre>
          </div>
        </div>
      </section>

      <!-- ============ GLYPHS ============ -->
      <section class="rc-sec">
        <div class="rc-kicker rc-m"><span>05</span> The set</div>
        <h2 class="rc-h2">Every key has <em>a wild side</em>.</h2>
        <p class="rc-lede">Shown here in Mono Linear Light. Run a pointer over the grid; click a letter to see it large.</p>
        <div class="rc-keys" data-glyphroot>
          {glyphs.map((g) => <button type="button" class="rc-key" data-glyph={g} aria-label={`Inspect ${g}`}>{g}</button>)}
        </div>
        <GlyphInspector family="Recursive Variable" variable wghtMin={300} wghtMax={1000} />
      </section>

      <!-- ============ STORY + SPECS ============ -->
      <section class="rc-sec">
        <div class="rc-kicker rc-m"><span>06</span> The story</div>
        <div class="rc-story">
          <div class="rc-story__prose">
            <p class="rc-story__lede">
              Recursive is led by <strong>Stephen Nixon</strong> at Arrow Type, a foundry in Brooklyn, and came to
              Google Fonts in 2020. Its starting point is not another typeface but a trade: <em>single-stroke
              casual</em>, the quick, warm brush lettering sign painters use for shop windows and price cards.
            </p>
            <p>
              The idea was to bring that energy to the least hand-made places type lives — code editors, dashboards,
              technical documentation. So the family has two poles. <strong>Linear</strong> is crisp and regular,
              the voice of a well-kept terminal. <strong>Casual</strong> lets the brush back in. Both exist as a
              proportional Sans and a fixed-width Mono, and all of it sits in one file, with every point between
              the poles available.
            </p>
            <p>
              The quiet engineering feat is the one you saw above: across weight, the letters keep the same width.
              In an interface that means emphasis never nudges a layout; in code it means a bold keyword can’t
              knock a column out of line.
            </p>
            <p>
              The cut on Google Fonts is a slimmed-down one. The full family, with code ligatures and a drawer of
              alternate letters, lives at recursive.design.
            </p>
          </div>

          <dl class="rc-specs">
            <div><dt class="rc-m">Design</dt><dd>Stephen Nixon, Arrow Type</dd></div>
            <div><dt class="rc-m">On Google Fonts</dt><dd>Since May 2020</dd></div>
            <div><dt class="rc-m">Format</dt><dd>Variable font, five axes</dd></div>
            <div><dt class="rc-m">Axes</dt><dd class="rc-m rc-specs__axes">MONO 0–1<br />CASL 0–1<br />wght 300–1000<br />slnt −15–0<br />CRSV 0 · 0.5 · 1</dd></div>
            <div><dt class="rc-m">Scripts</dt><dd>Latin, Latin Extended, Vietnamese, Cyrillic Extended</dd></div>
            <div><dt class="rc-m">Good at</dt><dd>Code, interfaces, documentation — and signs</dd></div>
            <div><dt class="rc-m">Licence</dt><dd>SIL Open Font License 1.1</dd></div>
            <div class="rc-specs__links rc-m">
              <a href="https://fonts.google.com/specimen/Recursive" rel="noopener">Get it on Google Fonts ↗</a>
              <a href="https://github.com/arrowtype/recursive" rel="noopener">Source ↗</a>
            </div>
          </dl>
        </div>
      </section>

      <a class="rc-next" href="/fonts/climate-crisis">
        <span class="rc-next__k">Next →</span>
        <span class="rc-next__name">Climate Crisis</span>
        <span class="rc-next__sub">One axis, measured in years.</span>
      </a>
    </main>
  </div>

  <SiteFooter />
</Layout>

<script>
  const page = document.querySelector<HTMLElement>('[data-rc]');
  if (page) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

    // ---------- In-view flags start the CSS choreography ----------
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => e.target.classList.toggle('is-in', e.isIntersecting)),
      { threshold: 0.2 }
    );
    page.querySelectorAll('[data-rc-inview]').forEach((el) => io.observe(el));

    // ---------- Hero: the pointer plays four axes at once ----------
    const hero = page.querySelector<HTMLElement>('[data-rc-hero]')!;
    const word = hero.querySelector<HTMLElement>('[data-hero-word]')!;
    const letters = Array.from(word.querySelectorAll<HTMLElement>('[data-l]'));
    const hud = Object.fromEntries(
      Array.from(hero.querySelectorAll<HTMLElement>('[data-hud]')).map((el) => [el.dataset.hud!, el])
    );
    const w = letters.map(() => 400);
    let px = 0.5, speed = 0, lastMove = -1e9, lastT = 0, on = true;
    let casl = 0, slnt = 0, mono = 0, monoTarget = 0;
    let centers: number[] = [];
    const measure = () => {
      const r = hero.getBoundingClientRect();
      centers = letters.map((l) => { const b = l.getBoundingClientRect(); return (b.left + b.width / 2 - r.left) / r.width; });
    };
    measure();
    window.addEventListener('resize', measure);
    document.fonts?.ready.then(measure);
    hero.addEventListener('pointermove', (e) => {
      const r = hero.getBoundingClientRect();
      const nx = clamp((e.clientX - r.left) / r.width, 0, 1);
      const now = performance.now();
      const dt = Math.max(now - lastT, 8);
      speed = Math.max(speed, Math.abs(nx - px) / dt * 900);
      px = nx; lastT = now; lastMove = now;
    });
    hero.addEventListener('click', () => { monoTarget = monoTarget ? 0 : 1; setTimeout(measure, 700); });
    new IntersectionObserver((es) => { on = es[0].isIntersecting; }).observe(hero);

    const tick = (now: number) => {
      requestAnimationFrame(tick);
      if (!on) return;
      const live = now - lastMove < 2600;
      const t = now / 1000;
      let tc: number, ts: number, sum = 0;
      if (live) { tc = px; ts = -15 * clamp(speed, 0, 1); }
      else if (reduce) { tc = 0.5; ts = 0; }
      else { tc = 0.5 - 0.5 * Math.cos(t * 0.55); ts = -7.5 + 7.5 * Math.cos(t * 0.8); }
      speed *= 0.93;
      casl += (tc - casl) * 0.1;
      slnt += (ts - slnt) * 0.1;
      mono += (monoTarget - mono) * 0.12;
      letters.forEach((l, i) => {
        let tw: number;
        if (live) { const near = 1 - clamp(Math.abs(centers[i] - px) / 0.3, 0, 1); tw = 300 + 700 * near * near * (3 - 2 * near); }
        else if (reduce) tw = 300 + i * 85;
        else tw = 650 + 350 * Math.sin(t * 1.7 - i * 0.62);
        w[i] += (tw - w[i]) * 0.16;
        l.style.setProperty('--wght', w[i].toFixed(0));
        sum += w[i];
      });
      word.style.setProperty('--casl', casl.toFixed(3));
      word.style.setProperty('--slnt', slnt.toFixed(2));
      word.style.setProperty('--mono', mono.toFixed(3));
      hero.style.setProperty('--k', casl.toFixed(3));
      hud.mono.textContent = mono.toFixed(2);
      hud.casl.textContent = casl.toFixed(2);
      hud.wght.textContent = String(Math.round(sum / letters.length));
      hud.slnt.textContent = slnt.toFixed(1);
    };
    requestAnimationFrame(tick);

    // ---------- Axis rows: they animate on their own until you grab the slider ----------
    page.querySelectorAll<HTMLElement>('[data-axis]').forEach((row) => {
      const input = row.querySelector<HTMLInputElement>('[data-axis-input]')!;
      const target = row.querySelector<HTMLElement>('[data-axis-word]')!;
      input.addEventListener('input', () => {
        row.classList.add('is-manual');
        target.style.setProperty(`--${row.dataset.axis}`, input.value);
      });
    });

    // ---------- Code editor voice ----------
    const code = page.querySelector<HTMLElement>('[data-rc-code]')!;
    const codeBtns = Array.from(code.querySelectorAll<HTMLButtonElement>('[data-code-casl]'));
    codeBtns.forEach((b) =>
      b.addEventListener('click', () => {
        code.style.setProperty('--casl', b.dataset.codeCasl!);
        codeBtns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      })
    );

    // ---------- Tester ----------
    const test = page.querySelector<HTMLElement>('[data-rc-test]')!;
    const text = test.querySelector<HTMLElement>('[data-test-text]')!;
    const css = test.querySelector<HTMLElement>('[data-test-css]')!;
    const sliders = Array.from(test.querySelectorAll<HTMLInputElement>('[data-test-ax]'));
    const vals = Array.from(test.querySelectorAll<HTMLElement>('[data-test-val]'));
    const presetBtns = Array.from(test.querySelectorAll<HTMLButtonElement>('[data-preset]'));
    const names = ['mono', 'casl', 'wght', 'slnt', 'crsv'];
    const tags = ['MONO', 'CASL', 'wght', 'slnt', 'CRSV'];
    const apply = () => {
      sliders.forEach((s, i) => {
        text.style.setProperty(`--${names[i]}`, s.value);
        vals[i].textContent = s.value;
      });
      css.textContent =
        `font-family: 'Recursive';\nfont-variation-settings:\n` +
        sliders.map((s, i) => `  '${tags[i]}' ${s.value}`).join(',\n') + ';';
    };
    const set = (v: number[]) => { sliders.forEach((s, i) => (s.value = String(v[i]))); apply(); };
    sliders.forEach((s) => s.addEventListener('input', () => {
      presetBtns.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      apply();
    }));
    presetBtns.forEach((b) => b.addEventListener('click', () => {
      presetBtns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      set(JSON.parse(b.dataset.preset!));
    }));
    set(JSON.parse(presetBtns[0].dataset.preset!));
    if (text.contentEditable !== 'plaintext-only') text.contentEditable = 'true';
    text.addEventListener('keydown', (e) => { if (e.key === 'Enter') e.preventDefault(); });
  }
</script>

<style is:global>
  /* Registered so each axis can be transitioned and keyframed like any number. */
  @property --mono { syntax: '<number>'; inherits: true; initial-value: 0; }
  @property --casl { syntax: '<number>'; inherits: true; initial-value: 0; }
  @property --wght { syntax: '<number>'; inherits: true; initial-value: 400; }
  @property --slnt { syntax: '<number>'; inherits: true; initial-value: 0; }
  @property --crsv { syntax: '<number>'; inherits: true; initial-value: 0.5; }

  .rc-page {
    --blue: #2743e6;
    --ink: #1a1723;
    font-family: 'Recursive Variable', system-ui, sans-serif;
    font-feature-settings: normal;
    background: var(--bg);
    color: var(--fg);
  }
  /* font-variation-settings inherits as a computed string, so every element
     re-declares it and reads the five inherited numbers for itself. */
  .rc-page, .rc-page * {
    font-variation-settings: 'MONO' var(--mono), 'CASL' var(--casl), 'wght' var(--wght), 'slnt' var(--slnt), 'CRSV' var(--crsv);
  }
  .rc-page code, .rc-page pre, .rc-page button, .rc-page input, .rc-page table { font-family: inherit; }
  .rc-m { --mono: 1; --casl: 0; --slnt: 0; font-size: 0.74rem; letter-spacing: 0.04em; }
  .rc-page b, .rc-page strong { --wght: 750; font-weight: inherit; }
  .rc-page em { font-style: normal; }

  /* ---------- hero ---------- */
  .rc-hero {
    --k: 0;
    position: relative; isolation: isolate; overflow: hidden;
    min-height: calc(100svh - 64px);
    display: grid; grid-template-rows: auto 1fr auto;
    padding: clamp(1rem, 2.5vw, 2rem) var(--gutter) clamp(1.5rem, 3vw, 2.5rem);
    cursor: pointer; touch-action: pan-y;
    border-bottom: 2px solid var(--ink);
  }
  .rc-hero__grid {
