---
// MARTIAN MONO — new edition. Mission control: a planet drawn in characters,
// a live terminal, and a telemetry wall. Every example on this page is new.
import '../../styles/edition.css';
import PosterWall from '../../components/edition/PosterWall.astro';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EditionTester from '../../components/edition/EditionTester.astro';
import EditionTail from '../../components/edition/EditionTail.astro';
import { getEdition } from '../../lib/edition';

const { entry, font, prev, next, themeStyle } = await getEdition('martian-mono');

const gauges = [
  { id: 'alt', label: 'Altitude', unit: 'km' },
  { id: 'vel', label: 'Velocity', unit: 'm/s' },
  { id: 'tmp', label: 'Hull temp', unit: '°C' },
  { id: 'o2', label: 'Oxygen', unit: '%' },
  { id: 'pwr', label: 'Power', unit: 'kW' },
  { id: 'sig', label: 'Signal', unit: 'dB' },
];
---
<Layout title="Martian Mono — Specimen" description={font.blurb} themeStyle={themeStyle} mode={font.theme.mode} fixedTheme>
  <SiteHeader current="Martian Mono" showToggle={false} />

  <div class="ed mm" data-mm>
    <!-- ============ HERO ============ -->
    <header class="ed-hero mm-hero" data-hero>
      <div class="mm-hero__stars" aria-hidden="true"></div>
      <div class="ed-hero__top"><span>Martian Mono · Evil Martians · {font.year}</span><span>Monospaced, with a width axis</span></div>

      <h1 class="ed-hero__word mm-hero__word" data-word aria-label="Martian Mono">
        <span class="mm-hero__row"><i aria-hidden="true">&gt;</i>{[...'Martian'].map((c) => <span data-l aria-hidden="true">{c}</span>)}</span>
        <span class="mm-hero__row">{[...'Mono'].map((c) => <span data-l aria-hidden="true">{c}</span>)}<b class="mm-hero__caret" aria-hidden="true"></b></span>
      </h1>

      <div class="ed-hero__foot">
        <p class="ed-hero__lede">
          Every character gets <em>the same seat</em>. Then the seats get wider.
          <span class="ed-hero__hint" data-fine>Move sideways to widen every cell, near a letter to make it bolder.</span>
          <span class="ed-hero__hint" data-coarse>Drag across the name to widen the cells and bolden the letters.</span>
        </p>
        <dl class="ed-readout">
          <div><dt>wdth</dt><dd data-hud="wdth">100</dd></div>
          <div><dt>wght</dt><dd data-hud="wght">400</dd></div>
        </dl>
      </div>
    </header>

    <main>
      <!-- ============ PLANET ============ -->
      <section class="ed-sec">
        <div class="ed-kicker"><span>01</span> Drawn in characters</div>
        <h2 class="ed-h2">Give every letter the same box<br />and you can <em>draw with them</em>.</h2>
        <p class="ed-lede">
          This is live text: about two thousand characters, redrawn twenty times a second. It only holds together
          because each one is exactly as wide as its neighbours. Drag to turn the planet.
        </p>

        <div class="ed-body mm-planet" data-planet>
          <pre class="mm-f mm-planet__art" data-planet-art aria-label="A rotating planet drawn in text characters"></pre>
          <dl class="mm-planet__read mm-f">
            <div><dt>SOL</dt><dd data-p-sol>0412</dd></div>
            <div><dt>LON</dt><dd data-p-lon>000.0°</dd></div>
            <div><dt>CHARS</dt><dd data-p-n>0</dd></div>
            <div><dt>CELL</dt><dd>1 × 1</dd></div>
          </dl>
        </div>
      </section>

      <!-- ============ TERMINAL ============ -->
      <section class="ed-sec">
        <div class="ed-kicker"><span>02</span> In the terminal</div>
        <h2 class="ed-h2">Built by people who stare<br />at code <em>all day</em>.</h2>

        <div class="ed-body mm-term" data-term>
          <header class="mm-f"><span><i></i><i></i><i></i></span><span>rover@ares-4: ~/mission</span><span data-term-state>running</span></header>
          <pre class="mm-f mm-term__out" data-term-out aria-live="off"></pre>
        </div>
        <p class="ed-cap">An invented mission log, typed live. Columns line up without a single tab stop.</p>
      </section>

      <!-- ============ TELEMETRY ============ -->
      <section class="ed-sec">
        <div class="ed-kicker"><span>03</span> On the wall</div>
        <h2 class="ed-h2">Numbers that change<br />without <em>jumping around</em>.</h2>

        <div class="ed-body mm-wall" data-wall>
          {gauges.map((g) => (
            <article class="mm-gauge mm-f" data-g={g.id}>
              <p class="mm-gauge__k">{g.label}</p>
              <p class="mm-gauge__v"><b data-gv>0</b><span>{g.unit}</span></p>
              <p class="mm-gauge__bar" data-gb aria-hidden="true"></p>
            </article>
          ))}
        </div>
        <p class="ed-cap">Simulated telemetry. Every figure is the same width, so nothing shifts when a 1 becomes an 8.</p>
      </section>

      <!-- ============ WIDTH ============ -->
      <section class="ed-sec" data-cols>
        <div class="ed-kicker"><span>04</span> The unusual part</div>
        <h2 class="ed-h2">A monospace you can<br /><em>squeeze</em>.</h2>
        <p class="ed-lede">Need more columns in a narrow pane? Slide the width down and they fit. Need air? Slide it up. The ruler counts what fits on one line.</p>

        <div class="ed-body mm-cols">
          <div class="mm-cols__pane">
            <p class="mm-f mm-cols__ruler" data-cols-ruler aria-hidden="true"></p>
            <p class="mm-f mm-cols__line" data-cols-line>the quick brown rover jumps over the lazy crater and files its report before sundown on sol four hundred and twelve</p>
            <span class="mm-f mm-cols__probe" data-cols-probe aria-hidden="true">0000000000</span>
          </div>
          <div class="mm-cols__ctl">
            <label class="ed-slider"><span>Width <b data-cols-val>100</b></span><input type="range" min="75" max="112" step="0.5" value="100" data-cols-input /></label>
            <p class="mm-f mm-cols__count"><b data-cols-n>80</b> columns</p>
          </div>
        </div>
      </section>

      <!-- ============ TESTER ============ -->
      <PosterWall slug="martian-mono" n="05" kicker="ed-kicker" />
      <section class="ed-sec">
        <div class="ed-kicker"><span>06</span> Your turn</div>
        <h2 class="ed-h2">Open <em>a channel</em>.</h2>
        <div class="ed-body">
          <EditionTester
            family="Martian Mono Variable"
            sample="Houston, we have a typeface"
            axes={[{ tag: 'wght', name: 'Weight', min: 100, max: 800 }, { tag: 'wdth', name: 'Width', min: 75, max: 112, step: 0.5 }]}
            presets={[
              { name: 'Code', v: [400, 100] },
              { name: 'Condensed log', v: [300, 75] },
              { name: 'Wide display', v: [800, 112] },
              { name: 'Hairline', v: [100, 112] },
              { name: 'Alert', v: [800, 75] },
            ]}
            start={2}
          />
        </div>
      </section>

      <EditionTail entry={entry} from={7} />
    </main>
  </div>

  <SiteFooter prev={prev} next={next} />
</Layout>

<script>
  import { runHero, near, clamp } from '../../lib/hero';
  const page = document.querySelector<HTMLElement>('[data-mm]');
  if (page) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const inView = (el: Element, cb: (v: boolean) => void) => new IntersectionObserver((es) => cb(es[0].isIntersecting), { threshold: 0.1 }).observe(el);

    // ---------- Hero ----------
    const hero = page.querySelector<HTMLElement>('[data-hero]')!;
    const word = hero.querySelector<HTMLElement>('[data-word]')!;
    const rows = Array.from(word.querySelectorAll<HTMLElement>('.mm-hero__row')).map((r) => Array.from(r.querySelectorAll<HTMLElement>('[data-l]')));
    const w = rows.flat().map(() => 400);
    const hud = Object.fromEntries(Array.from(hero.querySelectorAll<HTMLElement>('[data-hud]')).map((e) => [e.dataset.hud!, e]));
    let wd = 100;
    runHero(hero, (f) => {
      const td = f.live ? 75 + 37 * clamp((f.px - 0.08) / 0.84, 0, 1) : f.reduce ? 100 : 93.5 + 18.5 * Math.sin(f.t * 0.6);
      wd += (td - wd) * 0.1;
      let k = 0, sum = 0;
      rows.forEach((row, r) => {
        const pos = clamp((f.px - 0.1) / 0.8, 0, 1) * 7 - (r ? 0 : 1);
        row.forEach((l, i) => {
          const tw = f.live ? 100 + 700 * near(i, pos, 2.2) : f.reduce ? 500 : 450 + 350 * Math.sin(f.t * 1.5 - (i + r * 3) * 0.7);
          w[k] += (tw - w[k]) * 0.15;
          l.style.fontVariationSettings = `'wght' ${w[k].toFixed(0)}, 'wdth' ${wd.toFixed(1)}`;
          sum += w[k]; k++;
        });
      });
      word.style.fontVariationSettings = `'wght' 400, 'wdth' ${wd.toFixed(1)}`;
      hud.wdth.textContent = wd.toFixed(0);
      hud.wght.textContent = String(Math.round(sum / k));
    });

    // ---------- Planet: a lit, textured sphere rendered as text ----------
    const pl = page.querySelector<HTMLElement>('[data-planet]')!;
    const art = pl.querySelector<HTMLElement>('[data-planet-art]')!;
    const RAMP = ' .·:-=+*o#%@';
    const small = window.innerWidth < 700;
    const W = small ? 46 : 78, H = small ? 23 : 37;
    let lon = 0, spin = 0.5, drag = false, lastX = 0, plOn = false, lastFrame = 0;
    // cheap repeatable surface: a few overlapping "continents" and craters
    const surface = (la: number, lo: number) =>
      0.5 + 0.25 * Math.sin(lo * 3 + Math.sin(la * 4) * 1.4) + 0.18 * Math.sin(la * 7 + lo * 2) + 0.12 * Math.cos(lo * 9 - la * 3);
    const draw = () => {
      let out = '', n = 0;
      const K = 1.68, R = Math.min(W / K, H) / 2 * 0.94;
      for (let y = 0; y < H; y++) {
        for (let x = 0; x < W; x++) {
          const dx = (x - W / 2 + 0.5) / K, dy = y - H / 2 + 0.5; // K: how much taller a cell is than wide
          const rad = Math.sqrt(dx * dx + dy * dy) / R;
          if (rad > 1) {
            // sparse fixed stars, plus a small moon on a tilted orbit
            const mx = Math.cos(lon * 0.6) * R * 1.55, my = Math.sin(lon * 0.6) * R * 0.35, behind = Math.sin(lon * 0.6) < 0;
            const md = Math.hypot(dx - mx, dy - my);
            if (md < 1.6 && !(behind && rad < 1)) { out += md < 0.9 ? 'O' : 'o'; n++; }
            else { const s = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453; out += (s - Math.floor(s)) > 0.985 ? '.' : ' '; }
            continue;
          }
          const nx = dx / R, ny = dy / R, nz = Math.sqrt(Math.max(0, 1 - nx * nx - ny * ny));
          const la = Math.asin(ny), lo = Math.atan2(nx, nz) + lon;
          const light = Math.max(0, nx * -0.55 + ny * -0.35 + nz * 0.76);
          const polar = Math.abs(ny) > 0.86 ? 0.35 : 0;
          const v = clamp(light * (0.45 + 0.75 * surface(la, lo)) + polar * light, 0, 0.999);
          out += RAMP[Math.floor(v * RAMP.length)]; n++;
        }
        out += '\n';
      }
      art.textContent = out;
      pl.querySelector('[data-p-lon]')!.textContent = `${(((lon * 180) / Math.PI) % 360 + 360) % 360 | 0}`.padStart(3, '0') + '.0°';
      pl.querySelector('[data-p-n]')!.textContent = String(n);
    };
    inView(pl, (v) => (plOn = v));
    pl.addEventListener('pointerdown', (e) => { drag = true; lastX = e.clientX; pl.setPointerCapture(e.pointerId); });
    pl.addEventListener('pointermove', (e) => { if (!drag) return; lon -= (e.clientX - lastX) * 0.012; spin = -(e.clientX - lastX) * 0.2; lastX = e.clientX; });
    const up = () => { drag = false; }; pl.addEventListener('pointerup', up); pl.addEventListener('pointercancel', up);
    const spinLoop = (now: number) => {
      requestAnimationFrame(spinLoop);
      if (!plOn || now - lastFrame < 50) return;
      const dt = Math.min(0.1, (now - lastFrame) / 1000); lastFrame = now;
      if (!drag) { spin += (0.5 - spin) * 0.03; if (!reduce) lon += spin * dt; }
      draw();
    };
    draw(); requestAnimationFrame(spinLoop);

    // ---------- Terminal: types an aligned log, then loops ----------
    const term = page.querySelector<HTMLElement>('[data-term]')!;
    const out = term.querySelector<HTMLElement>('[data-term-out]')!;
    const pad = (s: string, n: number) => s.padEnd(n);
    const LOG: [string, string][] = [
      ['cmd', '$ ./ares status --all'],
      ['dim', pad('SUBSYSTEM', 16) + pad('STATE', 10) + pad('LOAD', 8) + 'LAST CONTACT'],
      ['ok',  pad('navigation', 16) + pad('nominal', 10) + pad('12%', 8) + '00:00:04 ago'],
      ['ok',  pad('life-support', 16) + pad('nominal', 10) + pad('38%', 8) + '00:00:04 ago'],
      ['warn', pad('drill-arm', 16) + pad('warming', 10) + pad('71%', 8) + '00:01:12 ago'],
      ['ok',  pad('comms', 16) + pad('nominal', 10) + pad('09%', 8) + '00:00:01 ago'],
      ['cmd', '$ ./ares sample --site "Jezero West" --depth 0.4m'],
      ['dim', '  drilling  [##########################------]  81%'],
      ['dim', '  drilling  [################################] 100%'],
      ['ok',  '  sample 0412-A sealed · 14.2 g · basalt, trace hematite'],
      ['cmd', '$ git commit -m "sol 412: first core from the delta"'],
      ['ok',  '  [main 4f1a9c2] sol 412: first core from the delta'],
      ['cmd', '$ ./ares sleep --until sunrise'],
      ['warn', '  good night, rover.'],
    ];
    let li = 0, ci = 0, termOn = false, lines: HTMLElement[] = [];
    inView(term, (v) => (termOn = v));
    const step = () => {
      const [kind, text] = LOG[li];
      if (ci === 0) { const s = document.createElement('span'); s.className = `is-${kind}`; out.appendChild(s); out.appendChild(document.createTextNode('\n')); lines.push(s); }
      const el = lines[lines.length - 1];
      const chunk = kind === 'cmd' ? 1 : 6;
      ci = Math.min(text.length, ci + chunk); el.textContent = text.slice(0, ci);
      if (ci >= text.length) { li++; ci = 0; if (li >= LOG.length) { li = 0; return 3200; } return kind === 'cmd' ? 420 : 140; }
      return kind === 'cmd' ? 34 : 14;
    };
    const run = () => {
      if (!termOn) return setTimeout(run, 300);
      if (li === 0 && ci === 0) { out.textContent = ''; lines = []; }
      setTimeout(run, step());
    };
    if (reduce) { out.textContent = LOG.map((l) => l[1]).join('\n'); } else run();

    // ---------- Telemetry ----------
    const wall = page.querySelector<HTMLElement>('[data-wall]')!;
    const G: Record<string, { v: number; lo: number; hi: number; d: number; f: (v: number) => string }> = {
      alt: { v: 412.6, lo: 380, hi: 440, d: 0.9, f: (v) => v.toFixed(1).padStart(5, '0') },
      vel: { v: 3421, lo: 3300, hi: 3550, d: 14, f: (v) => String(Math.round(v)).padStart(4, '0') },
      tmp: { v: -63.2, lo: -90, hi: -20, d: 1.1, f: (v) => (v < 0 ? '−' : '+') + Math.abs(v).toFixed(1).padStart(4, '0') },
      o2: { v: 96.4, lo: 88, hi: 100, d: 0.25, f: (v) => v.toFixed(1).padStart(5, '0') },
      pwr: { v: 1.84, lo: 0.6, hi: 2.4, d: 0.05, f: (v) => v.toFixed(2) },
      sig: { v: -71, lo: -98, hi: -52, d: 1.6, f: (v) => '−' + String(Math.round(Math.abs(v))).padStart(3, '0') },
    };
    let wallOn = false; inView(wall, (v) => (wallOn = v));
    const paintWall = () => wall.querySelectorAll<HTMLElement>('[data-g]').forEach((card) => {
      const g = G[card.dataset.g!];
      g.v = clamp(g.v + (Math.random() - 0.5) * 2 * g.d, g.lo, g.hi);
      const t = (g.v - g.lo) / (g.hi - g.lo), n = Math.round(t * 24);
      card.querySelector('[data-gv]')!.textContent = g.f(g.v);
      card.querySelector('[data-gb]')!.textContent = '█'.repeat(n) + '░'.repeat(24 - n);
      card.classList.toggle('is-hot', t > 0.86 || t < 0.1);
    });
    paintWall();
    if (!reduce) setInterval(() => { if (wallOn) paintWall(); }, 420);

    // ---------- Columns ----------
    const cols = page.querySelector<HTMLElement>('[data-cols]')!;
    const cin = cols.querySelector<HTMLInputElement>('[data-cols-input]')!;
    const pane = cols.querySelector<HTMLElement>('.mm-cols__pane')!;
    const probe = cols.querySelector<HTMLElement>('[data-cols-probe]')!;
    const ruler = cols.querySelector<HTMLElement>('[data-cols-ruler]')!;
    const paintCols = () => {
      pane.style.setProperty('--wd', cin.value);
      cols.querySelector('[data-cols-val]')!.textContent = cin.value;
      const n = Math.floor((pane.clientWidth - 2 * parseFloat(getComputedStyle(pane).paddingLeft)) / (probe.getBoundingClientRect().width / 10));
      cols.querySelector('[data-cols-n]')!.textContent = String(n);
      let r = ''; for (let i = 1; i <= n; i++) r += i % 10 === 0 ? String((i / 10) % 10) : i % 5 === 0 ? '+' : '·';
      ruler.textContent = r;
    };
    cin.addEventListener('input', paintCols); window.addEventListener('resize', paintCols);
    document.fonts.ready.then(paintCols); paintCols();
  }
</script>

<style is:global>
  .mm { --ed-head: 'Martian Mono Variable', ui-monospace, monospace; --ed-head-vf: 'wght' 700, 'wdth' 80; --ed-em-vf: 'wght' 300, 'wdth' 112; --ed-lede-vf: 'wght' 500, 'wdth' 80; --ed-radius: 6px; --mars: #ff7a45; }
  .mm .ed-h2 { font-size: clamp(1.6rem, 0.9rem + 3.1vw, 3.9rem); letter-spacing: -0.03em; line-height: 1.08; }
  .mm .ed-hero__lede { font-size: clamp(1.1rem, 0.8rem + 1.2vw, 1.8rem); letter-spacing: -0.03em; line-height: 1.25; max-width: 26ch; }
  .mm em { font-style: normal; }
  .mm-f { font-family: 'Martian Mono Variable', ui-monospace, monospace; font-weight: 400; font-feature-settings: normal; }

  /* ---------- hero ---------- */
  .mm-hero__stars { position: absolute; inset: 0; z-index: -1; background:
    radial-gradient(60% 50% at 78% 108%, #ff7a4555, transparent 70%),
    radial-gradient(1px 1px at 12% 22%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 31% 64%, #fff9 50%, transparent 51%),
    radial-gradient(1.5px 1.5px at 57% 18%, #fff 50%, transparent 51%), radial-gradient(1px 1px at 72% 41%, #fff8 50%, transparent 51%),
    radial-gradient(1px 1px at 88% 12%, #fff 50%, transparent 51%), radial-gradient(1.5px 1.5px at 44% 83%, #fff7 50%, transparent 51%),
    radial-gradient(1px 1px at 6% 78%, #fff9 50%, transparent 51%), radial-gradient(1px 1px at 93% 66%, #fff 50%, transparent 51%); }
  .mm-hero__word { font-family: 'Martian Mono Variable', monospace; display: grid; justify-items: start; font-size: min(13.2vw, 30svh); line-height: 1.02; letter-spacing: -0.02em; color: var(--fg); }
  .mm-hero__row { display: flex; align-items: baseline; }
  .mm-hero__row i { font-style: normal; color: var(--accent); margin-right: 0.3em; font-variation-settings: 'wght' 300, 'wdth' 75; }
  .mm-hero__row:last-child { padding-left: 1.05em; color: var(--accent); }
  .mm-hero__caret { width: 0.56em; height: 0.82em; margin-left: 0.12em; background: var(--accent); align-self: center; animation: mm-blink 1.1s steps(2, jump-none) infinite; }
  @keyframes mm-blink { to { opacity: 0; } }

  /* ---------- planet ---------- */
  .mm-planet { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: clamp(1rem, 3vw, 3rem); padding: clamp(0.8rem, 2.4vw, 2.4rem); background: radial-gradient(70% 70% at 40% 50%, #1b1410, #06080b 70%); border: 1px solid var(--line); border-radius: 10px; cursor: grab; touch-action: pan-y; user-select: none; overflow: hidden; }
  .mm-planet:active { cursor: grabbing; }
  .mm-planet__art { font-size: clamp(0.5rem, 1.28vw, 1.22rem); line-height: 1.05; font-variation-settings: 'wght' 600, 'wdth' 100; color: var(--mars); text-shadow: 0 0 0.6em #ff7a4566; white-space: pre; margin: 0; text-align: center; }
  .mm-planet__read { display: grid; gap: 1.2rem; }
  .mm-planet__read dt { font-size: 0.66rem; letter-spacing: 0.14em; color: var(--fg-3); }
  .mm-planet__read dd { font-size: clamp(1rem, 1.9vw, 1.7rem); font-variation-settings: 'wght' 300, 'wdth' 90; color: var(--accent); white-space: nowrap; }

  /* ---------- terminal ---------- */
  .mm-term { background: #06080b; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; box-shadow: 0 40px 90px -50px #ffb45455; }
  .mm-term header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0.7rem 1rem; border-bottom: 1px solid var(--line); font-size: 0.68rem; color: var(--fg-3); font-variation-settings: 'wght' 400, 'wdth' 85; }
  .mm-term header span:first-child { display: flex; gap: 6px; }
  .mm-term header i { width: 10px; height: 10px; border-radius: 50%; background: #ffffff26; }
  .mm-term header span:last-child { text-align: right; color: #7dd87d; }
  .mm-term__out { margin: 0; padding: clamp(1rem, 2.4vw, 2rem); min-height: 15.5lh; font-size: clamp(0.62rem, 0.35rem + 0.9vw, 1.02rem); line-height: 1.75; font-variation-settings: 'wght' 400, 'wdth' 100; white-space: pre; overflow-x: auto; color: var(--fg); }
  .mm-term__out .is-cmd { font-variation-settings: 'wght' 700, 'wdth' 100; color: var(--accent); }
  .mm-term__out .is-dim { color: var(--fg-3); }
  .mm-term__out .is-ok { color: #9be39b; }
  .mm-term__out .is-warn { color: var(--mars); }

  /* ---------- telemetry ---------- */
  .mm-wall { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .mm-gauge { container-type: inline-size; background: var(--bg); padding: clamp(1rem, 2.2vw, 2rem); display: grid; gap: 0.5rem; }
  .mm-gauge__k { font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--fg-3); font-variation-settings: 'wght' 400, 'wdth' 85; }
